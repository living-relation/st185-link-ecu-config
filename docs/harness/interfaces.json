{
  "_doc": "Interface and ownership registry for docs/harness/rebuild/. Convention: redesign/INTERFACES.md. harness.design rejects unknown keys, so this metadata cannot live in the .harness files.",
  "_scope": "The center cluster's own assembly harness is owned by center-cluster-esp32-p4 and is not drawn here; ST185-CAN ends at its CAN-drop terminal t_cluster_can. The cluster warning-LED loom (ST185-ClusterLED) is owned here.",
  "harnesses": {
    "A-cabin": {
      "file": "ST185-A-cabin.harness",
      "physical": "ECU connector A to cabin firewall A: ECU-A, cabin half of bulkhead A, the fuse block, HCFB and the A-triggered relays, APS, CSB3 plug, front wheel-speed spur (FL), A/C coolant switch branch, fuel pump run, +5V / Gnd Out / +8V / switched-12V splices at ECU A"
    },
    "B-cabin": {
      "file": "ST185-B-cabin.harness",
      "physical": "ECU connector B to cabin firewall B: ECU-B, cabin half of bulkhead B, condenser fan relay, fuel level branch, rear wheel-speed spur, front wheel-speed FR core, the B legs of +5V / Gnd Out / switched 12V"
    },
    "APS-Pedal": {
      "file": "ST185-APS-Pedal.harness",
      "physical": "APS pedal harness - male half of IX_APS to the BRZ e-throttle pedal plug (cabin)"
    },
    "A-engine": {
      "file": "ST185-A-engine.harness",
      "physical": "Engine harness behind bulkhead A - every engine device whose ECU signal is on connector A"
    },
    "B-engine": {
      "file": "ST185-B-engine.harness",
      "physical": "Engine harness behind bulkhead B - every engine device whose ECU signal is on connector B, and the ETB motor"
    },
    "CAN": {
      "file": "ST185-CAN.harness",
      "physical": "CAN backbone"
    },
    "EngineRoom-C": {
      "file": "ST185-EngineRoom-C.harness",
      "physical": "Loom C - engine-room / high-current harness"
    },
    "ClusterLED": {
      "file": "ST185-ClusterLED.harness",
      "physical": "Cluster warning LEDs"
    },
    "WheelSpeed-Rear": {
      "file": "ST185-WheelSpeed-Rear.harness",
      "physical": "Rear wheel-speed Y harness - RL/RR ABS drops to the rear VRC endpoints, one screened 4-core output to IX_WS_REAR"
    },
    "WheelSpeed-Front": {
      "file": "ST185-WheelSpeed-Front.harness",
      "physical": "Front wheel-speed Y harness - FL/FR ABS drops (loom C fender route) to the front VRC endpoints, output pair to IX_WS_FRONT"
    },
    "ACAmp-Spur": {
      "file": "ST185-ACAmp-Spur.harness",
      "physical": "A/C amplifier spur - receiving half of IX_AC_CTS to flying leads at the auto A/C amplifier"
    },
    "RearFuel": {
      "file": "ST185-RearFuel.harness",
      "physical": "Rear Fuel - fuel level sender behind IX_FUEL_LVL (the pump run stays on ST185-A-cabin, plan 6.41)"
    },
    "AntiTheft": {
      "file": "ST185-AntiTheft.harness",
      "physical": "Anti-theft"
    }
  },
  "interfaces": [
    {
      "id": "IX_WS_REAR",
      "type": "inline_interface",
      "family": "Deutsch DT 6-way (DT04-6P / DT06-6S)",
      "pins": {
        "c1": "+5V",
        "c2": "Gnd Out",
        "c3": "RL out -> B20",
        "c4": "RR out -> B19",
        "c5": "drain -> SHIELD_B B17",
        "c6": "spare, plugged"
      },
      "halves": [
        {
          "harness": "WheelSpeed-Rear",
          "connector": "ix_ws_rear_r",
          "role": "source"
        },
        {
          "harness": "B-cabin",
          "connector": "ix_ws_rear_p",
          "role": "receiving"
        }
      ]
    },
    {
      "id": "IX_WS_FRONT",
      "type": "inline_interface",
      "family": "Deutsch DT 6-way (DT04-6P / DT06-6S)",
      "pins": {
        "c1": "+5V",
        "c2": "Gnd Out",
        "c3": "FL out -> A23",
        "c4": "FR out -> B21",
        "c5": "drain, FL/supply cable -> SHIELD_A A7",
        "c6": "drain, FR cable -> SHIELD_B B17 (floats at VRC)"
      },
      "halves": [
        {
          "harness": "WheelSpeed-Front",
          "connector": "ix_ws_front_r",
          "role": "source"
        },
        {
          "harness": "A-cabin",
          "connector": "ix_ws_front_p",
          "role": "receiving",
          "alsoDrawnOn": [
            "B-cabin"
          ]
        }
      ]
    },
    {
      "id": "IX_AC_CTS",
      "type": "inline_interface",
      "family": "Deutsch DT 2-way (DT04-2P / DT06-2S)",
      "pins": {
        "c1": "A/C coolant switch signal",
        "c2": "A/C coolant switch return"
      },
      "halves": [
        {
          "harness": "A-cabin",
          "connector": "ix_accts_r",
          "role": "source"
        },
        {
          "harness": "ACAmp-Spur",
          "connector": "ix_accts_p",
          "role": "receiving"
        }
      ]
    },
    {
      "id": "IX_FUEL_LVL",
      "type": "inline_interface",
      "family": "Deutsch DT 2-way (DT04-2P / DT06-2S)",
      "pins": {
        "c1": "fuel level signal -> B24",
        "c2": "fuel level ground -> Gnd Out"
      },
      "halves": [
        {
          "harness": "B-cabin",
          "connector": "ix_fuel_r",
          "role": "source"
        },
        {
          "harness": "RearFuel",
          "connector": "ix_fuel_p",
          "role": "receiving"
        }
      ]
    },
    {
      "id": "IX_APS",
      "type": "inline_interface",
      "family": "Deutsch DT 6-way (DT04-6P / DT06-6S)",
      "pins": {
        "c1": "VC2 +5V (sub)",
        "c2": "GND2 (sub)",
        "c3": "VPA2 -> B33",
        "c4": "VC1 +5V (main)",
        "c5": "GND1 (main)",
        "c6": "VPA1 -> A14"
      },
      "halves": [
        {
          "harness": "APS-Pedal",
          "connector": "ix_aps_p",
          "role": "source"
        },
        {
          "harness": "A-cabin",
          "connector": "ix_aps_r",
          "role": "receiving",
          "alsoDrawnOn": [
            "B-cabin"
          ]
        }
      ]
    }
  ],
