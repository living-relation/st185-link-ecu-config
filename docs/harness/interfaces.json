{
  "_doc": "Interface and ownership registry for docs/harness/rebuild/. Convention: redesign/INTERFACES.md. harness.design rejects unknown keys, so this metadata cannot live in the .harness files.",
  "_scope": "The center cluster's own assembly harness is owned by center-cluster-esp32-p4 and is not drawn here; ST185-CAN ends at its CAN-drop terminal t_cluster_can. The cluster warning-LED loom (ST185-ClusterLED) is owned here.",
  "harnesses": {
    "A-ECU": {
      "file": "ST185-A-ECU.harness",
      "physical": "ECU/cabin harness - ECU-A and ECU-B connectors, cabin halves of bulkheads A and B, CSB3 plug, wheel-speed spurs",
      "legacyXref": true
    },
    "B-ECU": {
      "file": "ST185-B-ECU.harness",
      "physical": "ECU/cabin harness - power side: relays, fuse box, shared +5V / Gnd Out / chassis splices",
      "legacyXref": true
    },
    "A-engine": {
      "file": "ST185-A-engine.harness",
      "physical": "Engine harness - signal circuits behind bulkheads A and B",
      "legacyXref": true
    },
    "B-engine": {
      "file": "ST185-B-engine.harness",
      "physical": "Engine harness - power circuits behind bulkheads A and B",
      "legacyXref": true
    },
    "CAN": {
      "file": "ST185-CAN.harness",
      "physical": "CAN backbone",
      "legacyXref": true
    },
    "EngineRoom-C": {
      "file": "ST185-EngineRoom-C.harness",
      "physical": "Loom C - engine-room / high-current harness",
      "legacyXref": true
    },
    "ClusterLED": {
      "file": "ST185-ClusterLED.harness",
      "physical": "Cluster warning LEDs",
      "legacyXref": true
    },
    "WheelSpeed-Rear": {
      "file": "ST185-WheelSpeed-Rear.harness",
      "physical": "Rear wheel-speed Y harness - RL/RR ABS drops to the rear VRC endpoints, one screened 4-core output to IX_WS_REAR",
      "legacyXref": false
    },
    "WheelSpeed-Front": {
      "file": "ST185-WheelSpeed-Front.harness",
      "physical": "Front wheel-speed Y harness - FL/FR ABS drops (loom C fender route) to the front VRC endpoints, output pair to IX_WS_FRONT",
      "legacyXref": false
    },
    "AntiTheft": {
      "file": "ST185-AntiTheft.harness",
      "physical": "Anti-theft",
      "legacyXref": true
    }
  },
  "interfaces": [
    {
      "id": "IX_WS_REAR",
      "type": "inline_interface",
      "family": "Deutsch DT 6-way (DT04-6P / DT06-6S)",
      "pins": {
        "c1": "+5V",
        "c2": "Gnd Out",
        "c3": "RL out -> B20",
        "c4": "RR out -> B19",
        "c5": "drain -> SHIELD_B B17",
        "c6": "spare, plugged"
      },
      "halves": [
        {
          "harness": "WheelSpeed-Rear",
          "connector": "ix_ws_rear_r",
          "role": "source"
        },
        {
          "harness": "A-ECU",
          "connector": "ix_ws_rear_p",
          "role": "receiving"
        }
      ]
    },
    {
      "id": "IX_WS_FRONT",
      "type": "inline_interface",
      "family": "Deutsch DT 6-way (DT04-6P / DT06-6S)",
      "pins": {
        "c1": "+5V",
        "c2": "Gnd Out",
        "c3": "FL out -> A23",
        "c4": "FR out -> B21",
        "c5": "drain, FL/supply cable -> SHIELD_A A7",
        "c6": "drain, FR cable -> SHIELD_B B17 (floats at VRC)"
      },
      "halves": [
        {
          "harness": "WheelSpeed-Front",
          "connector": "ix_ws_front_r",
          "role": "source"
        },
        {
          "harness": "A-ECU",
          "connector": "ix_ws_front_p",
          "role": "receiving"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "VRC_REAR_IN_L",
      "type": "device_endpoint",
      "harness": "WheelSpeed-Rear",
      "device": "rear VR conditioner, IN_L input (RL sensor)",
      "terminals": {
        "+": "ep_vrc_r_inl_p",
        "-": "ep_vrc_r_inl_n",
        "screen": "ep_vrc_r_inl_sh"
      }
    },
    {
      "id": "VRC_REAR_IN_R",
      "type": "device_endpoint",
      "harness": "WheelSpeed-Rear",
      "device": "rear VR conditioner, IN_R input (RR sensor)",
      "terminals": {
        "+": "ep_vrc_r_inr_p",
        "-": "ep_vrc_r_inr_n",
        "screen": "ep_vrc_r_inr_sh"
      }
    },
    {
      "id": "VRC_REAR_OUT",
      "type": "device_endpoint",
      "harness": "WheelSpeed-Rear",
      "device": "rear VR conditioner, output",
      "terminals": {
        "+5V": "ep_vrc_r_out_5v",
        "Gnd": "ep_vrc_r_out_gnd",
        "RL": "ep_vrc_r_out_l",
        "RR": "ep_vrc_r_out_r",
        "screen": "ep_vrc_r_out_sh"
      }
    },
    {
      "id": "VRC_FRONT_IN_L",
      "type": "device_endpoint",
      "harness": "WheelSpeed-Front",
      "device": "front VR conditioner, IN_L input (FL sensor)",
      "terminals": {
        "+": "ep_vrc_f_inl_p",
        "-": "ep_vrc_f_inl_n",
        "screen": "ep_vrc_f_inl_sh"
      }
    },
    {
      "id": "VRC_FRONT_IN_R",
      "type": "device_endpoint",
      "harness": "WheelSpeed-Front",
      "device": "front VR conditioner, IN_R input (FR sensor)",
      "terminals": {
        "+": "ep_vrc_f_inr_p",
        "-": "ep_vrc_f_inr_n",
        "screen": "ep_vrc_f_inr_sh"
      }
    },
    {
      "id": "VRC_FRONT_OUT",
      "type": "device_endpoint",
      "harness": "WheelSpeed-Front",
      "device": "front VR conditioner, output",
      "terminals": {
        "+5V": "ep_vrc_f_out_5v",
        "Gnd": "ep_vrc_f_out_gnd",
        "FL": "ep_vrc_f_out_l",
        "FR": "ep_vrc_f_out_r",
        "screen": "ep_vrc_f_out_sh"
      }
    }
  ],
  "enclosures": [
    {
      "id": "VRC_REAR",
      "harness": "WheelSpeed-Rear",
      "screen": [
        "ep_vrc_r_inl_sh",
        "ep_vrc_r_inr_sh",
        "ep_vrc_r_out_sh"
      ],
      "note": "The VRC case joins the two IN screens and the OUT screen (SHIELD-RULES 6.30). Isolated from chassis; grounded only at the ECU."
    },
    {
      "id": "VRC_FRONT",
      "harness": "WheelSpeed-Front",
      "screen": [
        "ep_vrc_f_inl_sh",
        "ep_vrc_f_inr_sh",
        "ep_vrc_f_out_sh"
      ],
      "note": "The VRC case joins the two IN screens and the OUT screen (SHIELD-RULES 6.30). Isolated from chassis; grounded only at the ECU."
    }
  ],
  "flyingLeads": [],
  "realConnectors": [
    {
      "harness": "A-ECU",
      "connector": "csb3io",
      "note": "HD36-24-33SE plug mating the CSB3 enclosure's HD34-24-33PE. The harness stops here; CSB3 itself is not drawn."
    },
    {
      "harness": "EngineRoom-C",
      "connector": "oem_jb2_2a",
      "note": "Dummy header crimped and plugged into J/B2 2A (ENGINE-ROOM-POWER-REDISTRIBUTION.md section 5.4). Plugs in, so it is a connector, not a flying lead."
    },
    {
      "harness": "EngineRoom-C",
      "connector": "oem_jb2_2d",
      "note": "Dummy header into J/B2 2D, same."
    },
    {
      "harness": "EngineRoom-C",
      "connector": "oem_jb2_2e",
      "note": "Dummy header into J/B2 2E, same."
    }
  ],
  "shieldBothEndsOk": [
    {
      "id": "cab_rout_sh",
      "reason": "VRC case (enclosure) to inline pin 5 - one screen node, grounded only at B17"
    },
    {
      "id": "cab_rspur_sh",
      "reason": "continuation of cab_rout_sh from inline pin 5 to sp_shield_b (B17)"
    },
    {
      "id": "cab_fout_sh",
      "reason": "VRC case (enclosure) to inline pin 5 - one screen node, grounded only at A7"
    },
    {
      "id": "cab_fspur_sh",
      "reason": "continuation of cab_fout_sh from inline pin 5 to sp_shield_a (A7)"
    },
    {
      "id": "cab_fspur_fr_sh",
      "reason": "continuation of cab_fout_fr_sh (floats at the VRC) from inline pin 6 to sp_shield_b (B17)"
    }
  ],
  "wheelSpeed": {
    "rear": {
      "harness": "WheelSpeed-Rear",
      "sensors": {
        "wss_rl": "VRC_REAR_IN_L",
        "wss_rr": "VRC_REAR_IN_R"
      },
      "output": "VRC_REAR_OUT",
      "enclosure": "VRC_REAR",
      "interface": "IX_WS_REAR",
      "outputCables": [
        {
          "cable": "cab_rout",
          "cores": 4,
          "drainPin": "c5",
          "screenFromEnclosure": true
        }
      ],
      "spurHarness": "A-ECU",
      "spur": {
        "c1": "sp_5v",
        "c2": "sp_gndout",
        "c3": "ecu_b.b20",
        "c4": "ecu_b.b19",
        "c5": "sp_shield_b"
      }
    },
    "front": {
      "harness": "WheelSpeed-Front",
      "sensors": {
        "wss_fl": "VRC_FRONT_IN_L",
        "wss_fr": "VRC_FRONT_IN_R"
      },
      "output": "VRC_FRONT_OUT",
      "enclosure": "VRC_FRONT",
      "interface": "IX_WS_FRONT",
      "outputCables": [
        {
          "cable": "cab_fout",
          "cores": 3,
          "drainPin": "c5",
          "screenFromEnclosure": true
        },
        {
          "cable": "cab_fout_fr",
          "cores": 1,
          "drainPin": "c6",
          "screenFromEnclosure": false
        }
      ],
      "spurHarness": "A-ECU",
      "spur": {
        "c1": "sp_5v",
        "c2": "sp_gndout",
        "c3": "ecu_a.a23",
        "c4": "ecu_b.b21",
        "c5": "sp_shield_a",
        "c6": "sp_shield_b"
      }
    }
  }
}
