  "schematicNotes": [
    {
      "id": "n0",
      "text": "ST185 cursor Engine Room C \u2014 HEAVY DC. Trunk battery, glove-box PDB, RADLOK 5.7 mm through the firewall, starter B+, 160 A alt, jump post. Does not redraw OEM looms.",
      "width": 390,
      "schematicPosition": {
        "x": -720,
        "y": -420
      },
      "color": "Orange"
    },
    {
      "id": "n1",
      "text": "2 AWG is enough for cranking. 160 A continuous charge may need 1/0 + 8 mm RADLOK \u2014 do not order a second 5.7 mm pair until that is decided.",
      "width": 390,
      "schematicPosition": {
        "x": -720,
        "y": -540
      },
      "color": "Orange"
    },
