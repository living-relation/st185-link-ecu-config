 "schematicNotes": [
  {
   "id": "note_intro",
   "text": "POWER harness - ECU focused. Battery and fuses in the passenger footwell. 12V / +5V / +8V / Gnd Out / chassis. Display devices are CAN-only and are not powered from this harness. Signals: ST185-Signal.harness.",
   "width": 390,
   "schematicPosition": {
    "x": 0,
    "y": -420
   }
  },
