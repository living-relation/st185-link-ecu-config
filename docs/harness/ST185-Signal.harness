  "schematicNotes": [
    {
      "id": "note_intro",
      "text": "SIGNAL harness - ECU focused. Cabin loom: ECU to bulkhead A/B at the passenger firewall. Engine loom: mating plugs, then one trunk around the motor. Rear (fuel level, rear ABS) bypasses the bulkhead. CAN crosses the firewall once, to the Lambda controller only. Power: ST185-Power.harness.",
      "width": 390,
      "schematicPosition": {
        "x": 0,
        "y": -420
      }
    },
    {
      "id": "shdr_0",
      "text": "CABIN DEVICES",
      "color": "Green",
      "width": 270,
      "schematicPosition": {
        "x": 0,
        "y": -150
      }
    },
    {
      "id": "shdr_1",
      "text": "ECU + BULKHEAD",
      "color": "Blue",
      "width": 270,
      "schematicPosition": {
        "x": 1170,
        "y": -150
      }
    },
    {
      "id": "shdr_2",
      "text": "ENGINE + REAR",
      "color": "Yellow",
      "width": 270,
      "schematicPosition": {
        "x": 2280,
        "y": -150
      }
    }
  ],
  "layoutNotes": [
    {
      "id": "ln_trunk",
      "width": 390,
      "layoutPosition": {
        "x": -600,
        "y": -1800
      },
      "text": "LAYOUT - trunk runs left to right. Cabin: ECU -> cabin branch -> bulkhead A/B (firewall, passenger side). Engine: mated plugs -> one combined trunk -> booted breakouts of 1-4 connectors. Rear branch leaves the cabin, not the bulkhead."
    }
  ],
