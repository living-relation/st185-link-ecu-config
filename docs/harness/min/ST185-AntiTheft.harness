{"$schema":"https://docs.harness.design/files/harness/schema/v0.9.json","$docs":"https://docs.harness.design/files/harness/editing-guide.md","version":0.9,"lengthUnit":"mm","connectors":[{"id":"alarm","label":"Alarm module - main harness (DT06-12SA)","width":390,"partId":"cp_dt06_12sa","cavities":[{"id":"c1","signal":"+12V CONSTANT - RFRM ALM 5A *, broken off to ST185-CabinPower","designation":"1","contactPartId":"ct_hdp16s"},{"id":"c2","signal":"GROUND - cabin chassis stud *","designation":"2","contactPartId":"ct_hdp16s"},{"id":"c3","signal":"IGNITION SENSE - +12V key-on *","designation":"3","contactPartId":"ct_hdp16s"},{"id":"c4","signal":"SIREN + - switched +12V out, 2A *","designation":"4","contactPartId":"ct_hdp16s"},{"id":"c5","signal":"PARKING LIGHT OUT - flashes the park lamps on *","designation":"5","contactPartId":"ct_hdp16s"},{"id":"c6","signal":"DOOR TRIGGER IN - negative *","designation":"6","contactPartId":"ct_hdp16s"},{"id":"c7","signal":"HOOD PIN IN - negative","designation":"7","contactPartId":"ct_hdp16s"},{"id":"c8","signal":"TRUNK PIN IN - negative","designation":"8","contactPartId":"ct_hdp16s"},{"id":"c9","signal":"IMMOBILISER OUT - grounds when armed *","designation":"9","contactPartId":"ct_hdp16s"},{"id":"c10","signal":"STATUS LED +","designation":"10","contactPartId":"ct_hdp16s"},{"id":"c11","signal":"VALET / PROGRAM SWITCH","designation":"11","contactPartId":"ct_hdp16s"},{"id":"c12","signal":"SHOCK SENSOR TRIGGER IN - negative *","designation":"12","contactPartId":"ct_hdp16s"}],"layoutPosition":{"x":1080,"y":-300},"schematicPosition":{"x":660,"y":0}},{"id":"shock","label":"Shock / tilt sensor *","width":390,"partId":"cp_dt3s","cavities":[{"id":"c1","signal":"+12V CONSTANT - RFRM ALMS 2A (ST185-CabinPower)","designation":"A","contactPartId":"ct_hdp16s"},{"id":"c2","signal":"Ground","designation":"B","contactPartId":"ct_hdp16s"},{"id":"c3","signal":"Trigger out - negative pulse on impact","designation":"C","contactPartId":"ct_hdp16s"}],"layoutPosition":{"x":1800,"y":0},"schematicPosition":{"x":1320,"y":540}},{"id":"siren","label":"Siren (engine bay, center firewall behind the engine) - leads cross via harness C's own RH fender grommet, decided 2026-10-10, not the FR wheel-speed grommet","width":390,"partId":"pdfTYmAD2zDku_jfHqzBu","cavities":[{"id":"c1","signal":"+12V switched from alarm c4","designation":"1","contactPartId":"ct_hdp16s"},{"id":"c2","signal":"Ground - returns to cabin ground stud (ring A)","designation":"2","contactPartId":"ct_hdp16s"}],"layoutPosition":{"x":300,"y":-390},"schematicPosition":{"x":1320,"y":0}},{"id":"led_sts","label":"Status LED (dash)","width":390,"partId":"pdfTYmAD2zDku_jfHqzBu","cavities":[{"id":"c1","signal":"LED anode, from alarm c10","designation":"1","contactPartId":"ct_hdp16s"},{"id":"c2","signal":"LED cathode to ground. Kit LED *","designation":"2","contactPartId":"ct_hdp16s"}],"layoutPosition":{"x":1440,"y":-120},"schematicPosition":{"x":1320,"y":240}},{"id":"valet","label":"Valet / program switch (hidden)","width":270,"partId":"pdfTYmAD2zDku_jfHqzBu","cavities":[{"id":"c1","signal":"Switch, from alarm c11","designation":"1","contactPartId":"ct_hdp16s"},{"id":"c2","signal":"Ground","designation":"2","contactPartId":"ct_hdp16s"}],"layoutPosition":{"x":1440,"y":-390},"schematicPosition":{"x":1320,"y":390}}],"terminals":[{"id":"t_at_12v","type":"Loose","width":390,"signal":"Broken off - continues on ST185-CabinPower: RFRM ALM 5A (Bus 1, permanent) -> alarm +12V constant","layoutPosition":{"x":1200,"y":360},"schematicPosition":{"x":0,"y":0}},{"id":"t_at_ig","type":"Loose","width":390,"signal":"Broken off - continues on ST185-CabinPower: RFRM ALMIG 2A (Bus 2, switched k_efi rail) -> alarm ignition sense","layoutPosition":{"x":960,"y":330},"schematicPosition":{"x":0,"y":90}},{"id":"t_at_gnd","type":"Ring","width":390,"partId":"tp_ring_m6_22_16","signal":"Cabin chassis ground stud M6 - ring A *","layoutPosition":{"x":1200,"y":-390},"schematicPosition":{"x":1980,"y":0}},{"id":"t_at_door","type":"Loose","width":390,"signal":"OEM door courtesy switches *","layoutPosition":{"x":1920,"y":-420},"schematicPosition":{"x":0,"y":180},"partId":"tp_flying_lead"},{"id":"t_at_hood","type":"Loose","width":390,"signal":"Hood pin switch - ADD ONE *. Rides harness C down the RH fender to the front, same grommet as the siren leads - exact hood-pin mounting spot still TBD","layoutPosition":{"x":180,"y":0},"schematicPosition":{"x":0,"y":270},"partId":"tp_flying_lead"},{"id":"t_at_trunk","type":"Loose","width":150,"signal":"Trunk pin switch","layoutPosition":{"x":3180,"y":0},"schematicPosition":{"x":0,"y":360},"partId":"tp_flying_lead"},{"id":"t_at_park","type":"Loose","width":390,"signal":"Park lamp flash - to a relay in the CABIN *","layoutPosition":{"x":1560,"y":390},"schematicPosition":{"x":1320,"y":150},"partId":"tp_flying_lead"},{"id":"t_at_gnd_b","type":"Ring","width":390,"partId":"tp_ring_m6_22_16","signal":"Cabin chassis ground stud M6 - ring B *","layoutPosition":{"x":1320,"y":-450},"schematicPosition":{"x":1980,"y":90}},{"id":"t_at_gnd_c","type":"Ring","width":390,"partId":"tp_ring_m6_22_16","signal":"Cabin chassis ground stud M6 - ring C (valet)","layoutPosition":{"x":1560,"y":-450},"schematicPosition":{"x":1980,"y":180}},{"id":"t_at_12v_shk","type":"Loose","width":390,"signal":"Broken off - continues on ST185-CabinPower: RFRM ALMS 2A (Bus 1, permanent) -> shock sensor +12V","layoutPosition":{"x":1320,"y":420},"schematicPosition":{"x":1980,"y":270}},{"id":"br_w_at_immob2","type":"Loose","signal":"Broken off - continues on ST185-B-cabin: immobiliser output to ECU-B B27 (DI 10)","width":390,"layoutPosition":{"x":1740,"y":360},"schematicPosition":{"x":60,"y":510}}],"splices":[{"id":"sp_at_12v","partId":"spp_solder_generic","layoutPosition":{"x":1260,"y":-390},"schematicPosition":{"x":510,"y":0},"locationId":"bp_990"},{"id":"sp_ig","partId":"spp_solder_generic","layoutPosition":{"x":1020,"y":-390},"schematicPosition":{"x":510,"y":60},"locationId