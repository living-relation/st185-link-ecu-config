ht","source":{"id":"sp_park","handle":"Splice"},"target":{"id":"t_at_park","handle":"Terminal"},"identLabel":"TIE-IN"},{"id":"w_at_12v_shk_tie","color":"Red","partId":"wp_20_red","source":{"id":"t_at_12v_shk","handle":"Terminal"},"target":{"id":"sp_12v_shk","handle":"Splice"}}],"bundles":[{"id":"bn_bp_180__bp_270","sourceId":"bp_180","targetId":"bp_270","length":{"value":160,"unit":"mm"}},{"id":"bn_bp_270__bp_930","sourceId":"bp_270","targetId":"bp_930","length":{"value":1220,"unit":"mm"}},{"id":"bn_bp_930__alarm","sourceId":"bp_930","targetId":"alarm","length":{"value":40,"unit":"mm"}},{"id":"bn_alarm__bp_990","sourceId":"alarm","targetId":"bp_990","length":{"value":20,"unit":"mm"}},{"id":"bn_bp_990__bp_1020","sourceId":"bp_990","targetId":"bp_1020","length":{"value":20,"unit":"mm"}},{"id":"bn_bp_1020__bp_1050","sourceId":"bp_1020","targetId":"bp_1050","length":{"value":20,"unit":"mm"}},{"id":"bn_bp_1050__bp_1080","sourceId":"bp_1050","targetId":"bp_1080","length":{"value":40,"unit":"mm"}},{"id":"bn_bp_1080__bp_1110","sourceId":"bp_1080","targetId":"bp_1110","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_1110__bp_1200","sourceId":"bp_1110","targetId":"bp_1200","length":{"value":390,"unit":"mm"}},{"id":"bn_bp_1200__bp_1260","sourceId":"bp_1200","targetId":"bp_1260","length":{"value":110,"unit":"mm"}},{"id":"bn_bp_1260__bp_2520","sourceId":"bp_1260","targetId":"bp_2520","length":{"value":2310,"unit":"mm"}},{"id":"bn_bp_180__t_at_hood","sourceId":"bp_180","targetId":"t_at_hood","length":{"value":570,"unit":"mm"}},{"id":"bn_bp_270__siren","sourceId":"bp_270","targetId":"siren","length":{"value":110,"unit":"mm"}},{"id":"bn_bp_930__t_at_ig","sourceId":"bp_930","targetId":"t_at_ig","length":{"value":1140,"unit":"mm"}},{"id":"bn_bp_990__t_at_12v","sourceId":"bp_990","targetId":"t_at_12v","length":{"value":1210,"unit":"mm"}},{"id":"bn_bp_1020__t_at_12v_shk","sourceId":"bp_1020","targetId":"t_at_12v_shk","length":{"value":1280,"unit":"mm"}},{"id":"bn_bp_1050__led_sts","sourceId":"bp_1050","targetId":"led_sts","length":{"value":400,"unit":"mm"}},{"id":"bn_bp_990__t_at_gnd","sourceId":"bp_990","targetId":"t_at_gnd","length":{"value":150,"unit":"mm"}},{"id":"bn_bp_1020__t_at_gnd_b","sourceId":"bp_1020","targetId":"t_at_gnd_b","length":{"value":200,"unit":"mm"}},{"id":"bn_bp_1080__t_at_park","sourceId":"bp_1080","targetId":"t_at_park","length":{"value":1300,"unit":"mm"}},{"id":"bn_bp_1050__valet","sourceId":"bp_1050","targetId":"valet","length":{"value":110,"unit":"mm"}},{"id":"bn_bp_1080__t_at_gnd_c","sourceId":"bp_1080","targetId":"t_at_gnd_c","length":{"value":200,"unit":"mm"}},{"id":"bn_bp_1200__shock","sourceId":"bp_1200","targetId":"shock","length":{"value":570,"unit":"mm"}},{"id":"bn_bp_1260__t_at_door","sourceId":"bp_1260","targetId":"t_at_door","length":{"value":220,"unit":"mm"}},{"id":"bn_bp_2520__t_at_trunk","sourceId":"bp_2520","targetId":"t_at_trunk","length":{"value":570,"unit":"mm"}},{"id":"bn_bp_1110__br_w_at_immob2","sourceId":"bp_1110","targetId":"br_w_at_immob2","length":{"value":1100,"unit":"mm"}}],"branchPoints":[{"id":"bp_180","layoutPosition":{"x":180,"y":-300}},{"id":"bp_270","layoutPosition":{"x":300,"y":-300}},{"id":"bp_930","layoutPosition":{"x":960,"y":-300}},{"id":"bp_990","layoutPosition":{"x":1200,"y":-300}},{"id":"bp_1020","layoutPosition":{"x":1320,"y":-300}},{"id":"bp_1050","layoutPosition":{"x":1440,"y":-300}},{"id":"bp_1080","layoutPosition":{"x":1560,"y":-300}},{"id":"bp_1110","layoutPosition":{"x":1680,"y":-300}},{"id":"bp_1200","layoutPosition":{"x":1800,"y":-300}},{"id":"bp_1260","layoutPosition":{"x":1920,"y":-300}},{"id":"bp_2520","layoutPosition":{"x":3180,"y":-300}}],"schematicNotes":[{"id":"note_at_scope","text":"ST185 ANTI-THEFT HARNESS\nHarness side = Deutsch DT sockets (TE), gold 0462-201-1631 (owned stock).\nDevice leads get DT04 pin mates - see NEED-TO-BUY.md, not drawn (device side).\nAll conductors 20 AWG to fit DT size-16 contacts (20-16 AWG).\nTIE-IN = generic butt splice onto the car lead. Fused feeds come from the RFRM (ALM 5A, ALMS 2A, ALMIG 2A) on ST185-CabinPower, broken off.\nGrounds: 3 generic M6 rings stacked on one cabin stud (max 2 x 20 AWG per ring).\nBundle lengths are estimates - final tape-measure pass sets them.\nFolds into ST185-CabinAccessory in the Option C restructure.","schematicPosition":{"x":2520,"y":0}},{"id":"note_at_immob","text":"THE ALARM DOES NOT CUT THE STARTER.\nOur starter is switched by k_str on the Link's Aux 8 / A26. The\nalarm's ground-when-armed output drives a G4X DIGITAL INPUT and the\nECU's own anti-theft function does the fuel and ignition cut.\nLink XtremeX spec: 'Anti-Theft control through digital inputs,\nover CAN or both'. One less relay, and the cut sits inside the ECU\nwhere it cannot be hot-wired around.\nDI accepts a ground-switched input directly - enable the 4k7 pull-up.","schematicPosition":{"x":2520,"y":450}},{"id":"note_at_bay","text":"NO RELAY OR FUSE IN THE ENGINE BAY.\nThe siren is in the bay but its feed comes from the cabin fuse box (RFRM).\nThe park-lamp flash output drives a relay in the CABIN block.","schematicPosition":{"x":2520,"y":900}},{"id":"n_cavity_notes","text":"CAVITY NOTES - full text of the signals marked * on this drawing\nAlarm module - main harness (D 1: +12V CONSTANT - from the fuse box RFRM ALM 5A (ST185-CabinPower). Alarm must stay live with the key off.\nAlarm module - main harness (D 2: GROUND - cabin chassis stud, same stud as the rest of the accessory loom\nAlarm module - main harness (D 3: IGNITION SENSE - +12V key-on, tells the alarm the car is running\nAlarm module - main harness (D 4: SIREN + - switched +12V out, 2A. Siren is in the bay, this feed comes from the cabin.\nAlarm module - main harness (D 5: PARKING LIGHT OUT - flashes the park lamps on trigger. Drive the OEM circuit through a relay in the CABIN block, not a bay relay.\nAlarm module - main harness (D 6: DOOR TRIGGER IN - negative. OEM door courtesy switches.\nAlarm module - main harness (D 9: IMMOBILISER OUT - grounds when armed. Goes to a G4X DIGITAL INPUT, not a starter-kill relay. The ECU does the fuel and ignition cut.\nAlarm module - main harness (D 12: SHOCK SENSOR TRIGGER IN - negative, from the sensor's signal pin\nshock (label): Shock / tilt sensor (replaces the OEM glass-break sensor)\nStatus LED (dash) 2: LED cathode to ground. Kit LED - module limits the current.\nt_at_12v: +12V CONSTANT, RFRM ALM 5A (ST185-CabinPower, broken off). NOT the engine bay.\nt_at_gnd: Cabin chassis ground stud M6 - ring A (alarm + siren)\nt_at_door: OEM door courtesy switches - negative when a door opens\nt_at_hood: Hood pin switch - ADD ONE, the car has no factory hood pin\nt_at_park: Park lamp flash - to a relay in the CABIN block, never a bay relay\nt_at_gnd_b: Cabin chassis ground stud M6 - ring B (shock + LED)\nt_at_12v_shk: +12V CONSTANT, 2A fuse, RFRM ALMS 2A - shock sensor feed","schematicPosition":{"x":2520,"y":1080}}],"wireParts":[{"id":"wp_20_blk","partNumber":"EW-1C20-BLK","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, BLACK, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Black","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_blu","partNumber":"EW-1C20-BLU","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, BLUE, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Blue","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_brn","partNumber":"EW-1C20-BRN","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, BROWN, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Brown","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_grn","partNumber":"EW-1C20-GRN","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, GREEN, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Green","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_org","partNumber":"EW-1C20-ORG","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, ORANGE, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV