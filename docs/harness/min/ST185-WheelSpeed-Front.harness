{"$schema":"https://docs.harness.design/files/harness/schema/v0.9.json","version":0.9,"lengthUnit":"mm","connectors":[{"id":"wss_fl","label":"ABS Wheel Speed FL","width":210,"partId":"cp_dt2s_ni","cavities":[{"id":"c1","designation":"1","signal":"VR+ (front left)"},{"id":"c2","designation":"2","signal":"VR- (front left)"}],"schematicPosition":{"x":0,"y":0},"layoutPosition":{"x":0,"y":-300}},{"id":"wss_fr","label":"ABS Wheel Speed FR","width":210,"partId":"cp_dt2s_ni","cavities":[{"id":"c1","designation":"1","signal":"VR+ (front right)"},{"id":"c2","designation":"2","signal":"VR- (front right)"}],"schematicPosition":{"x":0,"y":270},"layoutPosition":{"x":0,"y":300}},{"id":"ix_ws_front_r","label":"WS FRONT OUT - 6-way inline to ECU spur (IX_WS_FRONT)","width":270,"partId":"cp_dt04_6p","cavities":[{"id":"c1","designation":"1","signal":"+5V - VRC front supply (ECU sensor +5V)"},{"id":"c2","designation":"2","signal":"Gnd Out - VRC front ground"},{"id":"c3","designation":"3","signal":"FL conditioned out -> ECU-A A23 (DI 3)"},{"id":"c4","designation":"4","signal":"FR conditioned out -> ECU-B B21 (DI 4)"},{"id":"c5","designation":"5","signal":"Screen drain, FL/supply cable -> SHIELD_A (A7)"},{"id":"c6","designation":"6","signal":"Screen drain, FR cable -> SHIELD_B (B17)"}],"schematicPosition":{"x":1500,"y":540},"layoutPosition":{"x":3300,"y":90}}],"terminals":[{"id":"ep_vrc_f_inl_p","type":"Loose","signal":"VRC_FRONT_IN_L + (FL VR+) - device endpoint, VRC not drawn","schematicPosition":{"x":660,"y":0},"layoutPosition":{"x":900,"y":-210}},{"id":"ep_vrc_f_inl_n","type":"Loose","signal":"VRC_FRONT_IN_L - (FL VR-)","schematicPosition":{"x":660,"y":60},"layoutPosition":{"x":900,"y":-150}},{"id":"ep_vrc_f_inl_sh","type":"Loose","signal":"VRC_FRONT_IN_L screen - rides IN pin 3 to the VRC case (enclosure joins it)","schematicPosition":{"x":660,"y":120},"layoutPosition":{"x":900,"y":-90}},{"id":"ep_vrc_f_inr_p","type":"Loose","signal":"VRC_FRONT_IN_R + (FR VR+) - device endpoint, VRC not drawn","schematicPosition":{"x":660,"y":270},"layoutPosition":{"x":900,"y":90}},{"id":"ep_vrc_f_inr_n","type":"Loose","signal":"VRC_FRONT_IN_R - (FR VR-)","schematicPosition":{"x":660,"y":330},"layoutPosition":{"x":900,"y":150}},{"id":"ep_vrc_f_inr_sh","type":"Loose","signal":"VRC_FRONT_IN_R screen - rides IN pin 3 to the VRC case (enclosure joins it)","schematicPosition":{"x":660,"y":390},"layoutPosition":{"x":900,"y":210}},{"id":"ep_vrc_f_out_5v","type":"Loose","signal":"VRC_FRONT_OUT +5V","schematicPosition":{"x":660,"y":540},"layoutPosition":{"x":1140,"y":-120}},{"id":"ep_vrc_f_out_gnd","type":"Loose","signal":"VRC_FRONT_OUT Gnd Out","schematicPosition":{"x":660,"y":600},"layoutPosition":{"x":1140,"y":-60}},{"id":"ep_vrc_f_out_l","type":"Loose","signal":"VRC_FRONT_OUT FL out","schematicPosition":{"x":660,"y":660},"layoutPosition":{"x":1140,"y":0}},{"id":"ep_vrc_f_out_r","type":"Loose","signal":"VRC_FRONT_OUT FR out","schematicPosition":{"x":660,"y":720},"layoutPosition":{"x":1140,"y":60}},{"id":"ep_vrc_f_out_sh","type":"Loose","signal":"VRC_FRONT_OUT screen - bonded to the VRC case","schematicPosition":{"x":660,"y":780},"layoutPosition":{"x":1140,"y":120}}],"cables":[{"id":"cab_fl","partId":"cab_sh_2c","schematicPosition":{"x":330,"y":0},"cores":[{"id":"cab_fl_p","color":"White","source":{"id":"wss_fl","handle":"c1"},"target":{"id":"ep_vrc_f_inl_p","handle":"Terminal"},"twistedWithNext":true},{"id":"cab_fl_n","color":"Green","source":{"id":"wss_fl","handle":"c2"},"target":{"id":"ep_vrc_f_inl_n","handle":"Terminal"}}],"shield":{"id":"cab_fl_sh","color":"Shield","source":{"id":"ep_vrc_f_inl_sh","handle":"Terminal"}}},{"id":"cab_fr","partId":"cab_sh_2c","schematicPosition":{"x":330,"y":270},"cores":[{"id":"cab_fr_p","color":"White","source":{"id":"wss_fr","handle":"c1"},"target":{"id":"ep_vrc_f_inr_p","handle":"Terminal"},"twistedWithNext":true},{"id":"cab_fr_n","color":"Green","source":{"id":"wss_fr","handle":"c2"},"target":{"id":"ep_vrc_f_inr_n","handle":"Terminal"}}],"shield":{"id":"cab_fr_sh","color":"Shield","source":{"id":"ep_vrc_f_inr_sh","handle":"Terminal"}}},{"id":"cab_fout","partId":"cab_sh_3c","schematicPosition":{"x":1080,"y":480},"cores":[{"id":"cab_fout_5v","color":"Orange","source":{"id":"ep_vrc_f_out_5v","handle":"Terminal"},"target":{"id":"ix_ws_front_r","handle":"c1"}},{"id":"cab_fout_gnd","color":"Black","source":{"id":"ep_vrc_f_out_gnd","handle":"Terminal"},"target":{"id":"ix_ws_front_r","handle":"c2"}},{"id":"cab_fout_l","color":"Blue","source":{"id":"ep_vrc_f_out_l","handle":"Terminal"},"target":{"id":"ix_ws_front_r","handle":"c3"}}],"shield":{"id":"cab_fout_sh","color":"Shield","source":{"id":"ep_vrc_f_out_sh","handle":"Terminal"},"target":{"id":"ix_ws_front_r","handle":"c5"}}},{"id":"cab_fout_fr","partId":"cab_sh_1c_vio","schematicPosition":{"x":1080,"y":720},"cores":[{"id":"cab_fout_r","color":"Violet","source":{"id":"ep_vrc_f_out_r","handle":"Terminal"},"target":{"id":"ix_ws_front_r","handle":"c4"}}],"shield":{"id":"cab_fout_fr_sh","color":"Shield","target":{"id":"ix_ws_front_r","handle":"c6"}}}],"bundles":[{"id":"bn_wss_fl__bp_f_y","sourceId":"wss_fl","targetId":"bp_f_y","length":{"value":940,"unit":"mm"}},{"id":"bn_wss_fr__bp_f_y","sourceId":"wss_fr","targetId":"bp_f_y","length":{"value":600,"unit":"mm"}},{"id":"bn_bp_f_y__bp_f_vrc","sourceId":"bp_f_y","targetId":"bp_f_vrc","length":{"value":300,"unit":"mm"}},{"id":"bn_bp_f_vrc__bp_f_inl","sourceId":"bp_f_vrc","targetId":"bp_f_inl","length":{"value":70,"unit":"mm"}},{"id":"bn_bp_f_vrc__bp_f_inr","sourceId":"bp_f_vrc","targetId":"bp_f_inr","length":{"value":70,"unit":"mm"}},{"id":"bn_bp_f_inl__ep_vrc_f_inl_p","sourceId":"bp_f_inl","targetId":"ep_vrc_f_inl_p","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_f_inl__ep_vrc_f_inl_n","sourceId":"bp_f_inl","targetId":"ep_vrc_f_inl_n","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_f_inl__ep_vrc_f_inl_sh","sourceId":"bp_f_inl","targetId":"ep_vrc_f_inl_sh","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_f_inr__ep_vrc_f_inr_p","sourceId":"bp_f_inr","targetId":"ep_vrc_f_inr_p","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_f_inr__ep_vrc_f_inr_n","sourceId":"bp_f_inr","targetId":"ep_vrc_f_inr_n","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_f_inr__ep_vrc_f_inr_sh","sourceId":"bp_f_inr","targetId":"ep_vrc_f_inr_sh","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_f_vrc__bp_f_out","sourceId":"bp_f_vrc","targetId":"bp_f_out","length":{"value":20,"unit":"mm"}},{"id":"bn_bp_f_out__ep_vrc_f_out_5v","sourceId":"bp_f_out","targetId":"ep_vrc_f_out_5v","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_f_out__ep_vrc_f_out_gnd","sourceId":"bp_f_out","targetId":"ep_vrc_f_out_gnd","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_f_out__ep_vrc_f_out_l","sourceId":"bp_f_out","targetId":"ep_vrc_f_out_l","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_f_out__ep_vrc_f_out_r","sourceId":"bp_f_out","targetId":"ep_vrc_f_out_r","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_f_out__ep_vrc_f_out_sh","sourceId":"bp_f_out","targetId":"ep_vrc_f_out_sh","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_f_out__bp_f_fwd","sourceId":"bp_f_out","targetId":"bp_f_fwd","length":{"value":1100,"unit":"mm"}},{"id":"bn_bp_f_fwd__ix_ws_front_r","sourceId":"bp_f_fwd","targetId":"ix_ws_front_r","length":{"value":300,"unit":"mm"}}],"branchPoints":[{"id":"bp_f_y","layoutPosition":{"x":450,"y":0}},{"id":"bp_f_vrc","layoutPosition":{"x":750,"y":0}},{"id":"bp_f_inl","layoutPosition":{"x":900,"y":-150}},{"id":"bp_f_inr","layoutPosition":{"x":900,"y":150}},{"id":"bp_f_out","layoutPosition":{"x":1140,"y":0}},{"id":"bp_f_fwd","layoutPosition":{"x":3000,"y":90}}],"schematicNotes":[{"id":"n_scope","width":390,"schematicPosition":{"x":1920,"y":0},"text":"FRONT WHEEL SPEED - one Y harness. FL and FR ABS drops (loom C fender route, no bulkhead) run to the front VRC; the output runs through a grommet to the 6-way inline DT04-6P near the ECU (IX_WS_FRONT). The ECU side owns only the short spur and the DT06-6S mating half (ST185-A-cabin; the FR core and its c6 drain belong to ST185-B-cabin)."},{"id":"n_vrc","width":390,"color":"Orange","schematicPosition":{"x":1920,"y":210},"text":"VRC NOT DRAWN. The VR conditioner, its enclosure and its M8 panel connectors belong to the enclosure build, not this harness. Loose ends VRC_FRONT_IN_L / IN_R / OUT are device endpoints: each lead lands on the matching M8 cable-plug pin when the box is built."},{"id":"n_shield","width":390,"color":"Orange","schematicPosition":{"x":1920,"y":420},"text":"SHIELDS - VRC powered-device exception (docs/SHIELD-RULES.md 6.30). Each sensor screen floats at the sensor and lands on the IN endpoint screen lead (IN pin 3, wire inside the box to the case). The FL/supply cable screen is bonded to the case and runs to inline pin 5, then to SHIELD_A (A7). The FR output has its own 1-core screened cable: it FLOATS at the VRC and runs to pin 6, then to SHIELD_B (B17). A7 and B17 never meet."},{"id":"n_iso","width":390,"color":"Red","schematicPosition":{"x":1920,"y":630},"text":"TWO ISOLATION RULES. 1. The enclosure must not touch chassis - it is part of the screen, not a ground. Nylon mounting hardware. 2. The PCB must not touch the enclosure - nylon standoffs. The board grounds through the output cable only. If either is bonded, the screen picks up supply-ground noise and it will read as a flaky sensor."},{"id":"n_coat","width":390,"color":"Red","schematicPosition":{"x":1920,"y":810},"text":"MASK THE THREE CONNECTOR LANDINGS AND THE CASE RING-TERMINAL SPOT BEFORE POWDER COAT. The OUT shielding plate and the input screen ring terminals need bare metal. A coated landing silently breaks the screen."}],"connectorParts":[{"partNumber":"DT06-2S","manufacturer":"TE DEUTSCH","description":"CONNECTOR, PLUG, DT, 2 POS, SOCKET CONTACTS, N SEAL, GRAY - ABS wheel speed sensor, harness side; mates DT04-2P on the re-terminated pigtail","numberOfCavities":2,"gender":"Female","hasShell":false,"configurations":[{"id":"cfg","contactPartId":"ct_dt16s_ni","cavityPlugPartId":"pl_sz16","lockPartId":"lp_w2s"}],"url":"https://www.te.com/usa-en/product-DT06-2S.html","image":{"path":"97d068b9-43c9-4b19-b8c0-ccc45b65fb7b/1790014830313.png","source":"cloud"},"pinout":{"id":"te-deutsch-dt-2","name":"DT 2-way","pins":[{"x":2.73,"y":0,"size":4.2},{"x":-2.73,"y":0,"size":4.2}],"outline":{"type":"rect","width":15.1,"height":11.7,"cornerRadius":2.5},"features":[{"y":-5.85,"layer":"behind","shape":{"type":"rect","width":8.5,"height":3}}],"mirrored":true},"designationStrategy":{"type":"sequential"},"id":"cp_dt2s_ni"},{"id":"cp_dt04_6p","partNumber":"DT04-6P","manufacturer":"TE DEUTSCH","description":"CONNECTOR, RECEPTACLE, DT, 6 POS, PIN CONTACTS, N SEAL, GRAY - wheel-speed VRC output inline interface, wheel-speed harness side (receiving half DT06-6S is on the ECU spur)","numberOfCavities":6,"gender":"Male","hasShell":false,"configurations":[{"id":"cfg","contactPartId":"ct_dt16p","cavityPlugPartId":"pl_sz16","lockPartId":"lp_w6p"}],"url":"https://www.te.com/usa-en/product-DT04-6P.html"}],"contactParts":[{"partNumber":"0462-201-16141","manufacturer":"TE DEUTSCH","type":"Crimp","gender":"Socket","minGauge":{"value":20,"unit":"AWG"},"maxGauge":{"value":16,"unit":"AWG"},"contactColor":"Silver","description":"CONTACT, SOCKET, SOLID, SIZE 16, NICKEL, 16-20 AWG, 13 A - DT","id":"ct_dt16s_ni"},{"id":"ct_dt16p","partNumber":"0460-202-1631","manufacturer":"TE DEUTSCH","description":"CONTACT, PIN, SOLID, SIZE 16, GOLD, 16-20 AWG, 13 A - DT receptacle; OWNED","type":"Crimp","gender":"Pin","minGauge":{"value":20,"unit":"AWG"},"maxGauge":{"value":16,"unit":"AWG"},"contactColor":"Gold"}],"cableParts":[{"id":"cab_sh_2c","partNumber":"GENERIC SHLD CABLE 2C TP 20AWG","manufacturer":"generic","description":"CABLE, SHIELDED, 2 CONDUCTOR TWISTED PAIR, 20 AWG, FOIL + TINNED COPPER BRAID, JACKETED - sensor pair (generic per 6.24)","cores":[{"id":"k1","color":"White","twistedWithNext":true,"gauge":{"value":20,"unit":"AWG"}},{"id":"k2","color":"Green","gauge":{"value":20,"unit":"AWG"}}],"shielded":true},{"id":"cab_sh_3c","partNumber":"GENERIC SHLD CABLE 3C 20AWG","manufacturer":"generic","description":"CABLE, SHIELDED, 3 CONDUCTOR, 20 AWG, FOIL + TINNED COPPER BRAID, JACKETED - front VRC to ECU: +5V, Gnd Out, FL pulse. Screen to A7 (generic per 6.24)","cores":[{"id":"k1","color":"Orange","gauge":{"value":20,"unit":"AWG"}},{"id":"k2","color":"Black","gauge":{"value":20,"unit":"AWG"}},{"id":"k3","color":"Blue","gauge":{"value":20,"unit":"AWG"}}],"shielded":true},{"id":"cab_sh_1c_vio","partNumber":"GENERIC SHLD CABLE 1C 20AWG VIO","manufacturer":"generic","description":"CABLE, SHIELDED, 1 CONDUCTOR, 20 AWG, VIOLET, FOIL + TINNED COPPER BRAID, JACKETED - front VRC FR pulse to ECU B21. Screen to B17 only, floats at the VRC (generic per 6.24)","cores":[{"id":"k1","color":"Violet","gauge":{"value":20,"unit":"AWG"}}],"shielded":true}],"lockParts":[{"partNumber":"W2S","manufacturer":"TE DEUTSCH","description":"WEDGELOCK, DT, 2-WAY PLUG","id":"lp_w2s"},{"id":"lp_w6p","partNumber":"W6P","manufacturer":"TE DEUTSCH","description":"WEDGELOCK, DT, 6-WAY RECEPTACLE"}],"cavityPlugParts":[{"partNumber":"114017","manufacturer":"TE DEUTSCH","description":"PLUG, SEALING, CAVITY, SIZE 16, WHITE - unused size 16 cavity","id":"pl_sz16"}]}