{"$schema":"https://docs.harness.design/files/harness/schema/v0.9.json","version":0.9,"lengthUnit":"mm","connectors":[{"id":"wss_fl","label":"ABS Wheel Speed FL","width":210,"partId":"cp_dt2s_ni","cavities":[{"id":"c1","designation":"1","signal":"VR+ (front left)","propagate":false},{"id":"c2","designation":"2","signal":"VR- (front left)","propagate":false}],"schematicPosition":{"x":0,"y":0},"layoutPosition":{"x":-30,"y":-120}},{"id":"wss_fr","label":"ABS Wheel Speed FR","width":210,"partId":"cp_dt2s_ni","cavities":[{"id":"c1","designation":"1","signal":"VR+ (front right)","propagate":false},{"id":"c2","designation":"2","signal":"VR- (front right)","propagate":false}],"schematicPosition":{"x":0,"y":270},"layoutPosition":{"x":-30,"y":90}},{"id":"ix_ws_front_r","label":"WS FRONT OUT - 6-way inline to ECU spur (IX_WS_FRONT)","width":270,"partId":"cp_dt04_6p","cavities":[{"id":"c1","designation":"1","signal":"+5V - VRC front supply (ECU sensor +5V)","propagate":false},{"id":"c2","designation":"2","signal":"Gnd Out - VRC front ground","propagate":false},{"id":"c3","designation":"3","signal":"FL conditioned out -> ECU-A A23 (DI 3)","propagate":false},{"id":"c4","designation":"4","signal":"FR conditioned out -> ECU-B B21 (DI 4)","propagate":false},{"id":"c5","designation":"5","signal":"Screen drain, combined 4-core cable -> SHIELD_A (A7)","propagate":false},{"id":"c6","designation":"6","signal":"spare, plugged - was the FR cable's own drain (B17) when FL/FR were two separate output cables; superseded 2026-10-10, Route 9 rev 3"}],"schematicPosition":{"x":1290,"y":510},"layoutPosition":{"x":1470,"y":0}},{"id":"m9_vrc_f_in","label":"VRC front IN plug","width":390,"partId":"cp_m9_5f","layoutPosition":{"x":540,"y":0},"schematicPosition":{"x":1230,"y":120},"cavities":[{"id":"c1","designation":"1","signal":"ABS+ FL IN","contactPartId":"ct_m9_solder"},{"id":"c2","designation":"2","signal":"ABS- FL IN","contactPartId":"ct_m9_solder"},{"id":"c3","designation":"3","signal":"ABS Front SHIELD","contactPartId":"ct_m9_solder"},{"id":"c4","designation":"4","signal":"ABS+ FR IN","contactPartId":"ct_m9_solder"},{"id":"c5","designation":"5","signal":"ABS- FR IN","contactPartId":"ct_m9_solder"}]},{"id":"m9_vrc_f_out","label":"VRC front OUT plug","width":390,"partId":"cp_m9_5f","layoutPosition":{"x":900,"y":60},"schematicPosition":{"x":570,"y":510},"cavities":[{"id":"c1","designation":"1","signal":"+5V","contactPartId":"ct_m9_solder","propagate":false},{"id":"c2","designation":"2","signal":"Gnd","contactPartId":"ct_m9_solder","propagate":false},{"id":"c3","designation":"3","signal":"FL out","contactPartId":"ct_m9_solder","propagate":false},{"id":"c4","designation":"4","signal":"FR out","contactPartId":"ct_m9_solder","propagate":false},{"id":"c5","designation":"5","signal":"screen drain","contactPartId":"ct_m9_solder","propagate":false}]}],"terminals":[],"cables":[{"id":"cab_fl","partId":"cab_sh_2c","schematicPosition":{"x":240,"y":0},"cores":[{"id":"cab_fl_p","color":"White","source":{"id":"wss_fl","handle":"c1"},"target":{"id":"m9_vrc_f_in","handle":"c1"},"twistedWithNext":true},{"id":"cab_fl_n","color":"Green","source":{"id":"wss_fl","handle":"c2"},"target":{"id":"m9_vrc_f_in","handle":"c2"}}],"shield":{"id":"cab_fl_sh","color":"Shield","source":{"id":"sp_vrc_f_in_sh","handle":"Splice"}}},{"id":"cab_fr","partId":"cab_sh_2c","schematicPosition":{"x":240,"y":270},"cores":[{"id":"cab_fr_p","color":"White","source":{"id":"wss_fr","handle":"c1"},"target":{"id":"m9_vrc_f_in","handle":"c4"},"twistedWithNext":true},{"id":"cab_fr_n","color":"Green","source":{"id":"wss_fr","handle":"c2"},"target":{"id":"m9_vrc_f_in","handle":"c5"}}],"shield":{"id":"cab_fr_sh","color":"Shield","source":{"id":"sp_vrc_f_in_sh","handle":"Splice"}}},{"id":"cab_fout","partId":"cab_sh_4c","schematicPosition":{"x":990,"y":510},"cores":[{"id":"cab_fout_5v","color":"Orange","source":{"id":"m9_vrc_f_out","handle":"c1"},"target":{"id":"ix_ws_front_r","handle":"c1"}},{"id":"cab_fout_gnd","color":"Black","source":{"id":"m9_vrc_f_out","handle":"c2"},"target":{"id":"ix_ws_front_r","handle":"c2"}},{"id":"cab_fout_l","color":"Blue","source":{"id":"m9_vrc_f_out","handle":"c3"},"target":{"id":"ix_ws_front_r","handle":"c3"}},{"id":"cab_fout_r","color":"Violet","source":{"id":"m9_vrc_f_out","handle":"c4"},"target":{"id":"ix_ws_front_r","handle":"c4"}}],"shield":{"id":"cab_fout_sh","color":"Shield","source":{"id":"m9_vrc_f_out","handle":"c5"},"target":{"id":"ix_ws_front_r","handle":"c5"}}}],"bundles":[{"id":"bn_wss_fl__bp_f_y","sourceId":"wss_fl","targetId":"bp_f_y","length":{"unit":"mm","value":940},"layoutPoints":[{"id":"lp_f_l","layoutPosition":{"x":420,"y":0}}]},{"id":"bn_wss_fr__bp_f_y","sourceId":"wss_fr","targetId":"bp_f_y","length":{"unit":"mm","value":600},"layoutPoints":[{"id":"lp_f_r","layoutPosition":{"x":420,"y":0}}]},{"id":"bn_bp_f_y__m9_vrc_f_in","sourceId":"bp_f_y","targetId":"m9_vrc_f_in","length":{"unit":"mm","value":50}},{"id":"bn_bp_f_out__m9_vrc_f_out","sourceId":"bp_f_out","targetId":"m9_vrc_f_out","length":{"unit":"mm","value":50}},{"id":"bn_bp_f_out__bp_f_fwd","sourceId":"bp_f_out","targetId":"bp_f_fwd","length":{"unit":"mm","value":1100}},{"id":"bn_bp_f_fwd__ix_ws_front_r","sourceId":"bp_f_fwd","targetId":"ix_ws_front_r","length":{"unit":"mm","value":300}}],"branchPoints":[{"id":"bp_f_y","layoutPosition":{"x":510,"y":0}},{"id":"bp_f_out","layoutPosition":{"x":930,"y":0}},{"id":"bp_f_fwd","layoutPosition":{"x":1440,"y":0}}],"schematicNotes":[{"id":"n_scope","width":390,"schematicPosition":{"x":1740,"y":0},"text":"FRONT WHEEL SPEED - two pieces. IN: the FL and FR ABS drops run as separate cables to a point by the IN plug and land in it. OUT: the OUT plug, the screened 4-core output cable and the 6-way inline DT04-6P near the ECU (IX_WS_FRONT). The ECU side owns only the short spur and the DT06-6S mating half. No bulkhead."},{"id":"n_vrc","width":390,"color":"Orange","schematicPosition":{"x":1740,"y":210},"text":"VRC NOT DRAWN. The VR conditioner and its enclosure belong to the enclosure build. This harness is two separate pieces with no drawn link (Daniel 2026-10-12): IN - the FL and FR legs land in the IN plug m9_vrc_f_in (pin 1 ABS+ FL, 2 ABS- FL, 3 shield drain, 4 ABS+ FR, 5 ABS- FR); OUT - the OUT plug m9_vrc_f_out (pin 1 +5V, 2 Gnd, 3 FL out, 4 FR out, 5 screen drain) -> 4-core screened cable -> IX_WS_FRONT c1-c5 (c6 spare). Both plugs: binder 99 0414 00 05, M9 female, 5 pins, unshielded."},{"id":"n_shield","width":390,"color":"Orange","schematicPosition":{"x":1740,"y":480},"text":"SHIELDS (docs/SHIELD-RULES.md; no connector shells, drains on pins). Each sensor screen floats at the sensor. The FL and FR cable screens join at one splice under a Raychem S200-2-W1-22-9 SolderSleeve; its 22 AWG lead is the one drain to IN pin 3. The output cable drain lands on OUT pin 5 and runs on to inline pin 5 and the ECU shield ground. Inside the VRC the build joins IN pin 3 to OUT pin 5 by wire. One screen node, grounded once, at the ECU."},{"id":"n_iso","width":390,"color":"Red","schematicPosition":{"x":1740,"y":750},"text":"ISOLATION. The PCB must not touch the enclosure - nylon standoffs; the board grounds through the output cable only. The screen never touches the case either: the drains run pin to pin inside the box. Mount the enclosure on nylon hardware."},{"id":"n_coat","width":390,"color":"Red","schematicPosition":{"x":1740,"y":930},"text":"NO CONNECTOR OR CASE LANDINGS FOR THE SCREEN. Drains run by pin (IN 3, OUT 5) and join inside the box by wire - nothing bonds to the case and no connector shell carries the screen, so there is no bare-metal spot to mask before powder coat."}],"connectorParts":[{"id":"cp_dt2s_ni","url":"https://www.te.com/usa-en/product-DT06-2S.html","image":{"path":"97d068b9-43c9-4b19-b8c0-ccc45b65fb7b/1790014830313.png","source":"cloud"},"gender":"Female","pinout":{"id":"te-deutsch-dt-2","name":"DT 2-way","pins":[{"x":2.73,"y":0,"size":4.2},{"x":-2.73,"y":0,"size":4.2}],"outline":{"type":"rect","width":15.1,"height":11.7,"cornerRadius":2.5},"features":[{"y":-5.85,"layer":"behind","shape":{"type":"rect","width":8.5,"height":3}}],"mirrored":true},"hasShell":false,"partNumber":"DT06-2S","description":"CONNECTOR, PLUG, DT, 2 POS, SOCKET CONTACTS, N SEAL, GRAY","manufacturer":"TE DEUTSCH","configurations":[{"id":"cfg","lockPartId":"lp_w2s","contactPartId":"ct_dt16s_ni","cavityPlugPartId":"pl_sz16"}],"numberOfCavities":2,"designationStrategy":{"type":"sequential"}},{"id":"cp_dt04_6p","url":"https://www.te.com/usa-en/product-DT04-6P.html","gender":"Male","hasShell":false,"partNumber":"DT04-6P","description":"CONNECTOR, RECEPTACLE, DT, 6 POS, PIN CONTACTS, N SEAL, GRAY","manufacturer":"TE DEUTSCH","configurations":[{"id":"cfg","lockPartId":"lp_w6p","contactPartId":"ct_dt16p","cavityPlugPartId":"pl_sz16"}],"numberOfCavities":6},{"id":"cp_m9_5f","url":"https://www.binder-usa.com/us-en/products/subminiature-circular-connectors/m9-ip67/99-0414-00-05-m9-ip67-female-cable-connector-5-35-50-mm-unshielded-solder-ip67","color":"Black","image":{"path":"97d068b9-43c9-4b19-b8c0-ccc45b65fb7b/1791804249562.png","source":"cloud"},"price":19.32,"gender":"Female","partNumber":"99 0414 00 05","description":"CONNECTOR, CIRCULAR, M9, CABLE CONNECTOR, FEMALE, 5 POS, UNSHIELDED, SOLDER, IP67","manufacturer":"binder","numberOfCavities":5,"configurations":[]}],"contactParts":[{"id":"ct_dt16s_ni","type":"Crimp","gender":"Socket","maxGauge":{"unit":"AWG","value":16},"minGauge":{"unit":"AWG","value":20},"partNumber":"0462-201-16141","description":"CONTACT, SOCKET, SOLID, SIZE 16, NICKEL, 16-20 AWG, 13 A","contactColor":"Silver","manufacturer":"TE DEUTSCH"},{"id":"ct_dt16p","type":"Crimp","gender":"Pin","maxGauge":{"unit":"AWG","value":16},"minGauge":{"unit":"AWG","value":20},"partNumber":"0460-202-1631","description":"CONTACT, PIN, SOLID, SIZE 16, GOLD, 16-20 AWG, 13 A","contactColor":"Gold","manufacturer":"TE DEUTSCH"},{"id":"ct_m9_solder","partNumber":"(integral - 99 0414 00 05)","manufacturer":"binder","type":"Solder","gender":"Socket","description":"CONTACT, SOCKET, SOLDER CUP, INTEGRAL"}],"cableParts":[{"id":"cab_sh_2c","partNumber":"GENERIC SHLD CABLE 2C TP 20AWG","manufacturer":"generic","description":"CABLE, SHIELDED, 2 CONDUCTOR TWISTED PAIR, 20 AWG, FOIL + TINNED COPPER BRAID, JACKETED","cores":[{"id":"k1","color":"White","twistedWithNext":true,"gauge":{"value":20,"unit":"AWG"}},{"id":"k2","color":"Green","gauge":{"value":20,"unit":"AWG"}}],"shielded":true},{"id":"cab_sh_4c","partNumber":"GENERIC SHLD CABLE 4C 20AWG","manufacturer":"generic","description":"CABLE, SHIELDED, 4 CONDUCTOR, 20 AWG, FOIL + TINNED COPPER BRAID, JACKETED","cores":[{"id":"k1","color":"Orange","gauge":{"value":20,"unit":"AWG"}},{"id":"k2","color":"Black","gauge":{"value":20,"unit":"AWG"}},{"id":"k3","color":"Blue","gauge":{"value":20,"unit":"AWG"}},{"id":"k4","color":"Violet","gauge":{"value":20,"unit":"AWG"}}],"shielded":true}],"lockParts":[{"id":"lp_w2s","partNumber":"W2S","description":"WEDGELOCK, DT, 2-WAY PLUG","manufacturer":"TE DEUTSCH"},{"id":"lp_w6p","partNumber":"W6P","description":"WEDGELOCK, DT, 6-WAY RECEPTACLE","manufacturer":"TE DEUTSCH"}],"cavityPlugParts":[{"id":"pl_sz16","partNumber":"114017","description":"PLUG, SEALING, CAVITY, SIZE 16, WHITE","manufacturer":"TE DEUTSCH"}],"splices":[{"id":"sp_vrc_f_in_sh","coveringIds":["cov_s200_22"],"layoutPosition":{"x":450,"y":-90},"schematicPosition":{"x":750,"y":210}}],"wires":[{"id":"w_vrc_f_in_drain","color":"White","source":{"id":"sp_vrc_f_in_sh","handle":"Splice"},"target":{"id":"m9_vrc_f_in","handle":"c3"},"partId":"wp_22_wht_s200"}],"layoutNotes":[{"id":"ln_vrc_f","text":"VRC FRONT","color":"Orange","width":210,"layoutPosition":{"x":630,"y":30}}],"coveringParts":[{"id":"cov_s200_22","partNumber":"S200-2-W1-22-9","manufacturer":"TE Connectivity (Raychem)","type":"HeatShrink","description":"SLEEVE, SOLDERSLEEVE, SHIELD TERMINATOR, 22 AWG LEAD","length":{"unit":"mm","value":150},"isFixedLength":true,"minDiameter":{"unit":"mm","value":1.95},"maxDiameter":{"unit":"mm","value":2.7},"url":"https://www.te.com/commerce/DocumentDelivery/DDEController?Action=srchrtrv&DocLang=English&DocNm=5-1654025-5_sec8_SolderSleevShld_Trmntrs&DocType=CS"}],"wireParts":[{"id":"wp_22_wht_s200","partNumber":"AS22759/91-22-9","manufacturer":"TE Connectivity (Raychem)","description":"WIRE, ELECTRICAL, 22 AWG, WHITE, NICKEL PLATED, STRANDED","color":"White","gauge":{"value":22,"unit":"AWG"}}]}