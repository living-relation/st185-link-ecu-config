ber":"15401-1-2-1-0A","manufacturer":"Eaton Bussmann","description":"MODULE, FUSE AND RELAY, RFRM, SEALED, 40 MINI FUSE, 10 MICRO RELAY, 2 BUS","gender":"Female","hasShell":false,"configurations":[{"id":"cfg","contactPartId":"ct_rfrm"}]},{"id":"cp_mta","partNumber":"0301491","manufacturer":"MTA","description":"MODULE, FUSE AND RELAY, SEALED, 2 MAXI RELAY, 1 MAXI FUSE, 6 MINI FUSE","gender":"Female","hasShell":false,"configurations":[{"id":"cfg","contactPartId":"ct_mta"}]}],"contactParts":[{"partNumber":"(generic)","manufacturer":"Generic","type":"Crimp","gender":"Socket","description":"CONTACT, SOCKET, CRIMP, GENERIC","id":"ct_generic_skt"},{"partNumber":"GENERIC RING M5 10-8","manufacturer":"generic","type":"Other","gender":"Socket","minGauge":{"value":10,"unit":"AWG"},"maxGauge":{"value":8,"unit":"AWG"},"contactColor":"Silver","description":"TERMINAL, LUG, RING, COPPER, TINNED, 10-8 AWG, M5 STUD, ADHESIVE HEATSHRINK","id":"ct_ring_m5_10_8"},{"partNumber":"GENERIC LUG M8 4AWG","manufacturer":"generic","type":"Other","gender":"Socket","minGauge":{"value":6,"unit":"AWG"},"maxGauge":{"value":4,"unit":"AWG"},"contactColor":"Silver","description":"TERMINAL, LUG, RING, COPPER, TINNED, 4 AWG, M8 STUD, ADHESIVE HEATSHRINK","id":"ct_ring_m8_4"},{"id":"ct_rfrm","partNumber":"(Eaton RFRM terminals - per the 15401 drawing)","manufacturer":"Eaton Bussmann","type":"Crimp","gender":"Socket","description":"TERMINAL, FUSE AND RELAY MODULE, RFRM"},{"id":"ct_mta","partNumber":"(MTA 0301491 terminals - per the MTA drawing)","manufacturer":"MTA","type":"Crimp","gender":"Socket","description":"TERMINAL, FUSE AND RELAY MODULE, MTA"},{"id":"ct_ring_m5_6","partNumber":"GENERIC RING M5 6AWG","manufacturer":"generic","type":"Other","gender":"Socket","minGauge":{"value":6,"unit":"AWG"},"maxGauge":{"value":6,"unit":"AWG"},"contactColor":"Silver","description":"TERMINAL, LUG, RING, COPPER, TINNED, 6 AWG, M5 STUD, ADHESIVE HEATSHRINK"}],"terminalParts":[{"type":"Ring","size":"M8","partNumber":"GENERIC LUG M8 4AWG","manufacturer":"generic","minGauge":{"value":6,"unit":"AWG"},"maxGauge":{"value":4,"unit":"AWG"},"description":"TERMINAL, LUG, RING, COPPER, TINNED, 4 AWG, M8 STUD, ADHESIVE HEATSHRINK","id":"tp_lug_m8_4"},{"type":"Ring","size":"M6","partNumber":"GENERIC RING M6 12-10","manufacturer":"generic","minGauge":{"value":12,"unit":"AWG"},"maxGauge":{"value":10,"unit":"AWG"},"description":"TERMINAL, RING, INSULATED, NYLON, M6 STUD, 12-10 AWG","id":"tp_ring_m6_12_10"},{"type":"Ring","size":"M8","partNumber":"GENERIC LUG M8 8AWG","manufacturer":"generic","minGauge":{"value":10,"unit":"AWG"},"maxGauge":{"value":8,"unit":"AWG"},"description":"TERMINAL, LUG, RING, COPPER, TINNED, 8 AWG, M8 STUD, ADHESIVE HEATSHRINK","id":"tp_lug_m8_8"}],"schematicNotes":[{"id":"n_cabinpower","schematicPosition":{"x":0,"y":-300},"text":"CABIN POWER HARNESS - non-ECU: the glove-box fuse box (Option B, _research FUSEBOX-B-SLOT-MAP 2026-10-11): Bussmann LMI (LMI5-M-2-CB1AD + 3x LMI1-M-1-0, ids hcfb l1-l7), Eaton RFRM 15401-1-2-1-0A (rfrm) and 3x MTA 0301491 (mta1-mta3); the battery feed ring (PDB bus) and the fuel pump run to the trunk. The box lives only in this file. The ECU-triggered relay coils stay drawn on ST185-A-cabin / ST185-B-cabin (their ECU trigger sets the loom); every feed between this file and A-cabin, B-cabin, CSB3 or EngineRoom-C is drawn broken off in both with a note naming the other file. RFRM / MTA slot numbers are not assigned: cavities are named by circuit."},{"id":"n_cavity_notes","schematicPosition":{"x":4200,"y":0},"text":"CAVITY NOTES - full text of the signals marked * on this drawing\nCabin fuse block (passenger gl F12: 5A - relay coil feed, PERMANENT (EFI main relay 86)\nCabin fuse block (passenger gl F13: 7.5A - MRS EPS pump logic enable (ignition-switched)\nHigh-current fuse block HCFB H4: 60A AMI - EPS pump relay 30 (k_eps on ST185-B-cabin), Bussmann AMI-60 (60 A, sized 2026-09-28 - sot/channels.csv k_eps c1)"}]}