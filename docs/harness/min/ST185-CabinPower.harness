":10,"unit":"AWG"}},{"id":"wp_14_red","partNumber":"EW-1C14-RED","manufacturer":"generic","description":"WIRE, ELECTRICAL, 14 AWG, RED, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Red","gauge":{"value":14,"unit":"AWG"}},{"id":"wp_tbd_eps","partNumber":"TBD - EPS pump feed wire","manufacturer":"TBD","color":"Red","description":"WIRE, EPS PUMP FEED, GAUGE TBD - need the MR-S ZZW30 EHPS pump current and an ampacity table for the wire (M22759/16 / AS50881) before this gauge is set; 8 AWG was never sourced"}],"connectorParts":[{"partNumber":"(pump pigtail - Walbro F90000295)","manufacturer":"Walbro","description":"CONNECTOR, PIGTAIL, 2 POS - supplied on the Walbro F90000295 pump, 12 in from the pump; the only break in the 20 A circuit (plan 6.41)","numberOfCavities":2,"gender":"Female","hasShell":false,"configurations":[{"id":"cfg","contactPartId":"ct_generic_skt"}],"id":"cp_fuelpump","image":{"source":"url","url":"https://cdn11.bigcommerce.com/s-f5wn3qdqza/images/stencil/original/products/7809/601577/qfs-wiring-pigtail-connector-plug-for-walbro-f90000267-f90000274-f90000285-f90000295-hfp-w267p-qfs__10907.1751166744.jpg","lowResUrl":"https://cdn11.bigcommerce.com/s-f5wn3qdqza/images/stencil/80w/products/7809/601577/qfs-wiring-pigtail-connector-plug-for-walbro-f90000267-f90000274-f90000285-f90000295-hfp-w267p-qfs__10907.1751166744.jpg"}},{"partNumber":"2141029-1","manufacturer":"TE Connectivity","description":"FUSE HOLDER, MODULE, MFINITY, 16 POS MINI FUSE, HARD WIRED - OWNED (qty 1), cover 2141033. Mini fuses max 30 A per position. Fed 50 A from HCFB H1; bus split: IN feeds F1-F4, F8, F12, F13 (permanent), SW IN feeds F9-F11 (EFI main relay 87)","configurations":[{"id":"cfg","contactPartId":"ct_fb_25"}],"id":"cp_fusebox","image":{"source":"url","url":"https://www.te.com/catalog/common/images/PartImages/pr2141029-1.jpg","lowResUrl":"https://www.te.com/catalog/common/images/PartThumbnails/th2141029-1.jpg"}},{"partNumber":"LMI5-M-2-CB1AD","manufacturer":"Eaton Bussmann","description":"FUSE BLOCK, MODULAR, LMI, METRIC, 1 INPUT MODULE (M8 STUD) + 4 AMI FUSE MODULES (M5 STUDS), 400 A MAX COMBINED - glove box beside FB1. Order as components (assembled code has a 100 MOQ): 1x LMI1-M-1-1 input, 4x LMI1-M-1-0 fuse modules, 1x B109-7046-5 busbar, AMI fuses 50/40/30/60 A","numberOfCavities":5,"configurations":[{"id":"cfg","contactPartId":"ct_ring_m5_10_8"}],"id":"cp_lmi5","image":{"source":"url","url":"https://www.mouser.com/images/eatoncorporation/lrg/LMI1-series_SPL.jpg","lowResUrl":"https://www.mouser.com/images/eatoncorporation/sm/LMI1-series_SPL.jpg"}}],"contactParts":[{"partNumber":"(generic)","manufacturer":"Generic","type":"Crimp","gender":"Socket","description":"CONTACT, SOCKET, CRIMP, GENERIC - kit-supplied or OEM pigtail, confirm before ordering","id":"ct_generic_skt"},{"partNumber":"1-1355833-1","manufacturer":"TE Connectivity","type":"Crimp","gender":"Socket","minGauge":{"value":20,"unit":"AWG"},"maxGauge":{"value":18,"unit":"AWG"},"contactColor":"Silver","description":"CONTACT, FUSE, SINGLE, CUNISI PRE-TINNED, 0.5-1.0 MM2 (20-18 AWG) - MFINITY mini fuse module 2141029-1","id":"ct_fb_05"},{"partNumber":"1-1355877-1","manufacturer":"TE Connectivity","type":"Crimp","gender":"Socket","minGauge":{"value":18,"unit":"AWG"},"maxGauge":{"value":14,"unit":"AWG"},"contactColor":"Silver","description":"CONTACT, FUSE, SINGLE, CUNISI PRE-TINNED, 1.0-2.5 MM2 (18-14 AWG) - MFINITY mini fuse module 2141029-1","id":"ct_fb_25"},{"partNumber":"1-1355880-1","manufacturer":"TE Connectivity","type":"Crimp","gender":"Socket","minGauge":{"value":14,"unit":"AWG"},"maxGauge":{"value":12,"unit":"AWG"},"contactColor":"Silver","description":"CONTACT, FUSE, SINGLE, CUNISI PRE-TINNED, 2.5-4 MM2 (14-12 AWG) - MFINITY mini fuse module 2141029-1","id":"ct_fb_4"},{"partNumber":"GENERIC RING M5 10-8","manufacturer":"generic","type":"Other","gender":"Socket","minGauge":{"value":10,"unit":"AWG"},"maxGauge":{"value":8,"unit":"AWG"},"contactColor":"Silver","description":"TERMINAL, LUG, RING, COPPER, TINNED, 10-8 AWG, M5 STUD, ADHESIVE HEATSHRINK - LMI fuse module output studs","id":"ct_ring_m5_10_8"},{"partNumber":"GENERIC LUG M8 4AWG","manufacturer":"generic","type":"Other","gender":"Socket","minGauge":{"value":6,"unit":"AWG"},"maxGauge":{"value":4,"unit":"AWG"},"contactColor":"Silver","description":"TERMINAL, LUG, RING, COPPER, TINNED, 4 AWG, M8 STUD, ADHESIVE HEATSHRINK - LMI input module stud","id":"ct_ring_m8_4"},{"partNumber":"1-1355844-1","manufacturer":"TE Connectivity","type":"Crimp","gender":"Socket","minGauge":{"value":4,"unit":"Metric"},"maxGauge":{"value":6,"unit":"Metric"},"contactColor":"Silver","description":"CONTACT, BUSBAR FEED, CUNISI PRE-TINNED, 4.0-6.0 MM2 (10 AWG) - MFINITY mini fuse module 2141029-1 bus inputs IN / SW IN","id":"ct_fb_bus"}],"terminalParts":[{"type":"Ring","size":"M8","partNumber":"GENERIC LUG M8 4AWG","manufacturer":"generic","minGauge":{"value":6,"unit":"AWG"},"maxGauge":{"value":4,"unit":"AWG"},"description":"TERMINAL, LUG, RING, COPPER, TINNED, 4 AWG, M8 STUD, ADHESIVE HEATSHRINK","id":"tp_lug_m8_4"},{"type":"Ring","size":"M6","partNumber":"GENERIC RING M6 12-10","manufacturer":"generic","minGauge":{"value":12,"unit":"AWG"},"maxGauge":{"value":10,"unit":"AWG"},"description":"TERMINAL, RING, INSULATED, NYLON, M6 STUD, 12-10 AWG","id":"tp_ring_m6_12_10"}],"schematicNotes":[{"id":"n_cabinpower","schematicPosition":{"x":0,"y":-300},"text":"CABIN POWER HARNESS - non-ECU: the cabin fuse block, the high-current fuse block (HCFB), the battery feed ring and the fuel pump run to the trunk. Split out of ST185-A-cabin 2026-09-28 (Daniel) to keep A-cabin under the harness.design 100-connection limit. The relay coils stay on ST185-A-cabin (their ECU-A trigger gives them letter A); every feed between this file and A-cabin or B-cabin is drawn broken off in both with a note naming the other file."},{"id":"n_cavity_notes","schematicPosition":{"x":4200,"y":0},"text":"CAVITY NOTES - full text of the signals marked * on this drawing\nCabin fuse block (passenger gl F12: 5A - relay coil feed, PERMANENT (EFI main relay 86)\nCabin fuse block (passenger gl F13: 7.5A - MRS EPS pump logic enable (ignition-switched)\nHigh-current fuse block HCFB H4: EPS pump relay 30 (k_eps on ST185-B-cabin) - fuse rating TBD - need the MR-S ZZW30 EHPS pump current (Toyota spec or a measured draw) and the Bussmann AMI datasheet; the 60 A AMI was never sourced"}]}