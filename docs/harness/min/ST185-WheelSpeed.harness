:"mm"}},{"id":"bn_bp_1080__dm_sp_shield_a_Splice","sourceId":"bp_1080","targetId":"dm_sp_shield_a_Splice","length":{"value":300,"unit":"mm"}},{"id":"bn_bp_1110__dm_ecu_b_b19","sourceId":"bp_1110","targetId":"dm_ecu_b_b19","length":{"value":360,"unit":"mm"}},{"id":"bn_bp_1140__dm_ecu_b_b20","sourceId":"bp_1140","targetId":"dm_ecu_b_b20","length":{"value":360,"unit":"mm"}},{"id":"bn_bp_1170__dm_ecu_b_b21","sourceId":"bp_1170","targetId":"dm_ecu_b_b21","length":{"value":360,"unit":"mm"}},{"id":"bn_bp_1200__dm_sp_shield_b_Splice","sourceId":"bp_1200","targetId":"dm_sp_shield_b_Splice","length":{"value":360,"unit":"mm"}},{"id":"bn_bp_1890__wss_rl","sourceId":"bp_1890","targetId":"wss_rl","length":{"value":940,"unit":"mm"}},{"id":"bn_bp_1890__wss_rr","sourceId":"bp_1890","targetId":"wss_rr","length":{"value":600,"unit":"mm"}},{"id":"bn_bp_2010__vrc_r_inl","sourceId":"bp_2010","targetId":"vrc_r_inl","length":{"value":230,"unit":"mm"}},{"id":"bn_bp_2040__vrc_r_out","sourceId":"bp_2040","targetId":"vrc_r_out","length":{"value":100,"unit":"mm"}},{"id":"bn_bp_2010__vrc_r_inr","sourceId":"bp_2010","targetId":"vrc_r_inr","length":{"value":50,"unit":"mm"}}],"branchPoints":[{"id":"bp_390","layoutPosition":{"x":390,"y":90}},{"id":"bp_870","layoutPosition":{"x":960,"y":90}},{"id":"bp_990","layoutPosition":{"x":1080,"y":90}},{"id":"bp_1020","layoutPosition":{"x":1200,"y":90}},{"id":"bp_1050","layoutPosition":{"x":1320,"y":90}},{"id":"bp_1080","layoutPosition":{"x":1440,"y":90}},{"id":"bp_1110","layoutPosition":{"x":1560,"y":90}},{"id":"bp_1140","layoutPosition":{"x":1680,"y":90}},{"id":"bp_1170","layoutPosition":{"x":1800,"y":90}},{"id":"bp_1200","layoutPosition":{"x":1920,"y":90}},{"id":"bp_1890","layoutPosition":{"x":2610,"y":90}},{"id":"bp_2010","layoutPosition":{"x":2730,"y":90}},{"id":"bp_2040","layoutPosition":{"x":2850,"y":90}}],"schematicNotes":[{"id":"n_scope","width":390,"schematicPosition":{"x":2820,"y":0},"text":"WHEEL SPEED - STANDALONE HARNESS. No bulkhead connectors anywhere in this drawing (6.31). Front drops are a fender sub-loom of loom C (engine room harness) into the front VRC box; they never cross a bulkhead (Daniel, 2026-09-25). Rear drops run with the fuel pump and level sender to the rear VRC box in the trunk. Only the conditioned output cables reach the ECU, through grommets, so each screen stays unbroken."},{"id":"n_shield","width":390,"color":"Orange","schematicPosition":{"x":2820,"y":210},"text":"SHIELDS - POWERED-DEVICE EXCEPTION (docs/SHIELD-RULES.md). Sensor drop: floats at the sensor, crosses the IN connector on pin 3, wire inside the box to a ring terminal on the case. VRC output: bonded to the box case (OUT connector shielding plate) AND to the ECU shield splice. The case is the junction - still isolated from chassis."},{"id":"n_iso","width":390,"color":"Red","schematicPosition":{"x":2820,"y":390},"text":"TWO ISOLATION RULES. 1. The enclosure must not touch chassis - it is part of the screen, not a ground. Nylon mounting hardware. 2. The PCB must not touch the enclosure - nylon standoffs. The board grounds through the output cable only. If either is bonded, the screen picks up supply-ground noise and it will read as a flaky sensor."},{"id":"n_coat","width":390,"color":"Red","schematicPosition":{"x":2820,"y":570},"text":"MASK THE THREE CONNECTOR LANDINGS AND THE CASE RING-TERMINAL SPOT BEFORE POWDER COAT. The OUT shielding plate and the input screen ring terminals need bare metal. A coated landing silently breaks the screen."},{"id":"n_cavity_notes","text":"CAVITY NOTES - full text of the signals marked * on this drawing\nVRC Front - IN-L 3: Screen (FL) - wire inside box to case ring terminal\nVRC Front - IN-R 3: Screen (FR) - wire inside box to case ring terminal\nVRC Rear - IN-L 3: Screen (RL) - wire inside box to case ring terminal\nVRC Rear - IN-R 3: Screen (RR) - wire inside box to case ring terminal\nsp_shield_a (wired on ST185-A- c1: Front VRC output screen (FL cable) -> sp_shield_a -> ECU-A A7. DRAIN ONLY.\nsp_shield_b (wired on ST185-A- c1: Rear VRC output screen and the front FR output screen -> sp_shield_b -> ECU-B B17. DRAIN ONLY. The FR screen floats at the VRC end so A7 and B17 never meet through the enclosure (Daniel, 2026-09-25).","schematicPosition":{"x":2820,"y":720}}],"connectorParts":[{"partNumber":"DT06-2S","manufacturer":"TE DEUTSCH","description":"CONNECTOR, PLUG, DT, 2 POS, SOCKET CONTACTS, N SEAL, GRAY - ABS wheel speed sensor, harness side; mates DT04-2P on the re-terminated pigtail","numberOfCavities":2,"gender":"Female","hasShell":false,"configurations":[{"id":"cfg","contactPartId":"ct_dt16s_ni","cavityPlugPartId":"pl_sz16","lockPartId":"lp_w2s"}],"url":"https://www.te.com/usa-en/product-DT06-2S.html","image":{"path":"97d068b9-43c9-4b19-b8c0-ccc45b65fb7b/1790014830313.png","source":"cloud"},"pinout":{"id":"te-deutsch-dt-2","name":"DT 2-way","pins":[{"x":2.73,"y":0,"size":4.2},{"x":-2.73,"y":0,"size":4.2}],"outline":{"type":"rect","width":15.1,"height":11.7,"cornerRadius":2.5},"features":[{"y":-5.85,"layer":"behind","shape":{"type":"rect","width":8.5,"height":3}}],"mirrored":true},"designationStrategy":{"type":"sequential"},"id":"cp_dt2s_ni"},{"partNumber":"(cross-reference - no part)","manufacturer":"n/a","description":"REFERENCE, CROSS-DRAWING, NO PART - the real connector, pin or splice is owned by another drawing (plan 6.15). Excluded from the BOM.","id":"cp_xref","image":{"source":"url","url":"https://raw.githubusercontent.com/living-relation/st185-link-ecu-config/main/docs/harness/part-images/cross-reference.png"}},{"partNumber":"99 3363 100 04","manufacturer":"binder","description":"CONNECTOR, PLUG, M8, 4 POS, MALE, CABLE, SHIELDABLE, SCREW CLAMP 0.14-0.5 MM2, CABLE OD 4.0-5.5 MM, IP67 - VRC input lead; mates the box panel receptacle 86 6618 1121 00004. Pin 3 carries the sensor-drop screen (to the case ring inside the box)","numberOfCavities":4,"gender":"Male","hasShell":true,"configurations":[{"id":"cfg","contactPartId":"ct_m8_clamp_pin"}],"image":{"source":"url","url":"https://www.binder-connector.com/prod_media/produktfoto_seo/768_1_KSS.jpg","lowResUrl":"https://www.binder-connector.com/prod_media/_processed_/3/3/csm_768_1_KSS_2db6dbcc1d.jpg"},"id":"cp_m8_plug_m"},{"partNumber":"99 3362 100 04","manufacturer":"binder","description":"CONNECTOR, PLUG, M8, 4 POS, FEMALE, CABLE, SHIELDABLE, SCREW CLAMP 0.14-0.5 MM2, CABLE OD 4.0-5.5 MM, IP67 - VRC output lead; mates the box panel connector 86 6319 1121 00004 (male on the box so a sensor lead cannot plug in)","numberOfCavities":4,"gender":"Female","hasShell":true,"configurations":[{"id":"cfg","contactPartId":"ct_m8_clamp_skt"}],"image":{"source":"url","url":"https://www.binder-connector.com/prod_media/produktfoto_seo/768_2_KDS.jpg","lowResUrl":"https://www.binder-connector.com/prod_media/_processed_/2/9/csm_768_2_KDS_964a4b2a49.jpg"},"id":"cp_m8_plug_f"}],"contactParts":[{"partNumber":"0462-201-16141","manufacturer":"TE DEUTSCH","type":"Crimp","gender":"Socket","minGauge":{"value":20,"unit":"AWG"},"maxGauge":{"value":16,"unit":"AWG"},"contactColor":"Silver","description":"CONTACT, SOCKET, SOLID, SIZE 16, NICKEL, 16-20 AWG, 13 A - DT","id":"ct_dt16s_ni"},{"partNumber":"(integral screw clamp - 99 3363 100 04)","manufacturer":"binder","type":"Other","gender":"Pin","minGauge":{"value":26,"unit":"AWG"},"maxGauge":{"value":20,"unit":"AWG"},"description":"CONTACT, PIN, INTEGRAL SCREW CLAMP, 0.14-0.5 MM2 (26-20 AWG) - binder M8 male cable connector, no loose contact","id":"ct_m8_clamp_pin"},{"partNumber":"(integral screw clamp - 99 3362 100 04)","manufacturer":"binder","type":"Other","gender":"Socket","minGauge":{"value":26,"unit":"AWG"},"maxGauge":{"value":20,"unit":"AWG"},"description":"CONTACT, SOCKET, INTEGRAL SCREW CLAMP, 0.14-0.5 MM2 (26-20 AWG) - binder M8 female cable connector, no loose contact","id":"ct_m8_clamp_skt"}],"cableParts":[{"id":"cab_sh_1c_vio","partNumber":"GENERIC SHLD CABLE 1C 20AWG VIO","manufacturer":"generic","description":"CABLE, SHIELDED, 1 CONDUCTOR, 20 AWG, VIOLET, FOIL + TINNED COPPER BRAID, JACKETED - front VRC FR pulse to ECU B21. Screen to B17 only, floats at the VRC (generic per 6.24)","cores":[{"id":"k1","color":"Violet","gauge":{"value":20,"unit":"AWG"}}],"shielded":true},{"id":"cab_sh_2c","partNumber":"GENERIC SHLD CABLE 2C TP 20AWG","manufacturer":"generic","description":"CABLE, SHIELDED, 2 CONDUCTOR TWISTED PAIR, 20 AWG, FOIL + TINNED COPPER BRAID, JACKETED - sensor pair (generic per 6.24)","cores":[{"id":"k1","color":"White","twistedWithNext":true,"gauge":{"value":20,"unit":"AWG"}},{"id":"k2","color":"Green","gauge":{"value":20,"unit":"AWG"}}],"shielded":true},{"id":"cab_sh_3c","partNumber":"GENERIC SHLD CABLE 3C 20AWG","manufacturer":"generic","description":"CABLE, SHIELDED, 3 CONDUCTOR, 20 AWG, FOIL + TINNED COPPER BRAID, JACKETED - front VRC to ECU: +5V, Gnd Out, FL pulse. Screen to A7 (generic per 6.24)","cores":[{"id":"k1","color":"Orange","gauge":{"value":20,"unit":"AWG"}},{"id":"k2","color":"Black","gauge":{"value":20,"unit":"AWG"}},{"id":"k3","color":"Blue","gauge":{"value":20,"unit":"AWG"}}],"shielded":true},{"id":"cab_sh_4c","partNumber":"GENERIC SHLD CABLE 4C 20AWG","manufacturer":"generic","description":"CABLE, SHIELDED, 4 CONDUCTOR, 20 AWG, FOIL + TINNED COPPER BRAID, JACKETED - rear VRC to ECU (generic per 6.24)","cores":[{"id":"k1","color":"Orange","gauge":{"value":20,"unit":"AWG"}},{"id":"k2","color":"Black","gauge":{"value":20,"unit":"AWG"}},{"id":"k3","color":"Blue","gauge":{"value":20,"unit":"AWG"}},{"id":"k4","color":"Violet","gauge":{"value":20,"unit":"AWG"}}],"shielded":true}],"lockParts":[{"partNumber":"W2S","manufacturer":"TE DEUTSCH","description":"WEDGELOCK, DT, 2-WAY PLUG","id":"lp_w2s"}],"cavityPlugParts":[{"partNumber":"114017","manufacturer":"TE DEUTSCH","description":"PLUG, SEALING, CAVITY, SIZE 16, WHITE - unused size 16 cavity","id":"pl_sz16"}],"mates":[]}