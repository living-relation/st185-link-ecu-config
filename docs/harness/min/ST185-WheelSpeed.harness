c2","designation":"2","signal":"Sensor ground"},{"id":"c3","designation":"3","signal":"Conditioned pulse out (RL)"},{"id":"c4","designation":"4","signal":"Conditioned pulse out (RR)"}],"schematicPosition":{"x":1080,"y":2670},"layoutPosition":{"x":1080,"y":2670}},{"id":"dm_ecu_a_a23","label":"ECU-A-a23","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":1620,"y":600},"layoutPosition":{"x":1620,"y":600}},{"id":"dm_ecu_b_b21","label":"ECU-B-b21","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":2080,"y":1140},"layoutPosition":{"x":2080,"y":1140}},{"id":"dm_ecu_b_b20","label":"ECU-B-b20","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":2080,"y":870},"layoutPosition":{"x":2080,"y":870}},{"id":"dm_ecu_b_b19","label":"ECU-B-b19","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":2080,"y":600},"layoutPosition":{"x":2080,"y":600}},{"id":"dm_sp_5v_Splice","label":"sp_5v-Splice","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":1080,"y":1116},"layoutPosition":{"x":1080,"y":1116}},{"id":"dm_sp_gndout_Splice","label":"sp_gndout-Splice","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":1080,"y":1386},"layoutPosition":{"x":1080,"y":1386}},{"id":"dm_sp_shield_a_Splice","label":"sp_shield_a (wired on ST185-A-ECU)","width":270,"schematicPosition":{"x":1080,"y":1656},"layoutPosition":{"x":1080,"y":1656},"cavities":[{"id":"c1","signal":"Front VRC output screen (FL cable) -> sp_shield_a -> ECU-A A7. DRAIN ONLY."}]},{"id":"dm_sp_shield_b_Splice","label":"sp_shield_b (wired on ST185-A-ECU)","width":270,"schematicPosition":{"x":1080,"y":1776},"layoutPosition":{"x":1080,"y":1776},"cavities":[{"id":"c1","signal":"Rear VRC output screen and the front FR output screen -> sp_shield_b -> ECU-B B17. DRAIN ONLY. The FR screen floats at the VRC end so A7 and B17 never meet through the enclosure (Daniel, 2026-09-25)."}]}],"wires":[],"cables":[{"id":"cab_fl","partId":"cab_sh_2c","schematicPosition":{"x":2872,"y":0},"cores":[{"id":"cab_fl_p","color":"White","twistedWithNext":true,"source":{"id":"wss_fl","handle":"c1"},"target":{"id":"vrc_f_inl","handle":"c1"}},{"id":"cab_fl_n","color":"Green","source":{"id":"wss_fl","handle":"c2"},"target":{"id":"vrc_f_inl","handle":"c2"}}],"shield":{"id":"cab_fl_sh","color":"Shield","source":{"id":"vrc_f_inl","handle":"c3"}}},{"id":"cab_fr","partId":"cab_sh_2c","schematicPosition":{"x":2872,"y":344},"cores":[{"id":"cab_fr_p","color":"White","twistedWithNext":true,"source":{"id":"wss_fr","handle":"c1"},"target":{"id":"vrc_f_inr","handle":"c1"}},{"id":"cab_fr_n","color":"Green","source":{"id":"wss_fr","handle":"c2"},"target":{"id":"vrc_f_inr","handle":"c2"}}],"shield":{"id":"cab_fr_sh","color":"Shield","source":{"id":"vrc_f_inr","handle":"c3"}}},{"id":"cab_rl","partId":"cab_sh_2c","schematicPosition":{"x":648,"y":1155},"cores":[{"id":"cab_rl_p","color":"White","twistedWithNext":true,"source":{"id":"wss_rl","handle":"c1"},"target":{"id":"vrc_r_inl","handle":"c1"}},{"id":"cab_rl_n","color":"Green","source":{"id":"wss_rl","handle":"c2"},"target":{"id":"vrc_r_inl","handle":"c2"}}],"shield":{"id":"cab_rl_sh","color":"Shield","source":{"id":"vrc_r_inl","handle":"c3"}}},{"id":"cab_rr","partId":"cab_sh_2c","schematicPosition":{"x":648,"y":1500},"cores":[{"id":"cab_rr_p","color":"White","twistedWithNext":true,"source":{"id":"wss_rr","handle":"c1"},"target":{"id":"vrc_r_inr","handle":"c1"}},{"id":"cab_rr_n","color":"Green","source":{"id":"wss_rr","handle":"c2"},"target":{"id":"vrc_r_inr","handle":"c2"}}],"shield":{"id":"cab_rr_sh","color":"Shield","source":{"id":"vrc_r_inr","handle":"c3"}}},{"id":"cab_fout","partId":"cab_sh_3c","schematicPosition":{"x":1234,"y":961},"cores":[{"id":"cab_fout_5v","color":"Orange","source":{"id":"dm_sp_5v_Splice","handle":"c1"},"target":{"id":"vrc_f_out","handle":"c1"}},{"id":"cab_fout_gnd","color":"Black","source":{"id":"dm_sp_gndout_Splice","handle":"c1"},"target":{"id":"vrc_f_out","handle":"c2"}},{"id":"cab_fout_l","color":"Blue","source":{"id":"vrc_f_out","handle":"c3"},"target":{"id":"dm_ecu_a_a23","handle":"c1"}}],"shield":{"id":"cab_fout_sh","color":"Shield","source":{"id":"vrc_f_out","handle":"shell"},"target":{"id":"dm_sp_shield_a_Splice","handle":"c1"}}},{"id":"cab_rout","partId":"cab_sh_4c","schematicPosition":{"x":1280,"y":1897},"cores":[{"id":"cab_rout_5v","color":"Orange","source":{"id":"dm_sp_5v_Splice","handle":"c1"},"target":{"id":"vrc_r_out","handle":"c1"}},{"id":"cab_rout_gnd","color":"Black","source":{"id":"dm_sp_gndout_Splice","handle":"c1"},"target":{"id":"vrc_r_out","handle":"c2"}},{"id":"cab_rout_l","color":"Blue","source":{"id":"vrc_r_out","handle":"c3"},"target":{"id":"dm_ecu_b_b20","handle":"c1"}},{"id":"cab_rout_r","color":"Violet","source":{"id":"vrc_r_out","handle":"c4"},"target":{"id":"dm_ecu_b_b19","handle":"c1"}}],"shield":{"id":"cab_rout_sh","color":"Shield","source":{"id":"vrc_r_out","handle":"shell"},"target":{"id":"dm_sp_shield_b_Splice","handle":"c1"}}},{"id":"cab_fout_fr","partId":"cab_sh_1c_vio","schematicPosition":{"x":1234,"y":1250},"cores":[{"id":"cab_fout_r","color":"Violet","source":{"id":"vrc_f_out","handle":"c4"},"target":{"id":"dm_ecu_b_b21","handle":"c1"}}],"shield":{"id":"cab_fout_fr_sh","color":"Shield","source":{"id":"dm_sp_shield_b_Splice","handle":"c1"}}}],"schematicNotes":[{"id":"n_scope","width":390,"schematicPosition":{"x":0,"y":-1400},"text":"WHEEL SPEED - STANDALONE HARNESS. No bulkhead connectors anywhere in this drawing (6.31). Front drops are a fender sub-loom of loom C (engine room harness) into the front VRC box; they never cross a bulkhead (Daniel, 2026-09-25). Rear drops run with the fuel pump and level sender to the rear VRC box in the trunk. Only the conditioned output cables reach the ECU, through grommets, so each screen stays unbroken."},{"id":"n_shield","width":390,"color":"Orange","schematicPosition":{"x":0,"y":-1140},"text":"SHIELDS - POWERED-DEVICE EXCEPTION (docs/SHIELD-RULES.md). Sensor drop: floats at the sensor, crosses the IN connector on pin 3, wire inside the box to a ring terminal on the case. VRC output: bonded to the box case (OUT connector shielding plate) AND to the ECU shield splice. The case is the junction - still isolated from chassis."},{"id":"n_iso","width":390,"color":"Red","schematicPosition":{"x":0,"y":-880},"text":"TWO ISOLATION RULES. 1. The enclosure must not touch chassis - it is part of the screen, not a ground. Nylon mounting hardware. 2. The PCB must not touch the enclosure - nylon standoffs. The board grounds through the output cable only. If either is bonded, the screen picks up supply-ground noise and it will read as a flaky sensor."},{"id":"n_coat","width":390,"color":"Red","schematicPosition":{"x":0,"y":-620},"text":"MASK THE THREE CONNECTOR LANDINGS AND THE CASE RING-TERMINAL SPOT BEFORE POWDER COAT. The OUT shielding plate and the input screen ring terminals need bare metal. A coated landing silently breaks the screen."}],"connectorParts":[{"id":"cp_m8_4f","partNumber":"86 6618 1121 00004","manufacturer":"binder","gender":"Female","hasShell":true,"numberOfCavities":4,"description":"M8 4-way female panel mount, shieldable, THT, IP67, M10x0.75 front fastened. 4.0 A, 50 V AC / 60 V DC, -40 to +85 C. Pin 3 carries the sensor-drop screen; inside the box it runs to a ring terminal on the case (SHIELD-RULES, powered-device exception). The 4 contacts are VR+, VR-, screen, spare."},{"id":"cp_m8_4m","partNumber":"86 6319 1121 00004","manufacturer":"binder","gender":"Male","hasShell":true,"numberOfCavities":4,"description":"M8 4-way male panel mount, shieldable, THT, IP67, front fastened. Same ratings as the female. Male so a sensor lead cannot be plugged into the output by mistake."},{"id":"cp_dt2s_abs","partNumber":"DT06-2S","manufacturer":"Deutsch (TE)","gender":"Female","hasShell":false,"numberOfCavities":2,"configurations":[{"id":"cfg","lockPartId":"lp_w2s","contactPartId":"ct_dt16s"}],"description":"DT 2-way plug, harness side of the ABS wheel speed sensor. Mates to DT04-2P on the sensor pigtail. Size 16 contacts, 16-20 AWG - the sensor cable is 20 AWG for this reason."},{"id":"cp_dt2p_abs","partNumber":"DT04-2P","manufacturer":"Deutsch (TE)","gender":"Male","hasShell":false,"numberOfCavities":2,"configurations":[{"id":"cfg","lockPartId":"lp_w2p","contactPartId":"ct_dt16p"}],"description":"DT 2-way receptacle, SENSOR side. Goes on the ABS sensor pigtail when it is re-terminated. Not wired on this drawing - listed so it reaches the buy list."},{"id":"lp_w2s","partNumber":"W2S","manufacturer":"Deutsch (TE)","description":"Wedgelock for DT06-2S"},{"id":"lp_w2p","partNumber":"W2P","manufacturer":"Deutsch (TE)","description":"Wedgelock for DT04-2P"}],"cableParts":[{"id":"cab_sh_2c","partNumber":"(generic)","manufacturer":"generic","description":"2-core twisted shielded cable, overall foil + braid screen, 20 AWG. Cable is generic in BOMs per 6.24.","cores":[{"id":"k1","color":"White","twistedWithNext":true},{"id":"k2","color":"Green"}],"shielded":true},{"id":"cab_sh_4c","partNumber":"(generic)","manufacturer":"generic","description":"4-core shielded cable, overall foil + braid screen, 20 AWG. Conditioner to ECU. Cable is generic in BOMs per 6.24.","cores":[{"id":"k1","color":"Orange"},{"id":"k2","color":"Black"},{"id":"k3","color":"Blue"},{"id":"k4","color":"Violet"}],"shielded":true},{"id":"cab_sh_3c","partNumber":"(generic)","manufacturer":"generic","description":"3-core shielded cable, overall foil + braid screen, 20 AWG. Front VRC to ECU: +5V, Gnd Out, FL pulse. Screen to A7. Cable is generic in BOMs per 6.24.","cores":[{"id":"k1","color":"Orange"},{"id":"k2","color":"Black"},{"id":"k3","color":"Blue"}],"shielded":true},{"id":"cab_sh_1c_vio","partNumber":"(generic)","manufacturer":"generic","description":"1-core shielded cable, overall foil + braid screen, 20 AWG. Front VRC FR pulse to ECU B21. Screen to B17 only, floats at the VRC so it never touches the enclosure (A7 side). Cable is generic in BOMs per 6.24.","cores":[{"id":"k1","color":"Violet"}],"shielded":true}],"contactParts":[{"id":"ct_dt16s","partNumber":"0462-201-16141","manufacturer":"Deutsch (TE)","gender":"Socket","type":"Crimp","maxGauge":{"unit":"AWG","value":16},"minGauge":{"unit":"AWG","value":20},"description":"DT size 16 solid socket, 16-20 AWG. Harness side. Same contact already used on the DT/DTM sensor connectors elsewhere."},{"id":"ct_dt16p","partNumber":"0460-202-16141","manufacturer":"Deutsch (TE)","gender":"Pin","type":"Crimp","maxGauge":{"unit":"AWG","value":16},"minGauge":{"unit":"AWG","value":20},"description":"DT size 16 solid pin, 16-20 AWG. Sensor pigtail side."}]}