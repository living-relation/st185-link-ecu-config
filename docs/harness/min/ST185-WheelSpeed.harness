"id":"dm_ecu_a_a23","label":"ECU-A-a23","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":1620,"y":600},"layoutPosition":{"x":1620,"y":600}},{"id":"dm_ecu_b_b21","label":"ECU-B-b21","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":2080,"y":1140},"layoutPosition":{"x":2080,"y":1140}},{"id":"dm_ecu_b_b20","label":"ECU-B-b20","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":2080,"y":870},"layoutPosition":{"x":2080,"y":870}},{"id":"dm_ecu_b_b19","label":"ECU-B-b19","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":2080,"y":600},"layoutPosition":{"x":2080,"y":600}},{"id":"dm_sp_5v_Splice","label":"sp_5v-Splice","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":1080,"y":1116},"layoutPosition":{"x":1080,"y":1116}},{"id":"dm_sp_gndout_Splice","label":"sp_gndout-Splice","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":1080,"y":1386},"layoutPosition":{"x":1080,"y":1386}},{"id":"dm_sp_shield_cab_Splice","label":"sp_shield_cab-Splice","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Dummy - real part on the owning drawing, 6.15"}],"schematicPosition":{"x":1080,"y":1656},"layoutPosition":{"x":1080,"y":1656}}],"wires":[],"cables":[{"id":"cab_fl","partId":"cab_2c_sh","schematicPosition":{"x":2872,"y":0},"cores":[{"id":"cab_fl_p","color":"White","twistedWithNext":true,"source":{"id":"wss_fl","handle":"c1"},"target":{"id":"vrc_f_inl","handle":"c1"}},{"id":"cab_fl_n","color":"Green","source":{"id":"wss_fl","handle":"c2"},"target":{"id":"vrc_f_inl","handle":"c2"}}],"shield":{"id":"cab_fl_sh","color":"Shield","source":{"id":"vrc_f_inl","handle":"shell"}}},{"id":"cab_fr","partId":"cab_2c_sh","schematicPosition":{"x":2872,"y":344},"cores":[{"id":"cab_fr_p","color":"White","twistedWithNext":true,"source":{"id":"wss_fr","handle":"c1"},"target":{"id":"vrc_f_inr","handle":"c1"}},{"id":"cab_fr_n","color":"Green","source":{"id":"wss_fr","handle":"c2"},"target":{"id":"vrc_f_inr","handle":"c2"}}],"shield":{"id":"cab_fr_sh","color":"Shield","source":{"id":"vrc_f_inr","handle":"shell"}}},{"id":"cab_rl","partId":"cab_2c_sh","schematicPosition":{"x":648,"y":1155},"cores":[{"id":"cab_rl_p","color":"White","twistedWithNext":true,"source":{"id":"wss_rl","handle":"c1"},"target":{"id":"vrc_r_inl","handle":"c1"}},{"id":"cab_rl_n","color":"Green","source":{"id":"wss_rl","handle":"c2"},"target":{"id":"vrc_r_inl","handle":"c2"}}],"shield":{"id":"cab_rl_sh","color":"Shield","source":{"id":"vrc_r_inl","handle":"shell"}}},{"id":"cab_rr","partId":"cab_2c_sh","schematicPosition":{"x":648,"y":1500},"cores":[{"id":"cab_rr_p","color":"White","twistedWithNext":true,"source":{"id":"wss_rr","handle":"c1"},"target":{"id":"vrc_r_inr","handle":"c1"}},{"id":"cab_rr_n","color":"Green","source":{"id":"wss_rr","handle":"c2"},"target":{"id":"vrc_r_inr","handle":"c2"}}],"shield":{"id":"cab_rr_sh","color":"Shield","source":{"id":"vrc_r_inr","handle":"shell"}}},{"id":"cab_fout","partId":"cab_4c_sh","schematicPosition":{"x":1234,"y":961},"cores":[{"id":"cab_fout_5v","color":"Orange","source":{"id":"dm_sp_5v_Splice","handle":"c1"},"target":{"id":"vrc_f_out","handle":"c1"}},{"id":"cab_fout_gnd","color":"Black","source":{"id":"dm_sp_gndout_Splice","handle":"c1"},"target":{"id":"vrc_f_out","handle":"c2"}},{"id":"cab_fout_l","color":"Blue","source":{"id":"vrc_f_out","handle":"c3"},"target":{"id":"dm_ecu_a_a23","handle":"c1"}},{"id":"cab_fout_r","color":"Violet","source":{"id":"vrc_f_out","handle":"c4"},"target":{"id":"dm_ecu_b_b21","handle":"c1"}}],"shield":{"id":"cab_fout_sh","color":"Shield","source":{"id":"vrc_f_out","handle":"shell"},"target":{"id":"dm_sp_shield_cab_Splice","handle":"c1"}}},{"id":"cab_rout","partId":"cab_4c_sh","schematicPosition":{"x":1280,"y":1897},"cores":[{"id":"cab_rout_5v","color":"Orange","source":{"id":"dm_sp_5v_Splice","handle":"c1"},"target":{"id":"vrc_r_out","handle":"c1"}},{"id":"cab_rout_gnd","color":"Black","source":{"id":"dm_sp_gndout_Splice","handle":"c1"},"target":{"id":"vrc_r_out","handle":"c2"}},{"id":"cab_rout_l","color":"Blue","source":{"id":"vrc_r_out","handle":"c3"},"target":{"id":"dm_ecu_b_b20","handle":"c1"}},{"id":"cab_rout_r","color":"Violet","source":{"id":"vrc_r_out","handle":"c4"},"target":{"id":"dm_ecu_b_b19","handle":"c1"}}],"shield":{"id":"cab_rout_sh","color":"Shield","source":{"id":"vrc_r_out","handle":"shell"},"target":{"id":"dm_sp_shield_cab_Splice","handle":"c1"}}}],"schematicNotes":[{"id":"n_scope","width":390,"schematicPosition":{"x":0,"y":-1400},"text":"WHEEL SPEED - STANDALONE HARNESS. No bulkhead connectors anywhere in this drawing (6.31). Sensor cables cross the firewall through a rubber grommet so each screen stays unbroken. Front pair rides the fenders with loom C; rear pair rides with the fuel pump and level sender."},{"id":"n_shield","width":390,"color":"Orange","schematicPosition":{"x":0,"y":-1140},"text":"SHIELD, END TO END, GROUNDED ONCE (6.30). Sensor end floats. Screen lands 360 deg on the IN connector shell, crosses the metal enclosure, leaves on the OUT connector shell, and grounds only at the ECU shield pin via the cabin shield splice."},{"id":"n_iso","width":390,"color":"Red","schematicPosition":{"x":0,"y":-880},"text":"TWO ISOLATION RULES. 1. The enclosure must not touch chassis - it is part of the screen, not a ground. Nylon mounting hardware. 2. The PCB must not touch the enclosure - nylon standoffs. The board grounds through the output cable only. If either is bonded, the screen picks up supply-ground noise and it will read as a flaky sensor."},{"id":"n_coat","width":390,"color":"Red","schematicPosition":{"x":0,"y":-620},"text":"MASK THE THREE CONNECTOR LANDINGS BEFORE POWDER COAT. The binder shielding plate needs bare metal against the panel. A coated landing silently breaks the screen."}],"connectorParts":[{"id":"cp_abs2","partNumber":"(OEM 2-way)","manufacturer":"Toyota","gender":"Female","hasShell":false,"numberOfCavities":2,"description":"OEM ST185 ABS wheel speed sensor connector. Two wires only - the sensor has no shield pin, which is why the screen floats at this end. Confirm the exact housing against the car before ordering mates."},{"id":"cp_m8_4f","partNumber":"86 6618 1121 00004","manufacturer":"binder","gender":"Female","hasShell":true,"numberOfCavities":4,"description":"M8 4-way female panel mount, shieldable, THT, IP67, M10x0.75 front fastened. 4.0 A, 50 V AC / 60 V DC, -40 to +85 C. Screen terminates on the shielding plate against the panel, so the panel must be bare metal. VR conditioner enclosure inputs."},{"id":"cp_m8_4m","partNumber":"86 6319 1121 00004","manufacturer":"binder","gender":"Male","hasShell":true,"numberOfCavities":4,"description":"M8 4-way male panel mount, shieldable, THT, IP67, front fastened. Same ratings as the female. Male so a sensor lead cannot be plugged into the output by mistake."}],"cableParts":[{"id":"cab_2c_sh","partNumber":"(generic)","manufacturer":"generic","description":"2-core twisted, overall foil + braid screen, 22 AWG. Sensor to conditioner. Cable is generic in BOMs per 6.24.","cores":[{"id":"k1","color":"White"},{"id":"k2","color":"Green"}]},{"id":"cab_4c_sh","partNumber":"(generic)","manufacturer":"generic","description":"4-core, overall foil + braid screen, 22 AWG. Conditioner to ECU. Cable is generic in BOMs per 6.24.","cores":[{"id":"k1","color":"Orange"},{"id":"k2","color":"Black"},{"id":"k3","color":"Blue"},{"id":"k4","color":"Violet"}]}]}