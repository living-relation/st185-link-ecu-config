.24)","cores":[{"id":"k1","color":"White","twistedWithNext":true,"gauge":{"value":20,"unit":"AWG"}},{"id":"k2","color":"Green","gauge":{"value":20,"unit":"AWG"}}],"shielded":true}],"cavityPlugParts":[{"partNumber":"0413-214-1205","manufacturer":"TE DEUTSCH","description":"PLUG, SEALING, CAVITY, SIZE 12, YELLOW - unused size 12 cavity","id":"pl_sz12"},{"partNumber":"114017","manufacturer":"TE DEUTSCH","description":"PLUG, SEALING, CAVITY, SIZE 16, WHITE - unused size 16 cavity","id":"pl_sz16"}],"terminalParts":[{"type":"Loose","partNumber":"GENERIC FLYING LEAD","manufacturer":"generic","minGauge":{"value":22,"unit":"AWG"},"maxGauge":{"value":16,"unit":"AWG"},"description":"TERMINAL, FLYING LEAD - joined to the vehicle circuit at install with a solder sleeve (Raychem D-406 class)","id":"tp_flying_lead"}],"spliceParts":[{"partNumber":"GENERIC CRIMP SPLICE 10-6","manufacturer":"generic","minGauge":{"value":10,"unit":"AWG"},"maxGauge":{"value":6,"unit":"AWG"},"description":"SPLICE, CRIMP, UNINSULATED, COPPER, TINNED, COMBINED 10-6 AWG, ADHESIVE HEATSHRINK OVER","id":"spp_crimp_10_6"},{"partNumber":"GENERIC CRIMP SPLICE 14-10","manufacturer":"generic","minGauge":{"value":14,"unit":"AWG"},"maxGauge":{"value":10,"unit":"AWG"},"description":"SPLICE, CRIMP, UNINSULATED, COPPER, TINNED, COMBINED 14-10 AWG, ADHESIVE HEATSHRINK OVER","id":"spp_crimp_14_10"}],"schematicNotes":[{"id":"n_cavity_notes","text":"CAVITY NOTES - full text of the signals marked * on this drawing\nBulkhead B - engine plug (HDP2 1: Switched 12V - INJECTOR power feed (size 12, 25A)\nBulkhead B - engine plug (HDP2 2: Switched 12V - COP / ignition coil power feed (size 12, 25A)\nGearbox VSS (3-wire, Toyota) - 3: Gearbox VSS signal -> bulkhead B c15 -> ECU-B B29 (DI 8). Actual road speed. 12V direct, no divider - Link DI is +/-50V tolerant with a selectable 4k7 pull-up to 12V.","schematicPosition":{"x":4200,"y":0}}]}