},{"id":"be_930","layoutPosition":{"x":2730,"y":210}},{"id":"bp_at_turbospd","layoutPosition":{"x":690,"y":0}}],"schematicNotes":[{"id":"n_cavity_notes","text":"CAVITY NOTES - full text of the signals marked * on this drawing\nBulkhead B - engine plug (HDP2 1: Switched 12V - INJECTOR power feed (size 12, 25A)\nBulkhead B - engine plug (HDP2 2: Switched 12V - COP / ignition coil power feed (size 12, 25A)\nGearbox VSS (Toyota 83181-20040) - 3: Gearbox VSS signal -> bulkhead B c15 -> ECU-B B29 (DI 8). Actual road speed. 12V direct, no divider - Link DI is +/-50V tolerant with a selectable 4k7 pull-up to 12V. PCLink DI 8 pull-up ON (sot/channels.csv B29).","schematicPosition":{"x":4200,"y":0}}],"wireParts":[{"id":"wp_20_blk","partNumber":"EW-1C20-BLK","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, BLACK, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Black","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_grn","partNumber":"EW-1C20-GRN","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, GREEN, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Green","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_org","partNumber":"EW-1C20-ORG","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, ORANGE, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Orange","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_wht","partNumber":"EW-1C20-WHT","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, WHITE, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"White","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_yel","partNumber":"EW-1C20-YEL","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, YELLOW, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Yellow","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_18_pnk","partNumber":"EW-1C18-PNK","manufacturer":"generic","description":"WIRE, ELECTRICAL, 18 AWG, PINK, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"