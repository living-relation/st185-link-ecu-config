{"$schema":"https://docs.harness.design/files/harness/schema/v0.9.json","$docs":"https://docs.harness.design/files/harness/editing-guide.md","version":0.9,"lengthUnit":"mm","wires":[{"id":"w_trunk_pos","color":"Red","source":{"id":"t_trunk_pos","handle":"Terminal"},"target":{"id":"pdb","handle":"c1"}},{"id":"w_trunk_neg","color":"Black","source":{"id":"t_trunk_neg","handle":"Terminal"},"target":{"id":"pdb","handle":"c8"}},{"id":"w_pdb_rlp","color":"Red","source":{"id":"pdb","handle":"c2"},"target":{"id":"rl_pos_fw","handle":"c1"}},{"id":"w_rl_pos","color":"Red","source":{"id":"rl_pos_fw","handle":"c1"},"target":{"id":"rl_pos_eng","handle":"c1"}},{"id":"w_rlp_str","color":"Red","source":{"id":"rl_pos_eng","handle":"c1"},"target":{"id":"t_starter_b","handle":"Terminal"}},{"id":"w_alt","color":"Red","source":{"id":"t_alt_b","handle":"Terminal"},"target":{"id":"t_starter_b","handle":"Terminal"}},{"id":"w_jump","color":"Red","source":{"id":"t_starter_b","handle":"Terminal"},"target":{"id":"jump_pos","handle":"c1"}},{"id":"w_pdb_rln","color":"Black","source":{"id":"pdb","handle":"c8"},"target":{"id":"rl_neg_fw","handle":"c1"}},{"id":"w_rln","color":"Black","source":{"id":"rl_neg_fw","handle":"c1"},"target":{"id":"rl_neg_eng","handle":"c1"}},{"id":"w_rln_blk","color":"Black","source":{"id":"rl_neg_eng","handle":"c1"},"target":{"id":"t_eng_block","handle":"Terminal"}},{"id":"w_pdb_pmu","color":"Red","source":{"id":"pdb","handle":"c4"},"target":{"id":"pmu","handle":"c1"}},{"id":"w_pmu_gnd","color":"Black","source":{"id":"pmu","handle":"c2"},"target":{"id":"pdb","handle":"c8"}},{"id":"w_pdb_jb1","color":"White","source":{"id":"pdb","handle":"c5"},"target":{"id":"oem_jb1_1i","handle":"c1"}},{"id":"w_pdb_am1","color":"White","source":{"id":"pdb","handle":"c6"},"target":{"id":"oem_ie1","handle":"c10"}},{"id":"w_pdb_am2","color":"Brown","source":{"id":"pdb","handle":"c7"},"target":{"id":"oem_ie1","handle":"c17"}},{"id":"w_pmu_hl","color":"Red","source":{"id":"pmu","handle":"c4"},"target":{"id":"oem_jb2_2a","handle":"c3"}},{"id":"w_pmu_hr","color":"Red","source":{"id":"pmu","handle":"c5"},"target":{"id":"oem_jb2_2a","handle":"c6"}},{"id":"w_hl_twin","color":"Red","source":{"id":"oem_jb2_2a","handle":"c3"},"target":{"id":"oem_jb2_2d","handle":"c2"}},{"id":"w_hr_twin","color":"Red","source":{"id":"oem_jb2_2a","handle":"c6"},"target":{"id":"oem_jb2_2d","handle":"c6"}},{"id":"w_pmu_dome","color":"Red","source":{"id":"pmu","handle":"c7"},"target":{"id":"oem_jb2_2e","handle":"c4"}},{"id":"w_pmu_horn","color":"Red","source":{"id":"pmu","handle":"c6"},"target":{"id":"oem_jb2_2e","handle":"c3"}},{"id":"w_pmu_rtr","color":"Red","source":{"id":"pmu","handle":"c8"},"target":{"id":"oem_jb2_2e","handle":"c2"}},{"id":"w_eps_pwr","color":"Red","source":{"id":"k_eps","handle":"c4"},"target":{"id":"mrs_pwr","handle":"c1"}},{"id":"w_eps_gnd","color":"Black","source":{"id":"mrs_pwr","handle":"c2"},"target":{"id":"t_eng_block","handle":"Terminal"}},{"id":"w_fan_pwr","color":"Red","source":{"id":"k_fan","handle":"c4"},"target":{"id":"rad_fan","handle":"c1"}},{"id":"w_fan_gnd","color":"Black","source":{"id":"rad_fan","handle":"c2"},"target":{"id":"t_gnd_ea","handle":"Terminal"}},{"id":"w_fan2_pwr","color":"Red","source":{"id":"k_fan2","handle":"c4"},"target":{"id":"fan2","handle":"c1"}},{"id":"w_fan2_gnd","color":"Black","source":{"id":"fan2","handle":"c2"},"target":{"id":"t_gnd_ea","handle":"Terminal"}},{"id":"w_rb4","color":"Red","source":{"id":"pdb","handle":"c3"},"target":{"id":"oem_rb4","handle":"c1"}},{"id":"w_rb2","color":"Red","source":{"id":"pdb","handle":"c3"},"target":{"id":"oem_rb2","handle":"c1"}},{"id":"w_gnd_id","color":"Black","source":{"id":"pdb","handle":"c8"},"target":{"id":"t_gnd_id","handle":"Terminal"}},{"id":"w_gnd_ig","color":"Black","source":{"id":"pdb","handle":"c8"},"target":{"id":"t_gnd_ig","handle":"Terminal"}},{"id":"w_gnd_eb","color":"Black","source":{"id":"t_eng_block","handle":"Terminal"},"target":{"id":"t_gnd_eb","handle":"Terminal"}},{"id":"w_mrs_e","source":{"id":"dm_bh_b_eng_c13","handle":"c1"},"target":{"id":"mrs_ctrl","handle":"c2"},"color":"Pink"},{"id":"w_radg","color":"Black","source":{"id":"rad_fan","handle":"c2"},"target":{"id":"dm_sp_chassis_eng_Splice","handle":"c1"}},{"id":"w_fan2g","color":"Black","source":{"id":"fan2","handle":"c2"},"target":{"id":"dm_sp_chassis_eng_Splice","handle":"c1"}},{"id":"w_mrsg","color":"Black","source":{"id":"mrs_pwr","handle":"c2"},"target":{"id":"dm_sp_chassis_eng_Splice","handle":"c1"}},{"id":"w_fb_k_eps_30","color":"Red","source":{"id":"dm_fusebox_c7","handle":"c1"},"target":{"id":"k_eps","handle":"c1"}},{"id":"w_k_eps_86","color":"Red","source":{"id":"dm_sp_sw12_Splice","handle":"c1"},"target":{"id":"k_eps","handle":"c3"}},{"id":"w_hv_mrs_en_e","color":"Red","source":{"id":"dm_bh_b_eng_c14","handle":"c1"},"target":{"id":"mrs_en","handle":"c1"}},{"id":"w_eps_trig","color":"Violet","source":{"id":"dm_ecu_b_b12","handle":"c1"},"target":{"id":"k_eps","handle":"c2"}}],"connectors":[{"id":"pdb","label":"Cabin PDB (glove box)","width":270,"schematicPosition":{"x":0,"y":330},"layoutPosition":{"x":0,"y":330},"cavities":[{"id":"c1","designation":"BAT+","signal":"Trunk battery + 2 AWG / 1/0"},{"id":"c2","designation":"ALT/STR","signal":"To RADLOK +  (starter / 160 A alt)"},{"id":"c3","designation":"FUSE IN","signal":"Cabin fuse block IN"},{"id":"c4","designation":"PMU M6","signal":"PMU-16 battery stud"},{"id":"c5","designation":"OEM HOT","signal":"Always-hot feed to J/B No.1 1I-1"},{"id":"c6","designation":"AM1","signal":"40A fused AM1 to IE1-10 / I9-4"},{"id":"c7","designation":"AM2","signal":"30A fused AM2 to IE1-17 / I9-10"},{"id":"c8","designation":"GND","signal":"Cabin ground bus"}],"partId":"cp_pdb"},{"id":"pmu","label":"Glove-box body block (fuses + relays, ex-J/B2)","width":270,"schematicPosition":{"x":0,"y":690},"layoutPosition":{"x":0,"y":690},"cavities":[{"id":"c1","designation":"IN","signal":"Feed from PDB stud, ANL 100 A"},{"id":"c2","designation":"GND","signal":"Chassis / PDB ground"},{"id":"c3","designation":"IGN","signal":"Ignition-switched relay coil feed (not yet wired)"},{"id":"c4","designation":"HL","signal":"HEAD LH - relay 87, 15 A fuse -> J/B2 2A-3 / 2D-2"},{"id":"c5","designation":"HR","signal":"HEAD RH - relay 87, 15 A fuse -> J/B2 2A-6 / 2D-6"},{"id":"c6","designation":"HZ","signal":"HAZ-HORN - 15 A fuse -> J/B2 2E-3"},{"id":"c7","designation":"DM","signal":"DOME - 20 A fuse, always-hot -> J/B2 2E-4"},{"id":"c8","designation":"RT","signal":"RTR - relay 87, 30 A fuse -> J/B2 2E-2"},{"id":"c9","designation":"WP","signal":"Wiper park - relay 87, 15 A fuse (optional, unused)"},{"id":"c10","designation":"CSB","signal":"CSB3 permanent feed, 5 A - stays live for the kill sequence (plan 6.48)"},{"id":"c11","designation":"DEV","signal":"Cluster + RealDash Pi - device relay 87, held by CSB3 low-side L1 (plan 6.48)"}],"partId":"cp_pmu"},{"id":"k_eps","label":"MR-S EHPS pump relay (HCR150, engine bay)","width":270,"schematicPosition":{"x":2160,"y":90},"layoutPosition":{"x":2160,"y":90},"cavities":[{"id":"c1","designation":"30","signal":"Fused +12V in (F7 60A, Power file)"},{"id":"c2","designation":"85","signal":"Coil - pump relay-request (Signal mrs_ctrl c3)"},{"id":"c3","designation":"86","signal":"Coil + IG-switched 12V"},{"id":"c4","designation":"87","signal":"+12V out, passenger fender to pump"},{"id":"c5","designation":"87a","signal":"not used"}],"partId":"cp_rly_hcr150"},{"id":"k_fan","label":"Rad fan relay (uprated)","width":270,"schematicPosition":{"x":0,"y":1140},"layoutPosition":{"x":0,"y":1140},"cavities":[{"id":"c1","designation":"30","signal":"Fused +12V in (size to fan peak, not OEM 30A)"},{"id":"c2","designation":"85","signal":"Coil - Aux 5 / A29"},{"id":"c3","designation":"86","signal":"Coil + IG-switched 12V"},{"id":"c4","designation":"87","signal":"+12V out to rad fan, engine-room C add-on"},{"id":"c5","designation":"87a","signal":"not used"}],"partId":"cp_rly_cod"},{"id":"k_fan2","label":"Condenser fan relay (uprated)","width":270,"schematicPosition":{"x":0,"y":1410},"layoutPosition":{"x":0,"y":1410},"cavities":[{"id":"c1","designation":"30","signal":"Fused +12V in (size to fan peak, not OEM 20A)"},{"id":"c2","designation":"85","signal":"Coil - Ign 5 / B13, diode-suppressed relay"},{"id":"c3","designation":"86","signal":"Coil + IG-switched 12V"},{"id":"c4","designation":"87","signal":"+12V out to condenser fan"},{"id":"c5","designation":"87a","signal":"not used"}],"partId":"cp_rly_cod"},{"id":"rl_pos_fw","label":"RADLOK + firewall","width":210,"schematicPosition":{"x":720,"y":90},"layoutPosition":{"x":720,"y":90},"cavities":[{"id":"c1","designation":"1","signal":"heavy DC +"}],"partId":"cp_rl_red_fw"},{"id":"rl_pos_eng","label":"RADLOK + engine","width":210,"schematicPosition":{"x":720,"y":240},"layoutPosition":{"x":720,"y":240},"cavities":[{"id":"c1","designation":"1","signal":"heavy DC +"}],"partId":"cp_rl_red_eng"},{"id":"rl_neg_fw","label":"RADLOK - firewall","width":210,"schematicPosition":{"x":720,"y":390},"layoutPosition":{"x":720,"y":390},"cavities":[{"id":"c1","designation":"1","signal":"heavy DC -"}],"partId":"cp_rl_blk_fw"},{"id":"rl_neg_eng","label":"RADLOK - engine","width":210,"schematicPosition":{"x":720,"y":540},"layoutPosition":{"x":720,"y":540},"cavities":[{"id":"c1","designation":"1","signal":"heavy DC -"}],"partId":"cp_rl_blk_eng"},{"id":"oem_jb2_2a","label":"OEM J/B2 2A (engine room main)","width":270,"schematicPosition":{"x":1440,"y":990},"layoutPosition":{"x":1440,"y":990},"cavities":[{"id":"c2","designation":"2","signal":"30A CDS FAN out - DO NOT REFEED, fan moved to k_fan2"},{"id":"c3","designation":"3","signal":"15A HEAD LH (inner circuit) - PMU O1"},{"id":"c4","designation":"4","signal":"RDI FAN out - DO NOT REFEED, fan moved to k_fan"},{"id":"c5","designation":"5","signal":"Engine main relay 87 - DO NOT REFEED, Link EFI in Power"},{"id":"c6","designation":"6","signal":"15A HEAD RH (inner circuit) - PMU O2"}],"partId":"cp_oem"},{"id":"oem_jb2_2d","label":"OEM J/B2 2D (engine room main)","width":270,"schematicPosition":{"x":1440,"y":1260},"layoutPosition":{"x":1440,"y":1260},"cavities":[{"id":"c2","designation":"2","signal":"15A HEAD LH twin of 2A-3 - dummy-header jumper"},{"id":"c3","designation":"3","signal":"Headlight relay coil - unused, PMU switches the lamps"},{"id":"c5","designation":"5","signal":"Rad fan relay coil - unused after fan move"},{"id":"c6","designation":"6","signal":"15A HEAD RH twin of 2A-6 - dummy-header jumper"}],"partId":"cp_oem"},{"id":"oem_jb2_2e","label":"OEM J/B2 2E (engine room main)","width":270,"schematicPosition":{"x":1440,"y":1500},"layoutPosition":{"x":1440,"y":1500},"cavities":[{"id":"c2","designation":"2","signal":"PROBE: inner cct = 30A RTR; starting p.48 = AM1 with 2E-5"},{"id":"c3","designation":"3","signal":"PROBE: inner cct = 15A HAZ-HORN; starting p.48 = AM2 with 2E-6"},{"id":"c4","designation":"4","signal":"20A DOME (inner circuit, not on AM1/AM2 path) - PMU O4"},{"id":"c5","designation":"5","signal":"AM1 pass-through (starting p.48). Do not PMU-feed. Restored at IE1-10"},{"id":"c6","designation":"6","signal":"AM2 / engine-main related. Do not PMU-feed. Restored at IE1-17"},{"id":"c8","designation":"8","signal":"15A EFI - unused, Link EFI relay in cabin"}],"partId":"cp_oem"},{"id":"oem_jb1_1i","label":"OEM J/B1 1I (left kick, ER main)","width":270,"schematicPosition":{"x":1440,"y":450},"layoutPosition":{"x":1440,"y":450},"cavities":[{"id":"c1","designation":"1","signal":"Always-hot B from FL ALT - PRIMARY J/B1 B+"}],"partId":"cp_oem"},{"id":"oem_jb1_1h","label":"OEM J/B1 1H (left kick, ER main)","width":270,"schematicPosition":{"x":1440,"y":270},"layoutPosition":{"x":1440,"y":270},"cavities":[{"id":"c7","designation":"7","signal":"IG2 B-O from ignition switch - keep, do not overlay"},{"id":"c8","designation":"8","signal":"Always-hot related bus"}],"partId":"cp_oem"},{"id":"oem_ie1","label":"OEM IE1 (left kick, ER main <-> cowl)","width":270,"schematicPosition":{"x":1440,"y":90},"layoutPosition":{"x":1440,"y":90},"cavities":[{"id":"c10","designation":"10","signal":"W  AM1 to ignition I9-4"},{"id":"c17","designation":"17","signal":"B-R AM2 to ignition I9-10"}],"partId":"cp_oem"},{"id":"oem_rb4","label":"OEM R/B4 (right kick, by glove box)","width":270,"schematicPosition":{"x":1440,"y":780},"layoutPosition":{"x":1440,"y":780},"cavities":[{"id":"c1","designation":"HTR1","signal":"40A HEATER fuse input"},{"id":"c2","designation":"HTR2","signal":"Heater fuse output / heater relay 30"},{"id":"c3","designation":"STR","signal":"OEM starter relay - isolate, Link k_str replaces"}],"partId":"cp_oem"},{"id":"oem_rb2","label":"OEM R/B2 (left kick)","width":270,"schematicPosition":{"x":1440,"y":600},"layoutPosition":{"x":1440,"y":600},"cavities":[{"id":"c1","designation":"PWR1","signal":"30A POWER fuse input"},{"id":"c2","designation":"PWR2","signal":"Power fuse output / power main relay 30"}],"partId":"cp_oem"},{"id":"mrs_pwr","label":"MR-S EHPS pump - A, main power (90980-12068)","width":270,"schematicPosition":{"x":2160,"y":540},"layoutPosition":{"x":2160,"y":540},"cavities":[{"id":"c1","designation":"1","signal":"12V from k_eps 87, 8 AWG, passenger fender"},{"id":"c2","designation":"2","signal":"GND, 8 AWG to engine block / EB"}],"partId":"cp_mrs_pwr"},{"id":"mrs_en","label":"MR-S EHPS pump - C, ignition (90980-10942)","width":270,"schematicPosition":{"x":2160,"y":360},"layoutPosition":{"x":2160,"y":360},"cavities":[{"id":"c1","designation":"1","signal":"IG-switched 7.5A F13"},{"id":"c2","designation":"2","signal":"unused"}],"partId":"cp_mrs_en"},{"id":"rad_fan","label":"Uprated radiator fan","width":270,"schematicPosition":{"x":2160,"y":1020},"layoutPosition":{"x":2160,"y":1020},"cavities":[{"id":"c1","designation":"12V","signal":"From k_fan 87, 8 AWG"},{"id":"c2","designation":"GND","signal":"To EA / engine-room ground, 8 AWG"}],"partId":"cp_fan"},{"id":"fan2","label":"Uprated condenser fan","width":270,"schematicPosition":{"x":2160,"y":1200},"layoutPosition":{"x":2160,"y":1200},"cavities":[{"id":"c1","designation":"12V","signal":"From k_fan2 87, 8 AWG"},{"id":"c2","designation":"GND","signal":"To EA / engine-room ground, 8 AWG"}],"partId":"cp_fan"},{"id":"jump_pos","label":"Engine-bay jump post","width":210,"schematicPosition":{"x":720,"y":930},"layoutPosition":{"x":720,"y":930},"cavities":[{"id":"c1","designation":"1","signal":"Tied to starter B+ / RADLOK +"}],"partId":"cp_jump"},{"id":"mrs_ctrl","label":"MR-S EHPS pump - B, signal (PN not yet identified)","partId":"cp_mrs_ctrl","cavities":[{"id":"c1","designation":"1","notConnected":true},{"id":"c2","designation":"2","signal":"SPD Out - speed-pulse output"},{"id":"c3","designation":"3","notConnected":true},{"id":"c4","designation":"4","notConnected":true},{"id":"c5","designation":"5","notConnected":true},{"id":"c6","designation":"6","signal":"Relay request out. Not wired - 6.16 moved the EPS relay trigger to the ECU (Ign 6 / B12). Kept for reference."}],"layoutPosition":{"x":2160,"y":720},"schematicPosition":{"x":2160,"y":720}},{"id":"dm_bh_b_eng_c13","label":"BH-B-c13","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Bulkhead B cavity 13 \u2192 ECU-A A27 (Aux 7, MRS SPD) \u2014 wired on ST185-A-ECU"}],"schematicPosition":{"x":2880,"y":90},"layoutPosition":{"x":2880,"y":90}},{"id":"dm_sp_chassis_eng_Splice","label":"sp_chassis_eng-Splice","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Chassis ground splice (sp_chassis) \u2014 wired on ST185-B-ECU"}],"schematicPosition":{"x":2880,"y":690},"layoutPosition":{"x":2880,"y":690}},{"id":"dm_fusebox_c7","label":"FB1-c7","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Fusebox F7, 60A \u2014 EPS pump relay 30, wired on ST185-B-ECU"}],"schematicPosition":{"x":2880,"y":540},"layoutPosition":{"x":2880,"y":540}},{"id":"dm_sp_sw12_Splice","label":"sp_sw12-Splice","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Ignition-switched +12V splice (sp_sw12) \u2014 feeds EFI/ETB/fuel/fan relay coils, wired on ST185-B-ECU"}],"schematicPosition":{"x":2880,"y":840},"layoutPosition":{"x":2880,"y":840}},{"id":"dm_bh_b_eng_c14","label":"BH-B-c14","width":150,"cavities":[{"id":"c1","designation":"1","signal":"Bulkhead B cavity 14 \u2192 MRS EPS pump logic enable (F13, 7.5A, ignition-switched) \u2014 wired on ST185-B-ECU"}],"schematicPosition":{"x":2880,"y":240},"layoutPosition":{"x":2880,"y":240}},{"id":"dm_ecu_b_b12","label":"ECU-B-b12","width":150,"cavities":[{"id":"c1","designation":"1","signal":"ECU-B pin B12 (Ign 6) \u2014 EPS relay trigger per 6.16, branches off at the ECU into loom C. NOTE: B12 still reads notConnected on ST185-A-ECU - fix there."}],"schematicPosition":{"x":2880,"y":390},"layoutPosition":{"x":2880,"y":390}}],"terminals":[{"id":"t_trunk_pos","type":"Ring","signal":"Trunk battery +  (2 AWG or 1/0, jump lug)","width":210,"schematicPosition":{"x":0,"y":90},"layoutPosition":{"x":0,"y":90}},{"id":"t_trunk_neg","type":"Ring","signal":"Trunk battery -  (2 AWG or 1/0, jump lug)","width":210,"schematicPosition":{"x":0,"y":210},"layoutPosition":{"x":0,"y":210}},{"id":"t_starter_b","type":"Ring","signal":"Starter B+ post, jump lug, 2 AWG","width":210,"schematicPosition":{"x":720,"y":690},"layoutPosition":{"x":720,"y":690}},{"id":"t_alt_b","type":"Ring","signal":"160 A alternator B+, 4 AWG to starter B+","width":210,"schematicPosition":{"x":720,"y":810},"layoutPosition":{"x":720,"y":810}},{"id":"t_eng_block","type":"Ring","signal":"Engine block ground stud, 2 AWG, jump lug","width":210,"schematicPosition":{"x":720,"y":1080},"layoutPosition":{"x":720,"y":1080}},{"id":"t_gnd_ea","type":"Ring","signal":"OEM ground EA - right front fender","width":210,"schematicPosition":{"x":2160,"y":1380},"layoutPosition":{"x":2160,"y":1380}},{"id":"t_gnd_eb","type":"Ring","signal":"OEM ground EB - left front fender","width":210,"schematicPosition":{"x":2160,"y":1500},"layoutPosition":{"x":2160,"y":1500}},{"id":"t_gnd_id","type":"Ring","signal":"OEM ground ID - left kick panel","width":210,"schematicPosition":{"x":1440,"y":1800},"layoutPosition":{"x":1440,"y":1800}},{"id":"t_gnd_ig","type":"Ring","signal":"OEM ground IG - R/B4 set bolt, right kick","width":210,"schematicPosition":{"x":1440,"y":1920},"layoutPosition":{"x":1440,"y":1920}}],"mates":[{"id":"m_rlp","sourceId":"rl_pos_fw","targetId":"rl_pos_eng"},{"id":"m_rln","sourceId":"rl_neg_fw","targetId":"rl_neg_eng"}],"schematicNotes":[{"id":"n_intro","text":"ENGINE ROOM HARNESS C - PARTIAL. Only new / upgraded / relocated feeds. Do not redraw the OEM engine-room, cowl or dash looms. Kick-panel J/B No.1, R/B No.2 / No.3 / No.4 stay. Unplug engine-bay J/B No.2 and F11; inject at the pins in the splice table (docs/electrical/ENGINE-ROOM-POWER-REDISTRIBUTION.md).","width":390,"schematicPosition":{"x":0,"y":-390}},{"id":"n_heavy","text":"HEAVY DC: trunk battery -> cabin PDB (glove box) -> RADLOK 5.7 mm through the firewall -> starter B+. 160 A alt B+ joins the starter post and does not recross. Jump lugs at trunk battery, PDB, starter, engine block, and the engine-bay jump post. 2 AWG is OK for cranking; 160 A continuous charge may need 1/0 + 8 mm RADLOK - see the table.","width":390,"schematicPosition":{"x":420,"y":-390},"color":"Orange"},{"id":"n_split","text":"EPS 12 V / GND ride the passenger fender in the vacated ABS actuator space. Fans ride the core-support run of the OEM engine-room main. A/C compressor clutch stays on engine harness A/B (Power/Signal files). Crash sensors and ABS solenoid are deleted - do not refeed 60A FL ABS, A7/A8, A11/A12, A37.","width":390,"schematicPosition":{"x":840,"y":-390},"color":"Green"},{"id":"shdr_0","text":"TRUNK + GLOVE BOX","width":270,"schematicPosition":{"x":0,"y":0},"color":"Green"},{"id":"shdr_1","text":"FIREWALL RADLOK","width":270,"schematicPosition":{"x":720,"y":0},"color":"Orange"},{"id":"n_probe","text":"PROBE BEFORE CRIMPING 2E-2 / 2E-3. Starting + ignition (EWD p.48) puts AM1 on 2E-2/2E-5 and AM2 on 2E-3/2E-6, then IE1-10 / IE1-17. Inner circuit (p.21) puts 30A RTR on 2E-2 and 15A HAZ-HORN on 2E-3. If the unplugged 2E-2 shows continuity to IE1-10, that pin is AM1 - do not land PMU O5 there. Same for 2E-3 vs IE1-17 / AM2. HEAD 2A-3/2A-6 and DOME 2E-4 do not sit on that pass-through. Horn fallback is R/B5.","width":390,"schematicPosition":{"x":1260,"y":-390},"color":"Red"},{"id":"shdr_2","text":"OEM INJECTION (keep J/Bs)","width":390,"schematicPosition":{"x":1440,"y":0},"color":"Red"},{"id":"shdr_3","text":"NEW ENGINE-ROOM LOADS - MR-S EHPS pump (one device: relay + 3 connectors) and both uprated fans","width":270,"schematicPosition":{"x":2160,"y":0},"color":"Blue"}],"connectorParts":[{"id":"cp_pdb","partNumber":"PDB-M8x8","manufacturer":"TBD","description":"8-stud power distribution block at glove box, M8, 150-250 A bus"},{"id":"cp_pmu","partNumber":"(glove-box body block - 2nd fuse block + relays)","manufacturer":"assembly","description":"Replaces the ECUMaster PMU-16, dropped 2026-09-22 (plan 6.46-6.48). A 12-16 way fuse block plus micro ISO relays in the glove box, carrying the ex-J/B2 body circuits and the CAN device feeds. Not a single purchased part - see NEED-TO-BUY."},{"id":"cp_rly_hcr150","partNumber":"V23132-A2001-B200","manufacturer":"TE Connectivity","description":"HCR 150 12VDC 37 ohm / 3.9W, internal suppression. OWNED mating TBD."},{"id":"cp_rly_cod","partNumber":"6-1419137-4","manufacturer":"TE Connectivity","description":"Micro ISO relay V23074, 1 Form C changeover, 12V coil, 25A, diode suppressed"},{"id":"cp_oem","partNumber":"(OEM block)","manufacturer":"Toyota","description":"Generic OEM block - only the pins this harness lands. No invented J/B internals."},{"id":"cp_mrs_pwr","partNumber":"90980-12068","manufacturer":"Toyota / Sumitomo","description":"MR-S EHPS pump main power. OWNED."},{"id":"cp_mrs_en","partNumber":"90980-10942","manufacturer":"Toyota / Sumitomo","description":"MR-S EHPS pump enable. OWNED."},{"id":"cp_fan","partNumber":"DT06-2S","manufacturer":"Deutsch","description":"2-way sealed fan power. Confirm against the fan that is actually fitted."},{"id":"cp_jump","partNumber":"jump-post-M8","manufacturer":"TBD","description":"Engine-bay jump / accessory post on starter B+ net."},{"id":"cp_mrs_ctrl","partNumber":"90980-10897","manufacturer":"Toyota","gender":"Female","hasShell":false,"numberOfCavities":6,"description":"MR-S EHPS pump control connector B, pigtail 82998-12440. Sumitomo TS090 / Yazaki 090-II family, not a TE part. 6 cavities, 2 used: pin 2 speed-pulse out, pin 6 relay-request out. Confirm against the pump in hand before ordering."},{"id":"cp_rl_red_fw","partNumber":"TBD RADLOK red, cabin side","manufacturer":"Amphenol","description":"RADLOK 5.7 battery positive, CABIN side of the firewall. UNVERIFIED - Amphenol lists RL00571-16/-25 (16/25 mm2), no -35, and it is a cable-mount receptacle, not a bulkhead pair. 2 AWG = 33.6 mm2 will not fit 25 mm2. Pick the real part before ordering."},{"id":"cp_rl_red_eng","partNumber":"TBD RADLOK red, engine side","manufacturer":"Amphenol","description":"RADLOK 5.7 battery positive, ENGINE side, mates the cabin half. UNVERIFIED - Amphenol lists RL00571-16/-25 (16/25 mm2), no -35, and it is a cable-mount receptacle, not a bulkhead pair. 2 AWG = 33.6 mm2 will not fit 25 mm2. Pick the real part before ordering."},{"id":"cp_rl_blk_fw","partNumber":"TBD RADLOK black, cabin side","manufacturer":"Amphenol","description":"RADLOK 5.7 battery negative, CABIN side of the firewall. UNVERIFIED - Amphenol lists RL00571-16/-25 (16/25 mm2), no -35, and it is a cable-mount receptacle, not a bulkhead pair. 2 AWG = 33.6 mm2 will not fit 25 mm2. Pick the real part before ordering."},{"id":"cp_rl_blk_eng","partNumber":"TBD RADLOK black, engine side","manufacturer":"Amphenol","description":"RADLOK 5.7 battery negative, ENGINE side, mates the cabin half. UNVERIFIED - Amphenol lists RL00571-16/-25 (16/25 mm2), no -35, and it is a cable-mount receptacle, not a bulkhead pair. 2 AWG = 33.6 mm2 will not fit 25 mm2. Pick the real part before ordering."}],"groupParts":[{"id":"gp_mrs_ehps","partNumber":"MR-S ZZW30 EHPS pump","manufacturer":"Toyota","description":"Electro-hydraulic power steering pump from the MR-S (ZZW30). One device, mounted in the engine bay with its control module bolted to the pump. Presents three connectors - A main power, B signal, C ignition - and is switched by k_eps, an HCR150 mounted beside it. Group k_eps, mrs_pwr, mrs_ctrl and mrs_en together and assign this part. See docs/devices/SENSOR-AND-ACTUATOR-REFERENCE.md."}]}