d":"bn_bp_125__bp_150","sourceId":"bp_125","targetId":"bp_150","length":{"value":35,"unit":"mm"}},{"id":"bn_bp_125__fan2_g","sourceId":"bp_125","targetId":"fan2_g","length":{"value":590,"unit":"mm"}}],"branchPoints":[{"id":"bp_60","layoutPosition":{"x":60,"y":390}},{"id":"bp_120","layoutPosition":{"x":180,"y":390}},{"id":"bp_150","layoutPosition":{"x":420,"y":390}},{"id":"bp_180","layoutPosition":{"x":540,"y":390}},{"id":"bp_210","layoutPosition":{"x":780,"y":390}},{"id":"bp_240","layoutPosition":{"x":900,"y":390}},{"id":"bp_270","layoutPosition":{"x":1020,"y":390}},{"id":"bp_300","layoutPosition":{"x":1140,"y":390}},{"id":"bp_330","layoutPosition":{"x":1260,"y":390}},{"id":"bp_360","layoutPosition":{"x":1380,"y":390}},{"id":"bp_390","layoutPosition":{"x":1500,"y":390}},{"id":"bp_420","layoutPosition":{"x":1620,"y":390}},{"id":"bp_450","layoutPosition":{"x":1740,"y":390}},{"id":"bp_660","layoutPosition":{"x":1950,"y":390}},{"id":"bp_690","layoutPosition":{"x":2070,"y":390}},{"id":"bp_720","layoutPosition":{"x":2190,"y":390}},{"id":"bp_750","layoutPosition":{"x":2310,"y":390}},{"id":"bp_780","layoutPosition":{"x":2430,"y":390}},{"id":"bp_810","layoutPosition":{"x":2550,"y":390}},{"id":"bp_840","layoutPosition":{"x":2670,"y":390}},{"id":"bp_870","layoutPosition":{"x":2790,"y":390}},{"id":"bp_900","layoutPosition":{"x":2910,"y":390}},{"id":"bp_960","layoutPosition":{"x":3150,"y":390}},{"id":"bp_990","layoutPosition":{"x":3270,"y":390}},{"id":"bp_1020","layoutPosition":{"x":3390,"y":390}},{"id":"bp_1050","layoutPosition":{"x":3510,"y":390}},{"id":"bp_1080","layoutPosition":{"x":3630,"y":390}},{"id":"bp_1110","layoutPosition":{"x":3750,"y":390}},{"id":"bp_1140","layoutPosition":{"x":3870,"y":390}},{"id":"bp_1170","layoutPosition":{"x":3990,"y":390}},{"id":"bp_1200","layoutPosition":{"x":4110,"y":390}},{"id":"bp_1230","layoutPosition":{"x":4230,"y":390}},{"id":"bp_1260","layoutPosition":{"x":4350,"y":390}},{"id":"bp_1290","layoutPosition":{"x":4470,"y":390}},{"id":"bp_1320","layoutPosition":{"x":4590,"y":390}},{"id":"bp_1350","layoutPosition":{"x":4710,"y":390}},{"id":"bp_2430","layoutPosition":{"x":5790,"y":390}},{"id":"bp_2460","layoutPosition":{"x":5910,"y":390}},{"id":"bp_185","layoutPosition":{"x":660,"y":390}},{"id":"bp_125","layoutPosition":{"x":300,"y":390}}],"mates":[{"id":"m_rlp","sourceId":"rl_pos_fw","targetId":"rl_pos_eng"},{"id":"m_rln","sourceId":"rl_neg_fw","targetId":"rl_neg_eng"}],"schematicNotes":[{"id":"n_intro","text":"ENGINE ROOM HARNESS C - PARTIAL. Only new / upgraded / relocated feeds. Do not redraw the OEM engine-room, cowl or dash looms. Kick-panel J/B No.1, R/B No.2 / No.3 / No.4 stay. Unplug engine-bay J/B No.2 and F11; inject at the pins in the splice table (docs/electrical/ENGINE-ROOM-POWER-REDISTRIBUTION.md). J/B1 1H is not touched: 1H-7 IG2 (B-O from the ignition switch) stays, do not overlay; 1H-8 is on the always-hot bus.","width":390,"schematicPosition":{"x":3180,"y":0}},{"id":"n_heavy","text":"HEAVY DC: trunk battery -> cabin PDB (glove box) -> RADLOK 5.7 mm through the firewall -> starter B+. 160 A alt B+ joins the starter post and does not recross. Jump lugs at trunk battery, PDB, starter, engine block, and the engine-bay jump post. 2 AWG is OK for cranking; 160 A continuous charge may need 1/0 + 8 mm RADLOK - see the table.","width":390,"schematicPosition":{"x":3180,"y":210},"color":"Orange"},{"id":"n_split","text":"EPS 12 V / GND ride the passenger fender in the vacated ABS actuator space. Fans ride the core-support run of the OEM engine-room main. A/C compressor clutch stays on engine harness A/B (Power/Signal files). Crash sensors and ABS solenoid are deleted - do not refeed 60A FL ABS, A7/A8, A11/A12, A37.","width":390,"schematicPosition":{"x":3180,"y":390},"color":"Green"},{"id":"shdr_0","text":"TRUNK + GLOVE BOX","width":270,"schematicPosition":{"x":3180,"y":570},"color":"Green"},{"id":"shdr_1","text":"FIREWALL RADLOK","width":270,"schematicPosition":{"x":3180,"y":660},"color":"Orange"},{"id":"n_probe","text":"PROBE BEFORE CRIMPING 2E-2 / 2E-3. Starting + ignition (EWD p.48) puts AM1 on 2E-2/2E-5 and AM2 on 2E-3/2E-6, then IE1-10 / IE1-17. Inner circuit (p.21) puts 30A RTR on 2E-2 and 15A HAZ-HORN on 2E-3. If the unplugged 2E-2 shows continuity to IE1-10, that pin is AM1 - do not land PMU O5 there. Same for 2E-3 vs IE1-17 / AM2. HEAD 2A-3/2A-6 and DOME 2E-4 do not sit on that pass-through. Horn fallback is R/B5.","width":390,"schematicPosition":{"x":3180,"y":750},"color":"Red"},{"id":"shdr_2","text":"OEM INJECTION (keep J/Bs)","width":390,"schematicPosition":{"x":3180,"y":960},"color":"Red"},{"id":"shdr_3","text":"NEW ENGINE-ROOM LOADS - MR-S EHPS pump (one device: relay + 3 connectors) and both uprated fans","width":270,"schematicPosition":{"x":3180,"y":1050},"color":"Blue"},{"id":"note_acamp","text":"A/C IS THE AMPLIFIERS' BUSINESS, NOT THE ECU'S - and there are TWO\nRead off the factory EWD automatic-A/C pages, saved in ewd-snips:\n  p150  AUTO A/C AMPLIFIER  A32=conn A, A33=conn B, A34=conn C\n        A1 Ambient Temp -> TAM, conn C pin 6, Y-B (via EA1 4, IQ1 1)\n        A27 Water Temp  -> TW,  conn C pin 20, R-G\n  p152  A/C AMPLIFIER A18 - a SEPARATE module\n        A5 Pressure SW  -> A18 pin 13, Y-R (via EB2 2, E10, IJ1 15)\n        TWO WIRES: pin 1 in on V-R, pin 4 out on Y-R. Dual switch,\n        not a trinary. Same Y-R net also feeds the A3 idle-up VSV.\nEngine-bay parts are loom C's: A1 ambient, A5 pressure switch.\nCabin: A23 room temp, A24 solar, A26 evaporator thermistor, A27 water.\nThe ECU sees NONE of them. Its only A/C tie is Aux 4 / A18 kill.\nSTILL OPEN: both connector part numbers, and the A/C amp pin for the\nambient sensor's Y return leg.","schematicPosition":{"x":3180,"y":1170}},{"id":"n_cavity_notes","text":"CAVITY NOTES - full text of the signals marked * on this drawing\nGlove-box body block (fuses +  IGN: Ignition-switched relay coil feed (not yet wired)\nGlove-box body block (fuses +  HL: HEAD LH - relay 87, 15 A fuse -> J/B2 2A-3 / 2D-2\nGlove-box body block (fuses +  HR: HEAD RH - relay 87, 15 A fuse -> J/B2 2A-6 / 2D-6\nGlove-box body block (fuses +  WP: Wiper park - relay 87, 15 A fuse (optional, unused)\nGlove-box body block (fuses +  CSB: CSB3 permanent feed, 5 A - stays live for the kill sequence (plan 6.48)\nGlove-box body block (fuses +  DEV: Cluster + RealDash Pi - device relay 87, held by CSB3 low-side L1 (plan 6.48)\nGlove-box body block (fuses +  ACPS: A/C pressure switch +12V, 5 A fuse, ignition-switched (was wrongly on F7 60A, the EPS pump fuse)\nMR-S EHPS pump relay (HCR150,  85: ACTIVE-LOW Coil - <- ECU-B B12 (Ign 6) - EPS relay trigger\nCondenser fan relay (uprated, diode) 85: ACTIVE-LOW Coil - Ign 5 / B13, diode-suppressed relay fitted (TE 7-1904094-9)\nOEM J/B2 2A (engine room main) 2: 30A CDS FAN out - DO NOT REFEED, fan moved to k_fan2\nOEM J/B2 2A (engine room main) 5: Engine main relay 87 - DO NOT REFEED, Link EFI in Power\nOEM J/B2 2D (engine room main) 3: Headlight relay coil - unused, PMU switches the lamps\nOEM J/B2 2E (engine room main) 2: PROBE: inner cct = 30A RTR; starting p.48 = AM1 with 2E-5\nOEM J/B2 2E (engine room main) 3: PROBE: inner cct = 15A HAZ-HORN; starting p.48 = AM2 with 2E-6\nOEM J/B2 2E (engine room main) 4: 20A DOME (inner circuit, not on AM1/AM2 path) - PMU O4\nOEM J/B2 2E (engine room main) 5: AM1 pass-through (starting p.48). Do not PMU-feed. Restored at IE1-10\nOEM J/B2 2E (engine room main) 6: AM2 / engine-main related. Do not PMU-feed. Restored at IE1-17\nOEM R/B4 (right kick, by glove STR: OEM starter relay - isolate, Link k_str replaces\nBH-A-c36 1: Bulkhead A cavity 36 \u2192 ECU-A A27 (Aux 7, MRS SPD) \u2014 wired on ST185-A-ECU\nHCFB-H4 1: HCFB H4, 60A AMI \u2014 EPS pump relay 30 ONLY, fuse block on ST185-B-ECU\nsp_sw12-Splice 1: Ignition-switched +12V splice (sp_sw12) \u2014 feeds EFI/ETB/fuel/fan relay coils, wired on ST185-B-ECU\nBH-B-c14 1: Bulkhead B cavity 14 \u2192 MRS EPS pump logic enable (F13, 7.5A, ignition-switched) \u2014 wired on ST185-B-ECU\nECU-B-b12 1: ECU-B pin B12 (Ign 6) \u2014 EPS relay trigger per 6.16, branches off at the ECU into loom C.\nMR-S EHPS pump (A power / B si A-1: [A 90980-12068 pin 1] +12V from k_eps 87, 8 AWG, passenger fender\nMR-S EHPS pump (A power / B si A-2: [A 90980-12068 pin 2] GND, 8 AWG to engine block / EB\nMR-S EHPS pump (A power / B si B-2: [B 90980-10897 pin 2] SPD Out - speed-pulse output to ECU-A A27\nMR-S EHPS pump (A power / B si B-6: [B 90980-10897 pin 6] relay request out - NOT WIRED. 6.16 moved the EPS relay trigger to the ECU (Ign 6 / ecu_b B12). Kept for reference.\nMR-S EHPS pump (A power / B si C-1: [C 90980-10942 pin 1] IG-switched, F13 7.5A - pump enable\nA/C Ambient Temp Sensor (EWD A 1: Ambient temp signal -> A/C amplifier. Thermistor, 2-wire. NOT an ECU input - the ECU has no use for outside air temp.\nA/C Ambient Temp Sensor (EWD A 2: Ambient temp sensor return -> A/C amplifier. The amp supplies its own sensor ground; do NOT tie this to chassis or to Gnd Out.\namb_temp (label): A/C Ambient Temp Sensor (EWD A1, behind front bumper)\nA/C Pressure Switch (EWD A5) - 1: +12V in, wire V-R. EWD p152. Fed from the glove-box body block APS, 5 A.\nA/C Pressure Switch (EWD A5) - 4: Switched out -> A/C AMPLIFIER A18 pin 13, wire Y-R. EWD p152.\nAUTO A/C AMPLIFIER A34 = conn  C-6: TAM - ambient temp in. EWD p150: A1 pin 2 -> EA1 4 -> IQ1 1 -> TAM, conn C pin 6, wire Y-B.\nA/C AMPLIFIER A18 (separate mo 13: A/C pressure switch in. EWD p152: A5 pin 4 -> EB2 2 -> E10 -> IJ1 15 -> A18 pin 13, wire Y-R. Shares this net with the A3 A/C idle-up VSV.","schematicPosition":{"x":3180,"y":1920}}],"wireParts":[{"id":"wp_10_brn","partNumber":"EW-1C10-BRN","manufacturer":"generic","description":"WIRE, ELECTRICAL, 10 AWG, BROWN, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Brown","gauge":{"value":10,"unit":"AWG"}},{"id":"wp_10_red","partNumber":"EW-1C10-RED","manufacturer":"generic","description":"WIRE, ELECTRICAL, 10 AWG, RED, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Red","gauge":{"value":10,"unit":"AWG"}},{"id":"wp_12_red","partNumber":"EW-1C12-RED","manufacturer":"generic","description":"WIRE, ELECTRICAL, 12 AWG, RED, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Red","gauge":{"value":12,"unit":"AWG"}},{"id":"wp_14_red","partNumber":"EW-1C14-RED","manufacturer":"generic","description":"WIRE, ELECTRICAL, 14 AWG, RED, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Red","gauge":{"value":14,"unit":"AWG"}},{"id":"wp_18_vio","partNumber":"EW-1C18-VIO","manufacturer":"generic","description":"WIRE, ELECTRICAL, 18 AWG, VIOLET, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Violet","gauge":{"value":18,"unit":"AWG"}},{"id":"wp_18_yel","partNumber":"EW-1C18-YEL","manufacturer":"generic","description":"WIRE, ELECTRICAL, 18 AWG, YELLOW, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Yellow","gauge":{"value":18,"unit":"AWG"}},{"id":"wp_1_0_blk","partNumber":"BC-1/0-BLK","manufacturer":"generic","description":"CABLE, BATTERY, 1/0 AWG, BLACK, FINE-STRAND COPPER, SAE J1127 SGX 125 C OR EQUIV","color":"Black","gauge":{"value":53.5,"unit":"Metric"}},{"id":"wp_1_0_red","partNumber":"BC-1/0-RED","manufacturer":"generic","description":"CABLE, BATTERY, 1/0 AWG, RED, FINE-STRAND COPPER, SAE J1127 SGX 125 C OR EQUIV","color":"Red","gauge":{"value":53.5,"unit":"Metric"}},{"id":"wp_20_pnk","partNumber":"EW-1C20-PNK","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, PINK, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Pink","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_red","partNumber":"EW-1C20-RED","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, RED, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Red","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_yel","partNumber":"EW-1C20-YEL","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, YELLOW, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Yellow","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_2_red","partNumber":"BC-2-RED","manufacturer":"generic","description":"CABLE, BATTERY, 2 AWG, RED, FINE-STRAND COPPER, SAE J1127 SGX 125 C OR EQUIV","color":"Red","gauge":{"value":2,"unit":"AWG"}},{"id":"wp_4_blk","partNumber":"BC-4-BLK","manufacturer":"generic","description":"CABLE, BATTERY, 4 AWG, BLACK, FINE-STRAND COPPER, SAE J1127 SGX 125 C OR EQUIV","color":"Black","gauge":{"value":4,"unit":"AWG"}},{"id":"wp_4_red","partNumber":"BC-4-RED","manufacturer":"generic","description":"CABLE, BATTERY, 4 AWG, RED, FINE-STRAND COPPER, SAE J1127 SGX 125 C OR EQUIV","color":"Red","gauge":{"value":4,"unit":"AWG"}},{"id":"wp_6_wht","partNumber":"EW-1C6-WHT","manufacturer":"generic","description":"WIRE, ELECTRICAL, 6 AWG, WHITE, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"White","gauge":{"value":6,"unit":"AWG"}},{"id":"wp_8_blk","partNumber":"EW-1C8-BLK","manufacturer":"generic","description":"WIRE, ELECTRICAL, 8 AWG, BLACK, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Black","gauge":{"value":8,"unit":"AWG"}},{"id":"wp_8_red","partNumber":"EW-1C8-RED","manufacturer":"generic","description":"WIRE, ELECTRICAL, 8 AWG, RED, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Red","gauge":{"value":8,"unit":"AWG"}},{"id":"wp_8_wht","partNumber":"EW-1C8-WHT","manufacturer":"generic","description":"WIRE, ELECTRICAL, 8 AWG, WHITE, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"White","gauge":{"value":8,"unit":"AWG"}},{"id":"wp_18_red","partNumber":"EW-1C18-RED","manufacturer":"generic","description":"WIRE, ELECTRICAL, 18 AWG, RED, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Red","gauge":{"value":18,"unit":"AWG"}}],"connectorParts":[{"partNumber":"TBD - A/C pressure switch connector, 2-way","manufacturer":"Toyota","description":"CONNECTOR, PLUG, TOYOTA, 2 POS - A/C dual pressure switch, EWD A5 (pin 1 V-R in, pin 4 Y-R out). PN TBD","numberOfCavities":2,"gender":"Female","hasShell":false,"configurations":[{"id":"cfg","contactPartId":"ct_toy_ts"}],"id":"cp_ac_press","image":{"source":"url","url":"https://raw.githubusercontent.com/living-relation/st185-link-ecu-config/main/docs/harness/part-images/toyota-ac-pressure-sw-2pos.png"}},{"partNumber":"TBD - ambient temp sensor connector","manufacturer":"Toyota","description":"CONNECTOR, PLUG, TOYOTA, 2 POS - A/C ambient temp thermistor, EWD A1, behind front bumper. PN TBD","numberOfCavities":2,"gender":"Female","hasShell":false,"configurations":[{"id":"cfg","contactPartId":"ct_toy_ts"}],"id":"cp_amb_temp","image":{"source":"url","url":"https://raw.githubusercontent.com/living-relation/st185-link-ecu-config/main/docs/harness/part-images/toyota-ambient-temp-2pos.png"}},{"partNumber":"jump-post-M8","manufacturer":"TBD","description":"POST, JUMP START, M8, INSULATED - engine-bay jump post on the starter B+ net","configurations":[{"id":"cfg","contactPartId":"ct_lug_stud"}],"id":"cp_jump","image":{"source":"url","url":"https://raw.githubusercontent.com/living-relation/st185-link-ecu-config/main/docs/harness/part-images/jump-post-m8.png"}},{"partNumber":"MR-S ZZW30 EHPS pump - A 90980-12068 / B 90980-10897 / C 90980-10942","manufacturer":"Toyota / Sumitomo","description":"CONNECTOR SET, TOYOTA, MR-S EHPS PUMP: A 90980-12068 2 POS POWER, B 90980-10897 6 POS SIGNAL, C 90980-10942 2 POS IGNITION - all three owned; drawn as one 10-pin part","numberOfCavities":10,"gender":"Female","hasShell":false,"configurations":[{"id":"cfg","contactPartId":"ct_mrs_ts"}],"id":"cp_mrs_eps","image":{"source":"url","url":"https://www.toyotapartsdeal.com/resources/encry/actual-picture/tpd/large/b98eef393574b2bcce24042861cdfdf7/d639f96bb310fc75d1d06739c53ed204.jpg","lowResUrl":"https://www.toyotapartsdeal.com/resources/encry/actual-picture/tpd/small/b98eef393574b2bcce24042861cdfdf7/d639f96bb310fc75d1d06739c53ed204.jpg"}},{"partNumber":"(OEM block)","manufacturer":"Toyota","description":"CONNECTOR, OEM, JUNCTION OR RELAY BLOCK - only the pins this harness lands. No invented J/B internals","configurations":[{"id":"cfg","contactPartId":"ct_generic_skt"}],"id":"cp_oem","image":{"source":"url","url":"https://raw.githubusercontent.com/living-relation/st185-link-ecu-config/main/docs/harness/part-images/oem-junction-block.png"}},{"partNumber":"PDB-M8x8","manufacturer":"TBD","description":"BLOCK, POWER DISTRIBUTION, 8 STUD M8, 150-250 A BUS - glove box. PN TBD","configurations":[{"id":"cfg","contactPartId":"ct_lug_stud"}],"id":"cp_pdb","image":{"source":"url","url":"https://raw.githubusercontent.com/living-relation/st185-link-ecu-config/main/docs/harness/part-images/pdb-m8x8.png"}},{"partNumber":"(glove-box body block - 2nd fuse block + relays)","manufacturer":"assembly","description":"ASSEMBLY, FUSE AND RELAY BLOCK, 12-16 WAY, GLOVE BOX - ex-J/B2 body circuits and CAN device feeds; replaces the dropped PMU-16 (plan 6.46-6.48). Built up - see NEED-TO-BUY","configurations":[{"id":"cfg","contactPartId":"ct_lug_stud"}],"id":"cp_pmu","image":{"source":"url","url":"https://raw.githubusercontent.com/living-relation/st185-link-ecu-config/main/docs/harness/part-images/glovebox-fuse-relay-block.png"}},{"partNumber":"RL00801-50BK","manufacturer":"Amphenol","description":"CONNECTOR, CABLE, RADLOK 8.0, FEMALE, 200 A, 50 MM2 (1/0), BLACK - battery -, one each side of the RL9080-301-F1 firewall feed-through (engine and cabin), qty 2","configurations":[{"id":"cfg","contactPartId":"ct_radlok8"}],"id":"cp_rl_blk_eng","image":{"source":"url","url":"https://www.mouser.com/images/amphenol/lrg/RADLOCK_Black_SPL.jpg","lowResUrl":"https://www.mouser.com/images/amphenol/sm/RADLOCK_Black_SPL.jpg"}},{"partNumber":"RL00801-50RE","manufacturer":"Amphenol","description":"CONNECTOR, CABLE, RADLOK 8.0, FEMALE, 200 A, 50 MM2 (1/0), RED - battery +, one each side of the RL9080-301-F1RE firewall feed-through (engine and cabin), qty 2","configurations":[{"id":"cfg","contactPartId":"ct_radlok8"}],"id":"cp_rl_red_eng","image":{"source":"url","url":"https://www.mouser.com/images/amphenol/lrg/RADLOCK_Red_SPL.jpg","lowResUrl":"https://www.mouser.com/images/amphenol/sm/RADLOCK_Red_SPL.jpg"}},{"partNumber":"V23132-A2001-B200","manufacturer":"TE Connectivity","description":"RELAY, HIGH CURRENT, HCR 150, 12 V COIL 37 OHM 3.9 W, INTERNAL SUPPRESSION, STUD LOAD TERMINALS - OWNED; coil mate Superseal 1.5 2-way plug 282080-1 with 282110-1 contacts and 281934-2 seals (all owned)","numberOfCavities":5,"configurations":[{"id":"cfg","contactPartId":"ct_ring_m6_8"}],"id":"cp_rly_hcr150","image":{"source":"url","url":"https://www.te.com/catalog/common/images/PartImages/pr_relay_high_current_150.jpg","lowResUrl":"https://www.te.com/catalog/common/images/PartThumbnails/th_relay_high_current_150.jpg"}},{"partNumber":"(cross-reference - no part)","manufacturer":"n/a","description":"REFERENCE, CROSS-DRAWING, NO PART - the real connector, pin or splice is owned by another drawing (plan 6.15). Excluded from the BOM.","id":"cp_xref","image":{"source":"url","url":"https://raw.githubusercontent.com/living-relation/st185-link-ecu-config/main/docs/harness/part-images/cross-reference.png"}},{"partNumber":"1-1393304-0","manufacturer":"TE Connectivity","description":"RELAY, PLUG-IN, MAXI ISO F7 (V23134-J1052-X281), 1 FORM A, 12 V COIL, 560 OHM PARALLEL RESISTOR, 70 A AT 23 C / 50 A AT 85 C, MOUNTING BRACKET - OWNED (qty 2); plugs into socket 1393310-4","numberOfCavities":4,"configurations":[{"id":"cfg","contactPartId":"ct_f7_load","mountPartId":"mt_vcf7"}],"id":"cp_rly_f7_a","image":{"source":"url","url":"https://www.te.com/catalog/common/images/PartImages/pr_relay_power_f7.jpg","lowResUrl":"https://www.te.com/catalog/common/images/PartThumbnails/th_relay_power_f7.jpg"}},{"partNumber":"7-1904094-9","manufacturer":"TE Connectivity","description":"RELAY, PLUG-IN, MAXI ISO F7 (V23134-J0052-X439), 1 FORM A, 12 V COIL, DIODE SUPPRESSED (CATHODE ON 86), 70 A AT 23 C / 50 A AT 85 C - plugs into socket 1393310-4; required on Ign 5 / B13 (no flywheel diode in the ECU output)","numberOfCavities":4,"configurations":[{"id":"cfg","contactPartId":"ct_f7_load","mountPartId":"mt_vcf7"}],"id":"cp_rly_f7_d","image":{"source":"url","url":"https://www.te.com/catalog/common/images/PartImages/pr_relay_power_f7.jpg","lowResUrl":"https://www.te.com/catalog/common/images/PartThumbnails/th_relay_power_f7.jpg"}},{"partNumber":"DTHD06-1-8S","manufacturer":"TE DEUTSCH","description":"CONNECTOR, PLUG, DTHD, 1 POS, SIZE 8 SOCKET CONTACT, 8-10 AWG, 60 A - uprated fan power or ground, one plug per pole; fan lead mates DTHD04-1-8P with 0460-204-08141","numberOfCavities":1,"gender":"Female","hasShell":false,"configurations":[{"id":"cfg","contactPartId":"ct_hd8s"}],"id":"cp_dthd_1_8s","image":{"source":"url","url":"https://www.te.com/content/dam/te-com/catalog/part/DTH/D06/18S/DTHD06-1-8S-t1.jpg/jcr:content/renditions/product-high-res.png","lowResUrl":"https://www.te.com/content/dam/te-com/catalog/part/DTH/D06/18S/DTHD06-1-8S-t1.jpg/jcr:content/renditions/product-details.png"}}],"terminalParts":[{"type":"Ring","size":"M10","partNumber":"GENERIC LUG M10 2AWG","manufacturer":"generic","minGauge":{"value":3,"unit":"AWG"},"maxGauge":{"value":2,"unit":"AWG"},"description":"TERMINAL, LUG, RING, COPPER, TINNED, 2 AWG, M10 STUD, ADHESIVE HEATSHRINK - own lug on a shared stud","id":"tp_lug_m10_2"},{"type":"Ring","size":"M10","partNumber":"GENERIC LUG M10 4AWG","manufacturer":"generic","minGauge":{"value":6,"unit":"AWG"},"maxGauge":{"value":4,"unit":"AWG"},"description":"TERMINAL, LUG, RING, COPPER, TINNED, 4 AWG, M10 STUD, ADHESIVE HEATSHRINK - own lug on a shared stud","id":"tp_lug_m10_4"},{"type":"Ring","size":"M10","partNumber":"GENERIC LUG M10 50MM2","manufacturer":"generic","minGauge":{"value":35,"unit":"Metric"},"maxGauge":{"value":110,"unit":"Metric"},"description":"TERMINAL, LUG, RING, COPPER, TINNED, 50 MM2 (1/0) BARREL, M10 STUD, ADHESIVE HEATSHRINK - one cable per lu