":20}}],"shielded":true,"partNumber":"55PC1133-20-2/6/4-9","description":"CABLE, SHIELDED, 3 CONDUCTOR, 20 AWG, FOIL + TINNED COPPER BRAID, JACKETED","manufacturer":"TE Connectivity (Raychem)"},{"id":"cab_sh_1c_vio","url":"https://www.vniva.com/pdf-f1/55PC1213-18-9-9CS2927.pdf","color":"White","cores":[{"id":"k1","color":"White","gauge":{"unit":"AWG","value":20}}],"shielded":true,"partNumber":"55PC1213-20-9-9","description":"CABLE, SHIELDED, 1 CONDUCTOR, 20 AWG, WHITE, FOIL + TINNED COPPER BRAID, JACKETED","manufacturer":"TE Connectivity (Raychem)"}],"connectors":[{"id":"wss_fl","label":"ABS Wheel Speed FL","width":210,"partId":"cp_dt2s_ni","cavities":[{"id":"c1","signal":"VR+ (front left)","designation":"1"},{"id":"c2","signal":"VR- (front left)","designation":"2"}],"layoutPosition":{"x":0,"y":-300},"schematicPosition":{"x":0,"y":0}},{"id":"wss_fr","label":"ABS Wheel Speed FR","width":210,"partId":"cp_dt2s_ni","cavities":[{"id":"c1","signal":"VR+ (front right)","designation":"1"},{"id":"c2","signal":"VR- (front right)","designation":"2"}],"layoutPosition":{"x":0,"y":300},"schematicPosition":{"x":0,"y":270}},{"id":"ix_ws_front_r","label":"WS FRONT OUT - 6-way inline to ECU spur (IX_WS_FRONT)","width":270,"partId":"cp_dt04_6p","cavities":[{"id":"c1","signal":"+5V - VRC front supply (ECU sensor +5V)","designation":"1"},{"id":"c2","signal":"Gnd Out - VRC front ground","designation":"2"},{"id":"c3","signal":"FL conditioned out -> ECU-A A23 (DI 3)","designation":"3"},{"id":"c4","signal":"FR conditioned out -> ECU-B B21 (DI 4)","designation":"4"},{"id":"c5","signal":"Screen drain, FL/supply cable -> SHIELD_A (A7)","designation":"5"},{"id":"c6","signal":"Screen drain, FR cable -> SHIELD_A (A7); grounded at the VRC case","designation":"6"}],"coveringIds":["cov_s200_3","cov_s200_2"],"layoutPosition":{"x":3300,"y":90},"schematicPosition":{"x":1500,"y":540}}],"lengthUnit":"mm","spliceParts":[{"id":"spp_butt_22_16","maxGauge":{"unit":"AWG","value":16},"minGauge":{"unit":"AWG","value":22},"partNumber":"GENERIC BUTT SPLICE 22-16","description":"SPLICE, BUTT, INSULATED, 22-16 AWG","manufacturer":"generic"}],"branchPoints":[{"id":"bp_f_y","layoutPosition":{"x":450,"y":0}},{"id":"bp_f_vrc","layoutPosition":{"x":750,"y":0}},{"id":"bp_f_inl","layoutPosition":{"x":900,"y":-150}},{"id":"bp_f_inr","layoutPosition":{"x":900,"y":150}},{"id":"bp_f_out","layoutPosition":{"x":1140,"y":0}},{"id":"bp_f_fwd","layoutPosition":{"x":3000,"y":90}}],"contactParts":[{"id":"ct_dt16s_ni","type":"Crimp","gender":"Socket","maxGauge":{"unit":"AWG","value":16},"minGauge":{"unit":"AWG","value":20},"partNumber":"0462-201-16141","description":"CONTACT, SOCKET, SOLID, SIZE 16, NICKEL, 16-20 AWG, 13 A","contactColor":"Silver","manufacturer":"TE DEUTSCH"},{"id":"ct_dt16p","type":"Crimp","gender":"Pin","maxGauge":{"unit":"AWG","value":16},"minGauge":{"unit":"AWG","value":20},"partNumber":"0460-202-1631","description":"CONTACT, PIN, SOLID, SIZE 16, GOLD, 16-20 AWG, 13 A","contactColor":"Gold","manufacturer":"TE DEUTSCH"}],"coveringParts":[{"id":"cov_s200_2","url":"https://www.te.com/commerce/DocumentDelivery/DDEController?Action=srchrtrv&DocLang=English&DocNm=5-1654025-5_sec8_SolderSleevShld_Trmntrs&DocType=CS","type":"HeatShrink","length":{"unit":"mm","value":150},"partNumber":"S200-2-WI-22-9","description":"SLEEVE, SOLDERSLEEVE SHIELD DRAIN 22AWG","maxDiameter":{"unit":"mm","value":2.7},"minDiameter":{"unit":"mm","value":1.95},"manufacturer":"TE Connectivity (Raychem)","isFixedLength":true},{"id":"cov_s200_3","url":"https://www.te.com/commerce/DocumentDelivery/DDEController?Action=srchrtrv&DocLang=English&DocNm=5-1654025-5_sec8_SolderSleevShld_Trmntrs&DocType=CS","type":"HeatShrink","length":{"unit":"mm","value":150},"partNumber":"S200-3-WI-22-9","description":"SLEEVE, SOLDERSLEEVE SHIELD DRAIN 22AWG","maxDiameter":{"unit":"mm","value":4.3},"minDiameter":{"unit":"mm","value":2.7},"manufacturer":"TE Connectivity (Raychem)","isFixedLength":true}],"connectorParts":[{"id":"cp_dt2s_ni","url":"https://www.te.com/usa-en/product-DT06-2S.html","image":{"path":"97d068b9-43c9-4b19-b8c0-ccc45b65fb7b/1790014830313.png","source":"cloud"},"gender":"Female","pinout":{"id":"te-deutsch-dt-2","name":"DT 2-way","pins":[{"x":2.73,"y":0,"size":4.2},{"x":-2.73,"y":0,"size":4.2}],"outline":{"type":"rect","width":15.1,"height":11.7,"cornerRadius":2.5},"features":[{"y":-5.85,"layer":"behind","shape":{"type":"rect","width":8.5,"height":3}}],"mirrored":true},"hasShell":false,"partNumber":"DT06-2S","description":"CONNECTOR, PLUG, DT, 2 POS, SOCKET CONTACTS, N SEAL, GRAY","manufacturer":"TE DEUTSCH","configurations":[{"id":"cfg","lockPartId":"lp_w2s","contactPartId":"ct_dt16s_ni","cavityPlugPartId":"pl_sz16"}],"numberOfCavities":2,"designationStrategy":{"type":"sequential"}},{"id":"cp_dt04_6p","url":"https://www.te.com/usa-en/product-DT04-6P.html","gender":"Male","hasShell":false,"partNumber":"DT04-6P","description":"CONNECTOR, RECEPTACLE, DT, 6 POS, PIN CONTACTS, N SEAL, GRAY","manufacturer":"TE DEUTSCH","configurations":[{"id":"cfg","lockPartId":"lp_w6p","contactPartId":"ct_dt16p","cavityPlugPartId":"pl_sz16"}],"numberOfCavities":6}],"schematicNotes":[{"id":"n_scope","text":"FRONT WHEEL SPEED - one Y harness. FL and FR ABS drops (loom C fender route, no bulkhead) run to the front VRC; the output runs through a grommet to the 6-way inline DT04-6P near the ECU (IX_WS_FRONT). The ECU side owns only the short spur and the DT06-6S mating half (ST185-A-cabin; the FR core belongs to ST185-B-cabin). FR screen stays on pin 6 and joins SHIELD_A (A7), not B17.","width":390,"schematicPosition":{"x":1920,"y":0}},{"id":"n_vrc","text":"VRC NOT DRAWN. The VR conditioner, its enclosure and its M8 panel connectors belong to the enclosure build, not this harness. Loose ends VRC_FRONT_IN_L / IN_R / OUT are device endpoints: each lead lands on the matching M8 cable-plug pin when the box is built.","color":"Orange","width":390,"schematicPosition":{"x":1920,"y":210}},{"id":"n_shield","text":"SHIELDS. Sensor ends float (no S200). At the VRC both input drains are S200-3 and spliced before the plugs: each drain lands on its own IN pin 3, and the combined drain also lands on the OUT screen pin, which already continues on inline pin 5 to SHIELD_A (ECU-A A7). The FL/supply OUT drain (S200-3) and the FR OUT drain land on that same OUT screen pin. The FR OUT screen stays on inline pin 6 and continues to SHIELD_A (A7), not B17. No shield stops at the sensor. S200 only on terminated ends. A7 and B17 stay separate.","color":"Orange","width":390,"schematicPosition":{"x":1920,"y":420}},{"id":"n_iso","text":"TWO ISOLATION RULES. 1. The enclosure must not touch chassis - it is part of the screen, not a ground. Nylon mounting hardware. 2. The PCB must not touch the enclosure - nylon standoffs. The board grounds through the output cable only. If either is bonded, the screen picks up supply-ground noise and it will read as a flaky sensor.","color":"Red","width":390,"schematicPosition":{"x":1920,"y":630}},{"id":"n_coat","text":"MASK THE THREE CONNECTOR LANDINGS AND THE CASE RING-TERMINAL SPOT BEFORE POWDER COAT. The OUT shielding plate and the input screen ring terminals need bare metal. A coated landing silently breaks the screen.","color":"Red","width":390,"schematicPosition":{"x":1920,"y":810}}],"cavityPlugParts":[{"id":"pl_sz16","partNumber":"114017","description":"PLUG, SEALING, CAVITY, SIZE 16, WHITE","manufacturer":"TE DEUTSCH"}]}