lice"},"partId":"wp_20_grn"},{"id":"wc_term3","color":"White","source":{"id":"r_term_end","handle":"Left"},"target":{"id":"sp_canh_lam","handle":"Splice"},"partId":"wp_20_wht"},{"id":"wc_term4","color":"Green","source":{"id":"r_term_end","handle":"Right"},"target":{"id":"sp_canl_lam","handle":"Splice"},"partId":"wp_20_grn"},{"id":"wc_h_lam_pin","color":"White","source":{"id":"sp_canh_lam","handle":"Splice"},"target":{"id":"lambda","handle":"c4"},"partId":"wp_20_wht"},{"id":"wc_l_lam_pin","color":"Green","source":{"id":"sp_canl_lam","handle":"Splice"},"target":{"id":"lambda","handle":"c3"},"partId":"wp_20_grn"},{"id":"w_lam12_can","source":{"id":"lambda","handle":"c1"},"target":{"id":"br_w_lam12","handle":"Terminal"},"color":"Red","partId":"wp_20_red"},{"id":"w_lamg_can","source":{"id":"lambda","handle":"c2"},"target":{"id":"br_w_lamg","handle":"Terminal"},"color":"Black","partId":"wp_20_blk"}],"bundles":[{"id":"bn_bp_390__bp_780","sourceId":"bp_390","targetId":"bp_780","length":{"value":690,"unit":"mm"}},{"id":"bn_bp_780__bp_840","sourceId":"bp_780","targetId":"bp_840","length":{"value":130,"unit":"mm"}},{"id":"bn_bp_840__bp_930","sourceId":"bp_840","targetId":"bp_930","length":{"value":160,"unit":"mm"}},{"id":"bn_bp_930__ecu_com","sourceId":"bp_930","targetId":"ecu_com","length":{"value":180,"unit":"mm"}},{"id":"bn_ecu_com__bp_1050","sourceId":"ecu_com","targetId":"bp_1050","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_390__lambda","sourceId":"bp_390","targetId":"lambda","length":{"value":90,"unit":"mm"}},{"id":"bn_bp_930__t_cluster_can","sourceId":"bp_930","targetId":"t_cluster_can","length":{"value":660,"unit":"mm"}},{"id":"bn_bp_1050__t_realdash_can","sourceId":"bp_1050","targetId":"t_realdash_can","length":{"value":300,"unit":"mm"}},{"id":"bn_bp_1050__br_wc_h_csb","sourceId":"bp_1050","targetId":"br_wc_h_csb","length":{"value":90,"unit":"mm"}},{"id":"bn_bp_1050__br_wc_l_csb","sourceId":"bp_1050","targetId":"br_wc_l_csb","length":{"value":90,"unit":"mm"}},{"id