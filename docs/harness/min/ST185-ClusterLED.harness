{"version":0.9,"connectors":[{"id":"cl_c11","label":"OEM cluster connector C11","width":390,"cavities":[{"id":"c2","designation":"2","signal":"Turn L (G-B) - flasher LH stub"},{"id":"c11","designation":"11","signal":"Turn R (G-Y) - flasher RH stub"},{"id":"c12","designation":"12","signal":"High beam (R-L) - body residual feed"}],"schematicPosition":{"x":0,"y":0},"layoutPosition":{"x":960,"y":-150},"partId":"cp_cluster"},{"id":"cl_c12","label":"OEM cluster connector C12","width":390,"cavities":[{"id":"c1","designation":"1","signal":"Park brake (R-G) - grounds via OEM P1 / B2"},{"id":"c8","designation":"8","signal":"Alt L (Y) - charge-lamp drive"},{"id":"c9","designation":"9","signal":"IG +12 (B-O) - one tap feeds every LED anode and the charge excite resistor"}],"schematicPosition":{"x":0,"y":180},"layoutPosition":{"x":960,"y":-330},"partId":"cp_cluster"},{"id":"dm_csb3io_c26","label":"CSB3-c26 (L4)","width":390,"cavities":[{"id":"c1","designation":"1","signal":"ECUMaster CSB3 L4 low-side - oil pressure LED sink, CAN 0x643 *"}],"schematicPosition":{"x":660,"y":90},"layoutPosition":{"x":1200,"y":180},"partId":"cp_xref","excludeFromBom":true}],"terminals":[{"id":"t_led_gnd","type":"Ring","width":390,"signal":"LED common return - OEM ground ID, left kick panel (M6, assumed)","schematicPosition":{"x":660,"y":0},"layoutPosition":{"x":1080,"y":-390},"partId":"tp_ring_m6_22_16"}],"splices":[{"id":"sp_led_gnd","schematicPosition":{"x":510,"y":0},"layoutPosition":{"x":1140,"y":-330},"partId":"spp_solder_26_14","locationId":"bp_990"},{"id":"sp_led_12v","schematicPosition":{"x":510,"y":360},"layoutPosition":{"x":1140,"y":-390},"partId":"spp_crimp_14_10","locationId":"bp_990"}],"resistors":[{"id":"r_chg_excite","partId":"rp_chg_excite","locationId":"bp_960","schematicPosition":{"x":510,"y":180},"layoutPosition":{"x":1020,"y":-330}}],"diodes":[{"id":"d_hb","partId":"dp_led","anodeOnRight":false,"schematicPosition":{"x":450,"y":0},"layoutPosition":{"x":1020,"y":-390},"locationId":"bp_960"},{"id":"d_tl","partId":"dp_led","anodeOnRight":false,"schematicPosition":{"x":570,"y":0},"layoutPosition":{"x":1020,"y":-450},"locationId":"bp_960"},{"id":"d_tr","partId":"dp_led","anodeOnRight":false,"schematicPosition":{"x":510,"y":60},"layoutPosition":{"x":1020,"y":-510},"locationId":"bp_960"},{"id":"d_pk","partId":"dp_led","anodeOnRight":false,"schematicPosition":{"x":450,"y":180},"layoutPosition":{"x":1020,"y":-570},"locationId":"bp_960"},{"id":"d_chg","partId":"dp_led","anodeOnRight":false,"schematicPosition":{"x":570,"y":180},"layoutPosition":{"x":1020,"y":-630},"locationId":"bp_960"},{"id":"d_oil","partId":"dp_led","anodeOnRight":false,"schematicPosition":{"x":450,"y":90},"layoutPosition":{"x":1260,"y":-330},"locationId":"bp_1020"}],"wires":[{"id":"w_hb_a","color":"Red","source":{"id":"cl_c11","handle":"c12"},"target":{"id":"d_hb","handle":"Left"},"partId":"wp_20_red"},{"id":"w_hb_k","color":"Black","source":{"id":"d_hb","handle":"Right"},"target":{"id":"sp_led_gnd","handle":"Splice"},"partId":"wp_20_blk"},{"id":"w_tl_a","color":"Green","source":{"id":"cl_c11","handle":"c2"},"target":{"id":"d_tl","handle":"Left"},"partId":"wp_20_grn"},{"id":"w_tl_k","color":"Black","source":{"id":"d_tl","handle":"Right"},"target":{"id":"sp_led_gnd","handle":"Splice"},"partId":"wp_20_blk"},{"id":"w_tr_a","color":"Green","source":{"id":"cl_c11","handle":"c11"},"target":{"id":"d_tr","handle":"Left"},"partId":"wp_20_grn"},{"id":"w_tr_k","color":"Black","source":{"id":"d_tr","handle":"Right"},"target":{"id":"sp_led_gnd","handle":"Splice"},"partId":"wp_20_blk"},{"id":"w_led_gnd_out","color":"Black","source":{"id":"sp_led_gnd","handle":"Splice"},"target":{"id":"t_led_gnd","handle":"Terminal"},"partId":"wp_20_blk"},{"id":"w_pk_a","color":"Red","source":{"id":"sp_led_12v","handle":"Splice"},"target":{"id":"d_pk","handle":"Left"},"partId":"wp_20_red"},{"id":"w_pk_k","color":"Red","source":{"id":"d_pk","handle":"Right"},"target":{"id":"cl_c12","handle":"c1"},"stripeColor":"Green","partId":"wp_20_red_grn"},{"id":"w_chg_a","color":"Black","source":{"id":"sp_led_12v","handle":"Splice"},"target":{"id":"d_chg","handle":"Left"},"stripeColor":"Orange","partId":"wp_20_blk_org"},{"id":"w_chg_k","color":"Yellow","source":{"id":"d_chg","handle":"Right"},"target":{"id":"cl_c12","handle":"c8"},"partId":"wp_20_yel"},{"id":"w_oil_a","color":"Red","source":{"id":"sp_led_12v","handle":"Splice"},"target":{"id":"d_oil","handle":"Left"},"partId":"wp_20_red"},{"id":"w_oil_k","color":"White","source":{"id":"d_oil","handle":"Right"},"target":{"id":"dm_csb3io_c26","handle":"c1"},"partId":"wp_20_wht"},{"id":"w_chg_ex_a","color":"Black","source":{"id":"sp_led_12v","handle":"Splice"},"target":{"id":"r_chg_excite","handle":"Left"},"partId":"wp_20_blk"},{"id":"w_chg_ex_k","color":"Yellow","source":{"id":"r_chg_excite","handle":"Right"},"target":{"id":"cl_c12","handle":"c8"},"partId":"wp_20_yel"},{"id":"w_ig_tap","color":"Black","stripeColor":"Orange","source":{"id":"cl_c12","handle":"c9"},"target":{"id":"sp_led_12v","handle":"Splice"},"partId":"wp_20_blk_org"}],"bundles":[{"id":"bn_cl_c11__bp_960","sourceId":"cl_c11","targetId":"bp_960","length":{"value":20,"unit":"mm"}},{"id":"bn_bp_960__bp_990","sourceId":"bp_960","targetId":"bp_990","length":{"value":10,"unit":"mm"}},{"id":"bn_bp_990__bp_1020","sourceId":"bp_990","targetId":"bp_1020","length":{"value":150,"unit":"mm"}},{"id":"bn_bp_960__cl_c12","sourceId":"bp_960","targetId":"cl_c12","length":{"value":90,"unit":"mm"}},{"id":"bn_bp_990__t_led_gnd","sourceId":"bp_990","targetId":"t_led_gnd","length":{"value":110,"unit":"mm"}},{"id":"bn_bp_1020__dm_csb3io_c26","sourceId":"bp_1020","targetId":"dm_csb3io_c26","length":{"value":780,"unit":"mm"}}],"branchPoints":[{"id":"bp_960","layoutPosition":{"x":960,"y":-240}},{"id":"bp_990","layoutPosition":{"x":1080,"y":-240}},{"id":"bp_1020","layoutPosition":{"x":1200,"y":-240}}],"schematicNotes":[{"id":"n_src","text":"ST185 cluster LED loom. A separate circuit from the cluster itself - warning and status indicators only. Migrated 2026-09-19 from docs/electrical/CLUSTER-LED-DIAGRAM.html, which was the only record of these connections.","width":390,"schematicPosition":{"x":1200,"y":0}},{"id":"n_stripe","text":"Stripe colours live in the cavity text - the schema colour list has no striped values. C11-2 G-B, C11-11 G-Y, C11-12 R-L, C12-1 R-G, C12-8 Y, C12-9 B-O.","width":390,"schematicPosition":{"x":1200,"y":150}},{"id":"n_chg","text":"Charge LED is a series path: IG +12 (C12-9) to LED to alternator L (C12-8). ON when the regulator grounds L (not charging), OFF when L sits near battery volts. Alternator S is a battery sense line, NOT a lamp - do not wire it here.","width":390,"schematicPosition":{"x":1200,"y":270}},{"id":"n_oil","text":"Oil LED is CAN-driven, no discrete sense wire. Link sets Low Oil Press 2 on 0x3F1 bit4; PCLink packs the CSB low-side on 0x643. The CSB sinks the cathode; the anode goes to +12 IG.","width":390,"schematicPosition":{"x":1200,"y":420}},{"id":"n_open","text":"ASSUMPTIONS (2026-09-25, closes the old open items) 1) LED common return: sp_led_gnd -> t_led_gnd on OEM ground point ID, left kick panel (M6 stud assumed). 2) +12V IG for the LED anodes: one tap off C12-9 (IG +12, B-O) to sp_led_12v, which feeds the charge, park-brake and oil LEDs and the 56R excite resistor. 3) Current limiting is on the LED board; the loom carries no resistors. Oil LED sinks on CSB3 L4 (plan 6.48 L-channel table). Park brake grounds through the OEM P1 / B2 path, which is why its cathode goes to C12-1 and not to the common return.","width":390,"schematicPosition":{"x":1200,"y":570}},{"id":"note_oem_filters","text":"OEM FILTER PARTS CARRIED OVER (EWD 1990 ST185)\n- Charging p.52: the C12 charge lamp sits between pin 9 (IG, B-O) and\n  pin 8 (alt L, Y) and is the alternator's pre-excitation path, not just\n  an indicator. r_chg_excite replaces the bulb's ~250 mA. Do not delete it.\n- J/B No.1 p.19 holds a 3-terminal diode (common cathode on pin 2). It stays\n  inside the block we keep - do not inject power in a way that bypasses it.\n- J/B No.2 p.21, J/B No.3 p.22, Power source p.46: no diodes, no capacitors.\n- Starting p.48: the diode in the S2 start injector time switch is deleted\n  with the cold-start injector.","schematicPosition":{"x":1200,"y":870}},{"id":"n_cavity_notes","text":"CAVITY NOTES - full text of the signals marked * on this drawing\nCSB3-c26 (L4) 1: ECUMaster CSB3 L4 low-side - oil pressure LED sink, commanded on CAN 0x643; the CSB3 plug is on ST185-A-ECU (csb3io c26)\nt_led_gnd: LED common return - OEM ground point ID, left kick panel (assumed)","schematicPosition":{"x":1200,"y":1380}}],"wireParts":[{"id":"wp_20_blk","partNumber":"EW-1C20-BLK","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, BLACK, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Black","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_blk_org","partNumber":"EW-1C20-BLK-ORG","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, BLACK/ORANGE, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Black","stripeColor":"Orange","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_grn","partNumber":"EW-1C20-GRN","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, GREEN, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Green","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_red","partNumber":"EW-1C20-RED","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, RED, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Red","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_red_grn","partNumber":"EW-1C20-RED-GRN","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, RED/GREEN, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Red","stripeColor":"Green","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_wht","partNumber":"EW-1C20-WHT","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, WHITE, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"White","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_yel","partNumber":"EW-1C20-YEL","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, YELLOW, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Yellow","gauge":{"value":20,"unit":"AWG"}}],"connectorParts":[{"partNumber":"(OEM ST185 combination meter connector)","manufacturer":"Toyota","description":"CONNECTOR, OEM, COMBINATION METER - existing cluster connector; this loom lands only the drawn pins. No invented OEM pinout","configurations":[{"id":"cfg","contactPartId":"ct_generic_skt"}],"id":"cp_cluster","image":{"source":"url","url":"https://raw.githubusercontent.com/living-relation/st185-link-ecu-config/main/docs/harness/part-images/oem-combination-meter.png"}},{"partNumber":"(cross-reference - no part)","manufacturer":"n/a","description":"REFERENCE, CROSS-DRAWING, NO PART - the real connector, pin or splice is owned by another drawing (plan 6.15). Excluded from the BOM.","id":"cp_xref","image":{"source":"url","url":"https://raw.githubusercontent.com/living-relation/st185-link-ecu-config/main/docs/harness/part-images/cross-reference.png"}}],"terminalParts":[{"type":"Ring","size":"M6","partNumber":"GENERIC RING M6 22-16","manufacturer":"generic","minGauge":{"value":22,"unit":"AWG"},"maxGauge":{"value":16,"unit":"AWG"},"description":"TERMINAL, RING, INSULATED, NYLON, M6 STUD, 22-16 AWG","id":"tp_ring_m6_22_16"}],"spliceParts":[{"partNumber":"GENERIC SOLDER SLEEVE 26-14","manufacturer":"generic","minGauge":{"value":26,"unit":"AWG"},"maxGauge":{"value":14,"unit":"AWG"},"description":"SPLICE, SOLDER SLEEVE, WITH ADHESIVE HEATSHRINK, COMBINED 26-14 AWG (Raychem D-406 class)","id":"spp_solder_26_14"},{"partNumber":"GENERIC CRIMP SPLICE 14-10","manufacturer":"generic","minGauge":{"value":14,"unit":"AWG"},"maxGauge":{"value":10,"unit":"AWG"},"description":"SPLICE, CRIMP, UNINSULATED, COPPER, TINNED, COMBINED 14-10 AWG, ADHESIVE HEATSHRINK OVER","id":"spp_crimp_14_10"}],"contactParts":[{"partNumber":"(generic)","manufacturer":"Generic","type":"Crimp","gender":"Socket","description":"CONTACT, SOCKET, CRIMP, GENERIC - kit-supplied or OEM pigtail, confirm before ordering","id":"ct_generic_skt"}],"diodeParts":[{"id":"dp_led","partNumber":"(LED board indicator - 12 V, resistor on board)","manufacturer":"LED board","description":"DIODE, LIGHT EMITTING, INDICATOR, 12 V - cluster warning indicator on the LED board; current-limit resistor is on the board, the loom carries none (assumption 2026-09-25)"}],"resistorParts":[{"id":"rp_chg_excite","partNumber":"56R 5W","manufacturer":"generic","description":"RESISTOR, FIXED, WIREWOUND, 56 OHM, 5 W - alternator pre-excitation, parallel to the charge LED"}],"mates":[]}