{"$schema":"https://docs.harness.design/files/harness/schema/v0.9.json","version":0.9,"lengthUnit":"mm","connectors":[{"id":"ix_fuel_p","label":"Fuel level - 2-way inline mate (IX_FUEL_LVL)","width":270,"partId":"cp_dt2s","cavities":[{"id":"c1","designation":"1","signal":"Fuel level signal -> ECU-B B24 (pull-up at sp_fl_sig)"},{"id":"c2","designation":"2","signal":"Fuel level ground -> Gnd Out"}],"schematicPosition":{"x":0,"y":0},"layoutPosition":{"x":0,"y":0}},{"id":"fuellvl","label":"Fuel Level Sender - DT 2-way (Dan rev 2, 2026-10-10 - no OEM connector)","partId":"cp_dt04_2p","cavities":[{"id":"c1","designation":"1","signal":"SIG"},{"id":"c2","designation":"2","signal":"GND"}],"layoutPosition":{"x":600,"y":0},"schematicPosition":{"x":660,"y":0},"width":150}],"wires":[{"id":"w_fl_sig_r","source":{"id":"ix_fuel_p","handle":"c1"},"target":{"id":"fuellvl","handle":"c1"},"color":"White","partId":"wp_20_wht"},{"id":"w45_r","source":{"id":"ix_fuel_p","handle":"c2"},"target":{"id":"fuellvl","handle":"c2"},"color":"Black","stripeColor":"White","partId":"wp_20_blk_wht"}],"bundles":[{"id":"bn_ix_fuel_p__fuellvl","sourceId":"ix_fuel_p","targetId":"fuellvl","length":{"value":300,"unit":"mm"}}],"schematicNotes":[{"id":"n_scope","width":390,"schematicPosition":{"x":1080,"y":0},"text":"REAR FUEL - fuel level sender only, behind IX_FUEL_LVL (DT04-2P on the ECU/cabin harness, DT06-2S here). Rev 2 (Dan, 2026-10-10): the sender gets a DT 2-way instead of its OEM connector - DT04-2P + W2P on the sender lead, size-16 contacts 0460-202-1631 (owned); no OEM housing. Everything in the trunk (IX_FUEL_LVL, sender, pump, ground stud) also moved to the driver side - see docs/HARNESS-CONSOLIDATION-AND-LAYOUT-PLAN.md / Route 11. The fuel pump is NOT in this harness: its 12 AWG feed runs unbroken from k_fp to the pump's own connector on the ECU/cabin harness, per 6.41 (no extra joint in a 20 A circuit). Run length to the tank is an estimate - measure at install."}],"wireParts":[{"id":"wp_20_wht","partNumber":"EW-1C20-WHT","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, WHITE, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"White","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_blk_wht","partNumber":"EW-1C20-BLK-WHT","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, BLACK/WHITE, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"Black","stripeColor":"White","gauge":{"value":20,"unit":"AWG"}}],"connectorParts":[{"partNumber":"DT06-2S","manufacturer":"TE DEUTSCH","description":"CONNECTOR, PLUG, DT, 2 POS, SOCKET CONTACTS, N SEAL, GRAY","numberOfCavities":2,"gender":"Female","hasShell":false,"configurations":[{"id":"cfg","contactPartId":"ct_dt16s_ni","cavityPlugPartId":"pl_sz16","lockPartId":"lp_w2s"}],"url":"https://www.te.com/usa-en/product-DT06-2S.html","image":{"path":"97d068b9-43c9-4b19-b8c0-ccc45b65fb7b/1790014830313.png","source":"cloud"},"pinout":{"id":"te-deutsch-dt-2","name":"DT 2-way","pins":[{"x":2.73,"y":0,"size":4.2},{"x":-2.73,"y":0,"size":4.2}],"outline":{"type":"rect","width":15.1,"height":11.7,"cornerRadius":2.5},"features":[{"y":-5.85,"layer":"behind","shape":{"type":"rect","width":8.5,"height":3}}],"mirrored":true},"designationStrategy":{"type":"sequential"},"id":"cp_dt2s"},{"id":"cp_dt04_2p","partNumber":"DT04-2P","manufacturer":"TE DEUTSCH","description":"CONNECTOR, RECEPTACLE, DT, 2 POS, PIN CONTACTS, N SEAL, GRAY","numberOfCavities":2,"gender":"Male","hasShell":false,"configurations":[{"id":"cfg","contactPartId":"ct_dt16p","cavityPlugPartId":"pl_sz16","lockPartId":"lp_w2p"}],"url":"https://www.te.com/usa-en/product-DT04-2P.html"}],"contactParts":[{"partNumber":"0462-201-16141","manufacturer":"TE DEUTSCH","type":"Crimp","gender":"Socket","minGauge":{"value":20,"unit":"AWG"},"maxGauge":{"value":16,"unit":"AWG"},"contactColor":"Silver","description":"CONTACT, SOCKET, SOLID, SIZE 16, NICKEL, 16-20 AWG, 13 A","id":"ct_dt16s_ni"},{"partNumber":"0460-202-1631","manufacturer":"TE DEUTSCH","type":"Crimp","gender":"Pin","minGauge":{"value":20,"unit":"AWG"},"maxGauge":{"value":16,"unit":"AWG"},"contactColor":"Gold","description":"CONTACT, PIN, SOLID, SIZE 16, GOLD, 16-20 AWG, 13 A","id":"ct_dt16p"}],"lockParts":[{"partNumber":"W2S","manufacturer":"TE DEUTSCH","description":"WEDGELOCK, DT, 2-WAY PLUG","id":"lp_w2s"},{"partNumber":"W2P","manufacturer":"TE DEUTSCH","description":"WEDGELOCK, DT, 2-WAY RECEPTACLE","id":"lp_w2p"}],"cavityPlugParts":[{"partNumber":"114017","manufacturer":"TE DEUTSCH","description":"PLUG, SEALING, CAVITY, SIZE 16, WHITE","id":"pl_sz16"}]}