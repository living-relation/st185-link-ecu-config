{"$schema":"https://docs.harness.design/files/harness/schema/v0.9.json","version":0.9,"lengthUnit":"mm","connectors":[{"id":"ix_fuel_p","label":"Fuel level - 2-way inline mate (IX_FUEL_LVL)","width":270,"partId":"cp_dt2s","cavities":[{"id":"c1","designation":"1","signal":"Fuel level signal -> ECU-B B24 (pull-up at sp_fl_sig)"},{"id":"c2","designation":"2","signal":"Fuel level ground -> Gnd Out"}],"schematicPosition":{"x":0,"y":0},"layoutPosition":{"x":0,"y":0}},{"id":"fuellvl","label":"Fuel Level Sender","partId":"cp_mp150_2","cavities":[{"id":"c1","signal":"SIG"},{"id":"c2","signal":"GND"}],"layoutPosition":{"x":600,"y":0},"schematicPosition":{"x":660,"y":0},"width":150}],"wires":[{"id":"w_fl_sig_r","source":{"id":"ix_fuel_p","handle":"c1"},"target":{"id":"fuellvl","handle":"c1"},"color":"White","partId":"wp_20_wht"},{"id":"w45_r","source":{"id":"ix_fuel_p","handle":"c2"},"target":{"id":"fuellvl","handle":"c2"},"color":"Black","stripeColor":"White","partId":"wp_20_blk_wht"}],"bundles":[{"id":"bn_ix_fuel_p__fuellvl","sourceId":"ix_fuel_p","targetId":"fuellvl","length":{"value":300,"unit":"mm"}}],"schematicNotes":[{"id":"n_scope","width":390,"schematicPosition":{"x":1080,"y":0},"text":"REAR FUEL - fuel level sender only, behind IX_FUEL_LVL (DT04-2P on the ECU/cabin harness, DT06-2S here). Sender uses its OEM connector; both halves on hand (plan 6.41). The fuel pump is NOT in this harness: its 12 AWG feed runs unbroken from k_fp to the pump's own connector on the ECU/cabin harness, per 6.41 (no extra joint in a 20 A circuit). Run length to the tank is an estimate - measure at install."}],"wireParts":[{"id":"wp_20_wht","partNumber":"EW-1C20-WHT","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, WHITE, ETFE (TEFZEL) INSULATED, 150 C, M22759/16 OR EQUIV","color":"White","gauge":{"value":20,"unit":"AWG"}},{"id":"wp_20_blk_wht","partNumber":"EW-1C20-BLK-WHT","manufacturer":"generic","description":"WIRE, ELECTRICAL, 20 AWG, BLACK/WHITE, ETFE (TEFZEL) INSULAT