      "id": "k_efi",
      "label": "EFI Main Relay",
      "cavities": [
        {
          "id": "c1",
          "designation": "30",
          "signal": "Fused +12V in (F1 30A)"
        },
        {
          "id": "c2",
          "designation": "85",
          "signal": "Coil - -> Aux 6 / A28 - low-side (Aux 5-8 capable of either; low-side chosen for ECU Hold Power)"
        },
        {
          "id": "c3",
          "designation": "86",
          "signal": "Coil + - PERMANENT battery via F12 5A (must stay live after key-off for Hold Power)"
        },
        {
          "id": "c4",
          "designation": "87",
          "signal": "+12V out -> ECU A5, injectors, coils, ETB relay"
        },
        {
          "id": "c5",
          "designation": "87a",
          "signal": "not used"
        }
      ],
      "layoutPosition": {
        "x": -420,
