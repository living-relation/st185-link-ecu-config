  "titleBlock": {
    "company": "ST185 Celica (living-relation)",
    "title": "ST185-B-cabin - ECU connector B cabin loom: ECU-B to bulkhead B, fuel level, rear wheel-speed spur, A/C inputs",
    "drawingNumber": "ST185-B-cabin"
  },
  "exportNotes": "Ident bands (DECISIONS R87): every wire carries its circuit's code in Blue / Yellow / White bands (RNF-100, 6 mm) at every end - connector, terminal, splice and break - band 1 next to the end. Circuit per wire: Connections 'Ident' column and HARNESS-BUILD-LIST.csv. Wires 6 AWG and heavier carry no band. Labels: printed TMS-SCE marker at each connector bundle end (ECU-B, BH-B, IX WS-R, IX FUEL-R).",
  "pdfExportSettings": {
    "includeSchematic": true,
    "includeLayout": true,
    "schematic": {
      "showParts": true,
      "showAccessories": true,
      "showComponentIds": true,
      "pageSize": "Fit"
    },
    "layout": {
      "showParts": true,
      "showAccessories": true,
      "showComponentIds": true,
      "pageSize": "Fit"
    },
    "wireThickness": "Thick",
