        "Manufacturer",
        "Details",
        "Description",
        "Url",
        "Quantity"
      ],
      "pageMode": "Multiple",
      "pageSize": "A3"
    },
    "includeConnections": true,
    "connections": {
      "includeAll": true,
      "includeComponents": true,
      "columns": [
        "Conductor",
        "PartNumber",
        "TwistedWith",
        "Ident",
        "Group",
        "Net",
        "Length",
