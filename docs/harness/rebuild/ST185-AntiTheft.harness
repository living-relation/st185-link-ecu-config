    {
      "id": "t_at_door",
      "type": "Loose",
      "width": 270,
      "signal": "OEM door courtesy switches - negative when a door opens",
      "schematicPosition": {
        "x": 60,
        "y": 240
      },
      "layoutPosition": {
        "x": 60,
        "y": 240
      }
    },
    {
      "id": "t_at_hood",
      "type": "Loose",
      "width": 270,
      "signal": "Hood pin switch - ADD ONE, the car has no factory hood pin",
      "schematicPosition": {
        "x": 60,
        "y": 330
      },
      "layoutPosition": {
        "x": 60,
        "y": 330
      }
    },
    {
      "id": "t_at_trunk",
      "type": "Loose",
      "width": 270,
      "signal": "Trunk pin switch",
      "schematicPosition": {
        "x": 60,
        "y": 390
      },
      "layoutPosition": {
        "x": 60,
        "y": 390
      }
    },
    {
      "id": "t_at_park",
      "type": "Loose",
      "width": 270,
      "signal": "Park lamp flash - to a relay in the CABIN block, never a bay relay",
      "schematicPosition": {
        "x": 780,
        "y": 30
      },
      "layoutPosition": {
        "x": 780,
        "y": 30
      }
    }
  ],
