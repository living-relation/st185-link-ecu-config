  "schematicNotes": [
    {
      "id": "note_at_scope",
      "width": 390,
      "schematicPosition": {
        "x": 1950,
        "y": 330
      },
      "text": "ST185 ANTI-THEFT HARNESS. Deutsch DT sockets (TE) on the harness side, all wires 20 AWG. Fused feeds from the LOGIC box on ST185-CabinPower (broken off); grounds on M6 rings at one cabin stud. No relay or fuse in the engine bay."
    },
    {
      "id": "note_at_immob",
      "width": 390,
      "schematicPosition": {
        "x": 600,
        "y": 420
      },
      "text": "THE ALARM DOES NOT CUT THE STARTER. Its armed output (D 9) grounds a G4X digital input (4k7 pull-up on); the ECU's own anti-theft does the fuel and ignition cut."
    },
    {
      "id": "n_notes_doc",
      "width": 390,
      "schematicPosition": {
        "x": 0,
        "y": 420
      },
      "text": "Signals marked * and the full notes: docs/harness/HARNESS-NOTES.md, ST185-AntiTheft."
    }
  ],
