  "version": 0.9,
  "lengthUnit": "mm",
  "titleBlock": {
    "company": "ST185 Celica (living-relation)",
    "title": "ST185-AntiTheft - anti-theft harness: alarm brain, siren, shock sensor, status LED, valet switch",
    "drawingNumber": "ST185-AntiTheft"
  },
  "exportNotes": "Ident bands (DECISIONS R87): every wire carries its circuit's code in Blue / Yellow / White bands (RNF-100, 6 mm) at every end - connector, terminal, splice and break - band 1 next to the end. Circuit per wire: Connections 'Ident' column and HARNESS-BUILD-LIST.csv. Wires 6 AWG and heavier carry no band. Labels: printed TMS-SCE marker on each bundle at its plug (ALARM, SIREN, STATUS LED, VALET SW, SHOCK SNSR).",
  "connectors": [
    {
      "id": "alarm",
      "label": "Alarm module - main harness (DT06-12SA)",
      "width": 390,
      "partId": "cp_dt06_12sa",
      "cavities": [
        {
          "id": "c1",
          "signal": "+12V CONSTANT - LOGIC ALM 5A *, broken off to ST185-CabinPower",
          "designation": "1",
          "contactPartId": "ct_hdp16s"
        },
        {
          "id": "c2",
          "signal": "GROUND - cabin chassis stud *",
          "designation": "2",
          "contactPartId": "ct_hdp16s"
        },
        {
          "id": "c3",
          "signal": "IGNITION SENSE - +12V key-on *",
          "designation": "3",
          "contactPartId": "ct_hdp16s"
        },
        {
          "id": "c4",
          "signal": "SIREN + - switched +12V out, 2A *",
          "designation": "4",
          "contactPartId": "ct_hdp16s"
        },
        {
          "id": "c5",
          "signal": "PARKING LIGHT OUT - flashes the park lamps on *",
          "designation": "5",
          "contactPartId": "ct_hdp16s"
        },
        {
          "id": "c6",
          "signal": "DOOR TRIGGER IN - negative *",
          "designation": "6",
          "contactPartId": "ct_hdp16s"
        },
        {
          "id": "c7",
          "signal": "HOOD PIN IN - negative",
          "designation": "7",
          "contactPartId": "ct_hdp16s"
        },
        {
          "id": "c8",
          "signal": "TRUNK PIN IN - negative",
          "designation": "8",
          "contactPartId": "ct_hdp16s"
        },
        {
          "id": "c9",
          "signal": "IMMOBILISER OUT - grounds when armed *",
          "designation": "9",
          "contactPartId": "ct_hdp16s"
        },
        {
          "id": "c10",
          "signal": "STATUS LED +",
          "designation": "10",
          "contactPartId": "ct_hdp16s"
        },
        {
          "id": "c11",
          "signal": "VALET / PROGRAM SWITCH",
          "designation": "11",
          "contactPartId": "ct_hdp16s"
        },
        {
          "id": "c12",
          "signal": "SHOCK SENSOR TRIGGER IN - negative *",
          "designation": "12",
          "contactPartId": "ct_hdp16s"
        }
      ],
      "layoutPosition": {
        "x": 960,
        "y": 300
      },
      "schematicPosition": {
        "x": 660,
        "y": 0
      }
    },
