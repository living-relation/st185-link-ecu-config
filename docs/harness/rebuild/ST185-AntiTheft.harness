{
  "$schema": "https://docs.harness.design/files/harness/schema/v0.9.json",
  "$docs": "https://docs.harness.design/files/harness/editing-guide.md",
  "version": 0.9,
  "lengthUnit": "mm",
  "connectors": [
    {
      "id": "alarm",
      "label": "Alarm module - main harness (generic, 12-way)",
      "width": 270,
      "partId": "cp_alarm_main",
      "schematicPosition": {
        "x": 420,
        "y": 60
      },
      "layoutPosition": {
        "x": 420,
        "y": 60
      },
      "cavities": [
        {
          "id": "c1",
          "designation": "1",
          "signal": "+12V CONSTANT - from cabin fuse block, 5A. Alarm must stay live with the key off."
        },
        {
          "id": "c2",
          "designation": "2",
          "signal": "GROUND - cabin chassis stud, same stud as the rest of the accessory loom"
        },
        {
          "id": "c3",
          "designation": "3",
          "signal": "IGNITION SENSE - +12V key-on, tells the alarm the car is running"
        },
        {
          "id": "c4",
          "designation": "4",
          "signal": "SIREN + - switched +12V out, 2A. Siren is in the bay, this feed comes from the cabin."
        },
        {
          "id": "c5",
          "designation": "5",
          "signal": "PARKING LIGHT OUT - flashes the park lamps on trigger. Drive the OEM circuit through a relay in the CABIN block, not a bay relay."
        },
        {
          "id": "c6",
          "designation": "6",
          "signal": "DOOR TRIGGER IN - negative. OEM door courtesy switches."
        },
        {
          "id": "c7",
          "designation": "7",
          "signal": "HOOD PIN IN - negative"
        },
        {
          "id": "c8",
          "designation": "8",
          "signal": "TRUNK PIN IN - negative"
        },
        {
          "id": "c9",
          "designation": "9",
          "signal": "IMMOBILISER OUT - grounds when armed. Goes to a G4X DIGITAL INPUT, not a starter-kill relay. The ECU does the fuel and ignition cut."
        },
        {
          "id": "c10",
          "designation": "10",
          "signal": "STATUS LED +"
        },
        {
          "id": "c11",
          "designation": "11",
          "signal": "VALET / PROGRAM SWITCH"
        },
        {
          "id": "c12",
          "designation": "12",
          "signal": "SHOCK SENSOR TRIGGER IN - negative, from the sensor's signal pin"
        }
      ]
    },
    {
      "id": "shock",
      "label": "Shock / tilt sensor (replaces the OEM glass-break sensor)",
      "width": 270,
      "partId": "cp_alarm_shock",
      "schematicPosition": {
        "x": 780,
        "y": 420
      },
      "layoutPosition": {
        "x": 780,
        "y": 420
      },
      "cavities": [
        {
          "id": "c1",
          "designation": "1",
          "signal": "+12V from alarm module"
        },
        {
          "id": "c2",
          "designation": "2",
          "signal": "Ground"
        },
        {
          "id": "c3",
          "designation": "3",
          "signal": "Trigger out - negative pulse on impact"
        }
      ]
    },
    {
      "id": "siren",
      "label": "Siren (engine bay)",
      "width": 210,
      "partId": "cp_alarm_2w",
      "schematicPosition": {
        "x": 780,
        "y": 120
      },
      "layoutPosition": {
        "x": 780,
        "y": 120
      },
      "cavities": [
        {
          "id": "c1",
          "designation": "1",
          "signal": "+12V switched from alarm c4"
        },
        {
          "id": "c2",
          "designation": "2",
          "signal": "Ground - bay chassis stud"
        }
      ]
    },
    {
      "id": "led_sts",
      "label": "Status LED (dash)",
      "width": 210,
      "partId": "cp_alarm_2w",
      "schematicPosition": {
        "x": 780,
        "y": 240
      },
      "layoutPosition": {
        "x": 780,
        "y": 240
      },
      "cavities": [
        {
          "id": "c1",
          "designation": "1",
          "signal": "LED anode, from alarm c10"
        },
        {
          "id": "c2",
          "designation": "2",
          "signal": "LED cathode to ground. Current limiting: CONFIRM whether the module limits internally."
        }
      ]
    },
    {
      "id": "valet",
      "label": "Valet / program switch (hidden)",
      "width": 210,
      "partId": "cp_alarm_2w",
      "schematicPosition": {
        "x": 780,
        "y": 330
      },
      "layoutPosition": {
        "x": 780,
        "y": 330
      },
      "cavities": [
        {
          "id": "c1",
          "designation": "1",
          "signal": "Switch, from alarm c11"
        },
        {
          "id": "c2",
          "designation": "2",
          "signal": "Ground"
        }
      ]
    },
    {
      "id": "dm_ecu_di",
      "label": "G4X spare DIGITAL INPUT - channel TBD",
      "width": 270,
      "partId": null,
      "schematicPosition": {
        "x": 60,
        "y": 480
      },
      "layoutPosition": {
        "x": 60,
        "y": 480
      },
      "cavities": [
        {
          "id": "c1",
          "signal": "G4X Anti-Theft input. Link spec: 'Anti-Theft control through digital inputs, over CAN or both'. DI accepts a ground-switched input directly - enable the 4k7 pull-up. Pick the channel from the IO table."
        }
      ]
    }
  ],
  "splices": [
