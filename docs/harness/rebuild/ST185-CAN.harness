  "schematicNotes": [
    {
      "id": "n_can",
      "width": 390,
      "text": "CAN BUS harness. 1 Mbit/s ISO 11898-2. Only the CAN-Lambda crosses the firewall; the cluster and RealDash are CAN drops only - their devices and their power are not part of this harness. 120R termination at the ECU end and at the lambda end.",
      "schematicPosition": {
        "x": 3180,
        "y": 0
      }
    },
    {
      "id": "n_cavity_notes",
      "text": "CAVITY NOTES - full text of the signals marked * on this drawing\ncsb3io (label): ECUMaster CSB3 (CAN feed — full I/O on ST185-A-ECU)\nLink CAN-Lambda c1: Power +12V ign, 10A fused - wired on ST185-B-engine\nBulkhead A - firewall (HDP24-2 1: spare (size 16) - was the shared shield drain, retired by 6.32\nBulkhead A - engine plug (HDP2 1: spare (size 16) - was the shared shield drain, retired by 6.32\nt_cluster_can: TrackCluster ESP32-P4 - CAN drop (device not in this harness)\nt_realdash_can: RealDash Pi 5 - CAN drop (device not in this harness)",
      "schematicPosition": {
        "x": 3180,
        "y": 150
      }
    }
  ],
