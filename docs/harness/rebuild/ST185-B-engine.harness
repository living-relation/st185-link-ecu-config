  "schematicNotes": [
    {
      "id": "n_cavity_notes",
      "text": "CAVITY NOTES - full text of the signals marked * on this drawing\nGearbox VSS (Toyota 83181-20040) - 3: SP1 speed output (pin 3) -> bulkhead B c15 -> ECU-B B29 (DI 8). Actual road speed. 12V direct, no divider - Link DI is +/-50V tolerant with a selectable 4k7 pull-up to 12V. PCLink DI 8 pull-up ON (sot/channels.csv B29).",
      "schematicPosition": {
        "x": 1860,
        "y": 840
      }
    },
    {
      "id": "n_drb102",
