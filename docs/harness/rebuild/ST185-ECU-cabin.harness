  "schematicNotes": [
    {
      "id": "n_general",
      "text": "Each table is a pinout: pin, wire, description. A wire has the same description at both ends.\nAn end that says 'on ST185-<file>' is the same wire running on in that loom, not a join.\nEvery shield drain is its own wire. Drains meet only at SP-SHIELD-A, 6 mm behind the ECU-A plug: the crank drain is crimped into A7, the others are soldered onto it.\nSensor ground (ECU A24) never joins chassis ground or loom B sensor ground (ECU B22).\nBulkhead pins marked N/C are section B (see ST185-ECU-cabin) or spares with a sealing plug.",
      "width": 390,
      "schematicPosition": {
        "x": -2430,
        "y": -960
      }
    },
    {
      "id": "n_end_fl_acamp_act",
      "text": "A/C amp A18 pin 11 (1993: A15), behind the glove box. Solder splice onto the factory G-Y lead. EWD 1992 p.93 / p.218; locator 1990 p.17.",
      "width": 270,
      "schematicPosition": {
        "x": -1410,
        "y": 540
      }
    },
    {
      "id": "n_end_fl_acamp_psw",
      "text": "A/C amp A18 pin 13 (1993: A15), behind the glove box. Solder splice onto the factory Y-R lead. EWD 1990 p.152; locator 1990 p.17.",
      "width": 270,
      "schematicPosition": {
        "x": -2310,
        "y": -420
      }
    },
    {
      "id": "n_end_br_ac_psw",
      "text": "Runs on in ST185-EngineRoom-C to A/C pressure switch A5 pin 4 (engine bay): new wire to the switch's own mating plug, plug part TBD. EWD 1990 p.152.",
      "width": 270,
      "schematicPosition": {
        "x": -2310,
        "y": -570
      }
    },
    {
      "id": "n_end_chassis_ring",
      "text": "Ground ring M6 on a cabin chassis stud at the ECU (TBD - EWD ground point ID)",
      "width": 270,
      "schematicPosition": {
        "x": -1410,
        "y": 1170
      }
    },
    {
      "id": "n_end_br_w_cru_5v",
      "text": "Cruise ladder pull-up resistor lead (CSB3 loom, under centre cluster)",
      "width": 270,
      "schematicPosition": {
        "x": -2730,
        "y": 240
      }
    },
    {
      "id": "n_end_br_w_csbg",
      "text": "(CSB3 loom, under centre cluster)",
