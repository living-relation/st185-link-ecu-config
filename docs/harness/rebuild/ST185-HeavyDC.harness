  "titleBlock": {
    "company": "ST185 Celica (living-relation)",
    "title": "ST185-HeavyDC - heavy DC harness: trunk battery, kill switch, RADLOK bulkhead, starter / alternator cables, fuel pump relay",
    "drawingNumber": "ST185-HeavyDC"
  },
  "exportNotes": "Ident bands (DECISIONS R87): every wire carries its circuit's code in Blue / Yellow / White bands (RNF-100, 6 mm) at every end - connector, terminal, splice and break - band 1 next to the end. Circuit per wire: Connections 'Ident' column and HARNESS-BUILD-LIST.csv. Wires 6 AWG and heavier carry no band. Labels: printed TMS-SCE marker at each fuel pump feed end (KILL SW C2, FB BATT IN, K_FP 30 ...) and at the jump post (JUMP +).",
  "pdfExportSettings": {
    "includeSchematic": true,
    "includeLayout": true,
    "schematic": {
      "showParts": true,
      "showAccessories": true,
      "showComponentIds": true,
      "pageSize": "Fit"
    },
    "layout": {
      "showParts": true,
      "showAccessories": true,
      "showComponentIds": true,
      "pageSize": "Fit"
    },
    "wireThickness": "Thick",
    "includeTitleBlock": true,
    "includeNotes": true,
    "includeParts": true,
    "parts": {
      "columns": [
        "PartNumber",
        "Manufacturer",
        "Details",
        "Description",
        "Url",
        "Quantity"
      ],
      "pageMode": "Multiple",
      "pageSize": "A3"
    },
    "includeConnections": true,
    "connections": {
      "includeAll": true,
      "includeComponents": true,
      "columns": [
        "Conductor",
        "PartNumber",
        "TwistedWith",
        "Ident",
        "Group",
