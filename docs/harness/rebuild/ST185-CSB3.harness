    {
      "id": "csb3io",
      "label": "ECUMaster CSB3 - Power/CAN/Switch I/O",
      "width": 390,
      "partId": "cp_csb3_plug",
      "cavities": [
        {
          "id": "c1",
          "signal": "+12V (ignition switched)",
          "contactPartId": "ct_hdp20s"
        },
        {
          "id": "c2",
          "signal": "GND",
          "contactPartId": "ct_hdp20s"
        },
        {
          "id": "c3",
          "signal": "+5V sensor supply -> opto board VCC (its 10k output pull-ups; keeps S7 / S8 at 5 V max)",
          "contactPartId": "ct_hdp20s"
        },
        {
          "id": "c4",
          "signal": "SGND -> opto board output GND (phototransistor emitters)",
          "contactPartId": "ct_hdp20s"
