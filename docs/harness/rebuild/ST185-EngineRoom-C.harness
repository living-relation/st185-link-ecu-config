  "titleBlock": {
    "company": "ST185 Celica (living-relation)",
    "title": "ST185-EngineRoom-C - engine room power loom: PDB, fans, EPS, lamps, wipers, alternator",
    "drawingNumber": "ST185-EngineRoom-C"
  },
  "exportNotes": "Ident bands (DECISIONS R87): every wire carries its circuit's code in Blue / Yellow / White bands (RNF-100, 6 mm) at every end - connector, terminal, splice and break - band 1 next to the end. Circuit per wire: Connections 'Ident' column and HARNESS-BUILD-LIST.csv. Wires 6 AWG and heavier carry no band. Labels: printed TMS-SCE marker at each device connector bundle end (FAN, EPS, HORN LH ...).",
  "pdfExportSettings": {
    "includeSchematic": true,
    "includeLayout": true,
    "schematic": {
      "showParts": true,
      "showAccessories": true,
      "showComponentIds": true,
      "pageSize": "Fit"
    },
    "layout": {
      "showParts": true,
      "showAccessories": true,
      "showComponentIds": true,
      "pageSize": "Fit"
    },
    "wireThickness": "Thick",
    "includeTitleBlock": true,
    "includeNotes": true,
    "includeParts": true,
    "parts": {
      "columns": [
        "PartNumber",
        "Manufacturer",
        "Details",
        "Description",
        "Url",
        "Quantity"
      ],
      "pageMode": "Multiple",
      "pageSize": "A3"
    },
    "includeConnections": true,
    "connections": {
      "includeAll": true,
      "includeComponents": true,
      "columns": [
        "Conductor",
        "PartNumber",
        "TwistedWith",
        "Ident",
        "Group",
        "Net",
        "Length",
        "Contact"
      ],
      "showConductorIds": true,
      "pageMode": "Multiple",
      "pageSize": "A3",
      "showPart": true,
      "showPartImage": false,
      "showAccessories": true,
      "showPinout": true,
      "showUnconnected": true
    }
