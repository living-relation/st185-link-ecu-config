  "$docs": "https://docs.harness.design/files/harness/editing-guide.md",
  "version": 1.2,
  "lengthUnit": "mm",
  "titleBlock": {
    "company": "ST185 Celica (living-relation)",
    "title": "ST185-A-cabin - ECU plug A cabin loom",
    "drawingNumber": "ST185-A-cabin rev A",
    "drawnBy": "DG"
  },
  "exportNotes": "Rev A, BY DG: clean-room rebuild from the master wire list (DECISIONS R201); pins as sot/channels.csv.\nIdent bands (DECISIONS R87): every wire carries its circuit's code in Blue / Yellow / White bands (RNF-100, 6 mm) at every end - connector, terminal, splice and break - band 1 next to the end. Circuit per wire: Connections 'Ident' column and HARNESS-BUILD-LIST.csv. Wires 6 AWG and heavier carry no band. Labels: printed TMS-SCE marker at each connector bundle end (ECU-A, BH-A, IX WS-F, APS).",
  "pdfExportSettings": {
    "includeSchematic": true,
    "includeLayout": true,
    "schematic": {
      "showParts": true,
      "showAccessories": true,
      "showComponentIds": true,
      "pageSize": "Fit"
    },
    "layout": {
      "showParts": true,
      "showAccessories": true,
      "showComponentIds": true,
      "pageSize": "Fit"
    },
    "wireThickness": "Thick",
    "includeTitleBlock": true,
    "includeNotes": true,
    "includeParts": true,
    "parts": {
      "columns": [
        "PartNumber",
        "Manufacturer",
        "Details",
        "Description",
        "Url",
        "Quantity"
      ],
      "pageMode": "Multiple",
      "pageSize": "A3"
    },
    "includeConnections": true,
    "connections": {
      "includeAll": true,
      "includeComponents": true,
      "columns": [
        "Conductor",
        "PartNumber",
        "TwistedWith",
        "Ident",
        "Group",
        "Net",
        "Length",
        "Contact"
      ],
      "showConductorIds": true,
      "pageMode": "Multiple",
      "pageSize": "A3",
      "showPart": true,
      "showPartImage": false,
      "showAccessories": true,
      "showPinout": true,
      "showUnconnected": true
    }
  },
