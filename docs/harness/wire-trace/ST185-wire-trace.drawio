ry"/></mxCell><mxCell id="c1098" value="&lt;b&gt;w_wip_lo&lt;/b&gt;&lt;br&gt;14 AWG Red [ER-C]" style="endArrow=block;endSize=5;html=1;rounded=0;strokeWidth=2;strokeColor=#d62728;fontSize=8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1096" target="c1097"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1099" value="&lt;b&gt;L238&lt;/b&gt;" style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="842" y="954" width="40" height="22" as="geometry"/></mxCell><mxCell id="c1100" value="&lt;b&gt;Front wiper motor (F9) pin 3 (factory lead)&lt;/b&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="884" y="936" width="172" height="58" as="geometry"/></mxCell><mxCell id="c1101" value="&lt;b&gt;IE1 pin 6 (factory lead)&lt;/b&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1174" y="936" width="172" height="58" as="geometry"/></mxCell><mxCell id="c1102" value="&lt;b&gt;w_wip_park&lt;/b&gt;&lt;br&gt;14 AWG Yellow [ER-C]" style="endArrow=block;endSize=5;html=1;rounded=0;strokeWidth=2;strokeColor=#c9a400;fontSize=8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1100" target="c1101"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1103" value="&lt;b&gt;L239&lt;/b&gt;" style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="842" y="1024" width="40" height="22" as="geometry"/></mxCell><mxCell id="c1104" value="&lt;b&gt;JUMP-BAR 3 → ALT-FUSE stud M8&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;175 A MRBF fuse, block bolted on bar stud 3 (mate)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#0b5394&quot;&gt;&lt;i&gt;from L151&lt;/i&gt;&lt;/font&gt;" style="rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="884" y="1006" width="172" height="58" as="geometry"/></mxCell><mxCell id="c1105" value="&lt;b&gt;T-ALT-B&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1174" y="1006" width="172" height="58" as="geometry"/></mxCell><mxCell id="c1106" value="&lt;b&gt;w_alt&lt;/b&gt;&lt;br&gt;2 AWG Red [HDC]" style="endArrow=block;endSize=5;html=1;rounded=0;strokeWidth=2;strokeColor=#d62728;fontSize=8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1104" target="c1105"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Flags" id="Flags"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1107" value="&lt;b&gt;Flags&lt;/b&gt; - things the trace script noticed (for your check; nothing was changed)" style="text;fillColor=none;strokeColor=none;align=left;fontSize=13;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1614" height="40" as="geometry"/></mxCell><mxCell id="c1108" value="&lt;b&gt;Firewall match&lt;/b&gt;" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="64" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1109" value="DRB102 cavity 83: cabin w_fb_mrs_en = 18 AWG Red, engine w_hv_mrs_en_e = 20 AWG Red (Dan 2026-11-06: colour and gauge must match; already open as tracker question N32)." style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="64" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1110" value="&lt;b&gt;Firewall match&lt;/b&gt;" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="102" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1111" value="DRB102 cavity 95: cabin w_lam12_cp = 14 AWG Red, engine w_lam12_be14 = 12 AWG Red (Dan 2026-11-06: colour and gauge must match; already open as tracker question N32)." style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="102" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1112" value="&lt;b&gt;Firewall text&lt;/b&gt;" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1113" value="DRB102 cavity 95: the two halves describe different circuits - cabin [AB-cabin]: &amp;quot;LOGIC LAM 10 A fuse -&amp;gt; ON relay K-ON 87&amp;quot;; engine [AB-engine]: &amp;quot;EFI relay k_efi -&amp;gt; LOGIC LAM 7.5 A fuse&amp;quot;. Master wire list (w_lam12_be14 / w_lam12_cp) says &amp;quot;LOGIC LAM 10 A fuse -&amp;gt; ON relay K-ON 87&amp;quot; on both, so the AB-engine Rev C text looks stale (that file is dated 2026-11-03, the K-ON change is 2026-11-04); the wire itself matches the master." style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="140" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1114" value="&lt;b&gt;Firewall match&lt;/b&gt;" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="178" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1115" value="DRB102 cavity 96: cabin w_lamg_ac = 14 AWG Black, engine w_lamg_be14 = 12 AWG Black (Dan 2026-11-06: colour and gauge must match; already open as tracker question N32)." style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="178" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1116" value="&lt;b&gt;Info&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="216" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1117" value="65 DRB102 firewall cavities are used; every one has a wire on both the cabin and engine side (no one-sided cavities)." style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="216" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1118" value="&lt;b&gt;Unused core&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="254" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1119" value="CAB-FLEX-C Red core (CAB_FLEX_C_nc_red) [AB-c1]: no ends - spare core, OK if intended." style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="254" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1120" value="&lt;b&gt;Unused core&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="292" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1121" value="CAB-FLEX-C Yellow core (CAB_FLEX_C_nc_yellow) [AB-c1]: no ends - spare core, OK if intended." style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="292" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1122" value="&lt;b&gt;Unused core&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1123" value="CAB-ETBS-C Yellow core (CAB_ETBS_C_nc_yellow) [AB-c1]: no ends - spare core, OK if intended." style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="330" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1124" value="&lt;b&gt;Info&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="368" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1125" value="12 cable screens end open at the far (sensor / node) end - matches the &amp;quot;shields terminate at the ECU end only&amp;quot; rule. Check the list on the line pages (dashed grey arrows into OPEN END boxes)." style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="368" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1126" value="&lt;b&gt;Splice&lt;/b&gt;" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="406" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1127" value="SP-CSB-GND: only 1 wire in these files (w_csbg_ac); its other branches must come from a harness not yet in harness.design (splice name says: Gnd to CSB3, opto board; to Dash, ECUMaster CSB3 (CSB3) / Cruise control switch, combination switch plug B (C…)." style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="406" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1128" value="&lt;b&gt;Splice&lt;/b&gt;" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="444" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1129" value="SP-ACC12: only 1 wire in these files (w_acc86); its other branches must come from a harness not yet in harness.design (splice name says: A/C clutch relay coil+; to CabinPower, New LOGIC fuse box, K-ACC / New LOGIC fuse box, ACC 10 A fuse)." style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="444" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1130" value="&lt;b&gt;Splice&lt;/b&gt;" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="482" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1131" value="SP-CAN-SH-BH: only 1 wire in these files (cab_canbh_bc_sh); its other branches must come from a harness not yet in harness.design (splice name says: CAN-Lambda shield; to Dash, CAN trunk, cluster branch (SP-CAN-SH-CLU))." style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="482" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1132" value="&lt;b&gt;Info&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1133" value="13 splices join exactly 2 wires (straight in-line joints, e.g. a gauge step or factory-lead join; the rest may be in unbuilt harnesses): SP-AC-PSW, SP-AC-SG, SP-CAN-SH-CLU, SP-CANH, SP-CANL, SP-LAM12-B, SP-LAMG-B, SP-REV, SP-RTR-GND-R2, SP-RTR-GND-R3, SP-RTR-R2-4, SP-RTR-R3-4, SP-SHIELD-B-WSR" style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="520" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1134" value="&lt;b&gt;Info&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="558" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1135" value="Inline plugs whose other half is not in these 5 files (WheelSpeed / RearFuel etc. not built yet): IX-FUEL-P pin 1, IX-FUEL-P pin 2, IX-WS-F-S pin 1, IX-WS-F-S pin 2, IX-WS-F-S pin 3, IX-WS-F-S pin 4, IX-WS-F-S pin 5, IX-WS-R-S pin 1, IX-WS-R-S pin 2, IX-WS-R-S pin 3, IX-WS-R-S pin 4, IX-WS-R-S pin 5" style="text;fillColor=none;strokeColor=none;align=left;fontSize=10;spacingLeft=6;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="155" y="558" width="1454" height="34" as="geometry"/></mxCell><mxCell id="c1136" value="&lt;b&gt;Coverage&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="596" width="130" height="34" as="geometry"/></mxCell><mxCell id="c1137" value="310 conductors cha