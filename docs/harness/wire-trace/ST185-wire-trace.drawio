<mxfile host="app.diagrams.net" type="device"><diagram name="P01 Cover and legend" id="P01_Cover_and_legend"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1138" value="&lt;b&gt;ST185 wire trace - logical check flowchart&lt;/b&gt; (2026-11-06, read-only trace of the harness.design files)" style="text;fillColor=none;strokeColor=none;align=left;fontSize=18;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1614" height="46" as="geometry"/></mxCell><mxCell id="c1139" value="&lt;b&gt;Files traced&lt;/b&gt;&lt;br&gt;[AB-c1] ST185-AB-cabin 1 - sensor rails and screens Rev C&lt;br&gt;[AB-c2] ST185-AB-cabin 2 - straight runs, power, taps and CAN Rev D&lt;br&gt;[AB-eng] ST185-AB-engine Rev C&lt;br&gt;[ER-C] ST185-EngineRoom-C Rev D&lt;br&gt;[HDC] ST185-HeavyDC Rev C" style="text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="760" height="120" as="geometry"/></mxCell><mxCell id="c1140" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• One straight row = one wire run, read left to right.&lt;br&gt;• Rows start at the ECU plugs (ECU-A, then ECU-B, then ECU-C), then work outward from every splice, bus and device they reach; leftover wires follow in file order AB-cabin 1, AB-cabin 2, AB-engine, EngineRoom-C, HeavyDC.&lt;br&gt;• A splice, bussed plug or pin with more than one wire ENDS the row; its other wires get their own rows (&quot;→ L045&quot; says where).&lt;br&gt;• The firewall bulkhead, RADLOK pair, mated inline plugs and resistors / diodes are passed through (one box).&lt;br&gt;• Arrow label = wire name, gauge, colour, cable (if any) and [file]. Arrow colour = wire colour; dashed grey = cable screen." style="text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="800" y="66" width="830" height="200" as="geometry"/></mxCell><mxCell id="c1141" value="ECU plug pin" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="200" height="40" as="geometry"/></mxCell><mxCell id="c1142" value="Firewall pass-through" style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="248" width="200" height="40" as="geometry"/></mxCell><mxCell id="c1143" value="Splice" style="ellipse;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="296" width="200" height="40" as="geometry"/></mxCell><mxCell id="c1144" value="Bussed plug / bus bar" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="344" width="200" height="40" as="geometry"/></mxCell><mxCell id="c1145" value="Fuse / power box, kill switch" style="rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="392" width="200" height="40" as="geometry"/></mxCell><mxCell id="c1146" value="Relay" style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="200" height="40" as="geometry"/></mxCell><mxCell id="c1147" value="Device plug" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="200" width="200" height="40" as="geometry"/></mxCell><mxCell id="c1148" value="Factory (OEM) lead tap" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="248" width="200" height="40" as="geometry"/></mxCell><mxCell id="c1149" value="Ring terminal / ground point" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="296" width="200" height="40" as="geometry"/></mxCell><mxCell id="c1150" value="Inline plug" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;dashed=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="344" width="200" height="40" as="geometry"/></mxCell><mxCell id="c1151" value="Resistor / diode" style="rounded=0;fillColor=#fff2cc;strokeColor=#000000;dashed=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="392" width="200" height="40" as="geometry"/></mxCell><mxCell id="c1152" value="Open end" style="rounded=0;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontColor=#b85450;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="440" width="200" height="40" as="geometry"/></mxCell><mxCell id="c1153" value="&lt;b&gt;Page index&lt;/b&gt;" style="text;fillColor=none;strokeColor=none;align=left;fontSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="600" height="24" as="geometry"/></mxCell><mxCell id="c1154" value="P02 L001-L030: ECU-A&lt;br&gt;P03 L031-L060: ECU-A, ECU-B, ECU-C&lt;br&gt;P04 L061-L090: INJ-4, INJ-3, INJ-2, INJ-1, SP-A5, SP-8V, SP-SHIELD-A, CRANK, SP-CAM, COIL-4, COIL-3, COIL-2, COIL-1, APS-PEDAL&lt;br&gt;P05 L091-L120: ECT, IAT, MAP, K-FP, BOOST-SOL, ETB, IX-WS-F-S, BUS-GNDOUT-A, SP-GND-ECU, MRS-B, K-FAN, TURBO-SPD, FLEX, BUS-5V, OIL-T, CHARGE-IAT, KNOCK-1, SP-TACH&lt;br&gt;P06 L121-L150: SP-TACH, K-EPS-EN, K-FAN2, OIL-P, FUEL-P, SP-SHIELD-B, IX-WS-R-S, BUS-GNDOUT-B, CLNT-P, SP-FUEL-LVL, VSS, LOGIC, SP-CAN-SH-CLU, SP-CANH, SP-CANL, SP-SW12, SP-SHIELD-A-APS, SP-SHIELD-A-WSF, SP-CHASSIS-ENG, BATT-RELAY-BLOCK&lt;br&gt;P07 L151-L180: POWER-STUDS, K-EPS, SP-GNDOUT-B-ENG, ALT-PLUG, SP-CANH-LAM, SP-CANL-LAM, KILL-SW, JUMP-BAR, SP-LAMG-B, MRS-A, CAN-LAMBDA, GND-EA&lt;br&gt;P08 L181-L210: GND-EA, SP-LAM12-B, HORN-LH, HORN-RH, SP-RTR-GND-R3, SP-HORN, SP-CAN-SH-BH, SP-AC-PSW, SP-ACC12, K-ACC, SP-AC-SG, Ambient air temp sensor (A1…, REV-SW, SP-REV, STARTER-TRIGGER, RB4 pin AC-2 (factory lead), SP-CLR, LH front side marker lamp (…, GND-EB, SP-RTR-GND-R2, T-ENG-BLOCK-2&lt;br&gt;P09 L211-L239: SP-HL-HIGH, SP-HL-LOW, K-HL, K-HR, SP-RTR-CLOSE, SP-RTR-OPEN, IE1 pin 15 (factory lead), SP-RTR-R2-4, IE1 pin 8 (factory lead), SP-RTR-R3-4, JB1 pin 1H-4 (factory lead), JB1 pin 1H-8 (factory lead), W1 pin 1 (washer motor), W1 pin 2 (factory cowl lead), JB1 pin 1H-5 (factory lead), IE1 pin 20 (factory lead), IE1 pin 13 (factory lead), Front wiper motor (F9) pin …, JUMP-BAR&lt;br&gt;P10 Flags" style="text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="526" width="1614" height="600" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="P02 L001-L030" id="P02_L001_L030"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;P02 L001-L030&lt;/b&gt; &amp;nbsp; lines that start at: ECU-A" style="text;fillColor=none;strokeColor=none;align=left;fontSize=13;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1614" height="40" as="geometry"/></mxCell><mxCell id="c2" valu