#!/bin/sh
# Refuse a commit that stages docs/research-hub.html.
# That file is owned by the "Regenerate research hub" GitHub Action (see CLAUDE.md,
# "Generated files - who owns them"). Committing it locally causes rebase conflicts.
# Enable once per clone:  powershell -File .githooks/setup.ps1   (or run the two
# git config lines in that file by hand).
if git diff --cached --name-only | grep -qx 'docs/research-hub.html'; then
  echo "pre-commit: docs/research-hub.html is staged. It is generated by CI - do not commit it." >&2
  echo "Fix: git restore --staged docs/research-hub.html && git checkout -- docs/research-hub.html" >&2
  exit 1
fi
exit 0
