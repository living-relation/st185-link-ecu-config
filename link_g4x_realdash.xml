<?xml version="1.0" encoding="utf-8"?>
<!-- Link G4X FuryX — RealDash CAN Frame Definitions
     Repository : st185-link-ecu-config
     Format     : RealDashCAN version 2
     Hardware   : Pi4+ or Pi5, 840x480 7" screen, USB-CAN adapter (CANable or PCAN) at 1 Mbit/s
     Import via : RealDash → Settings → Connections → Add Connection → CAN bus → Import XML

     SCOPE: Only the three NEW ECU TX frames that the ESP32 cluster does NOT already display.
       0x3EF Drive Assist & Status  — lambda target, TPS, TC, TC intervention, boost map, cruise, AC
       0x3F0 Extended Sensors       — fuel temp, engine load, coolant pressure, ethanol, charge-pipe IAT,
                                      cabin temp, turbo speed, trigger errors
       0x3F1 IMU & Ext Warnings     — accel X/Y/Z, packed warning bitmask

     Frames 0x3E8–0x3EE and 0x3EA–0x3EB are intentionally excluded — the cluster already
     handles RPM, MGP, ECT, IAT, oil temp, ign angle, speed, oil/fuel pressure, lambda, gear,
     fuel level, and all engine protection flags.

     Switchboard frames 0x640–0x642 are also excluded — the cluster reads them and all
     useful derived values (cabin temp, TC echo, boost echo) are already in the three frames above. -->

<RealDashCAN version="2">
  <frames>

    <!-- ═══════════════════════════════════════════════════════════════════
         0x3EF  (decimal 1007) — Drive Assist & Status  50 ms
         [0-1] Lambda Target × 0.001   [2] TPS %   [3] TC Setting (ECU echo of cluster 0x3ED)
         [4] TC Intervention %   [5] Boost Map Index (ECU echo of cluster 0x3EC)
         [6] Cruise State 0=off 1=set 2=active 3=hold 4=resume
         [7] AC Status    0=off 1=requested 2=active 3=inhibited
         ═══════════════════════════════════════════════════════════════════ -->
    <frame id="1007" bus="0" length="8" interval="50">
      <value type="uint16" units="lambda" name="Lambda Target"   offset="0" conversion="V*0.001" endian="big"/>
      <value type="uint8"  units="%"      name="TPS"             offset="2" conversion="V"/>
      <value type="uint8"  units=""       name="TC Setting"      offset="3" conversion="V"/>
      <value type="uint8"  units="%"      name="TC Intervention" offset="4" conversion="V"/>
      <value type="uint8"  units=""       name="Boost Map Index" offset="5" conversion="V"/>
      <value type="uint8"  units=""       name="Cruise State"    offset="6" conversion="V"/>
      <value type="uint8"  units=""       name="AC Status"       offset="7" conversion="V"/>
    </frame>

    <!-- ═══════════════════════════════════════════════════════════════════
         0x3F0  (decimal 1008) — Extended Sensors  100 ms
         [0] Fuel Temp °C  [1] Engine Load %  [2] Coolant Pressure kPa  [3] Ethanol %
         [4] Charge-Pipe IAT °C  [5] Cabin Temp °C (ECU echo of CSB3 Analog 1 via GP Temp1)
         [6] Turbo Speed RPM × 100  [7] Trigger Errors count
         Temp bytes use Offset=-50 encoding (raw - 50 = °C).
         ═══════════════════════════════════════════════════════════════════ -->
    <frame id="1008" bus="0" length="8" interval="100">
      <value type="uint8"  units="C"    name="Fuel Temp"        offset="0" conversion="V-50"/>
      <value type="uint8"  units="%"    name="Engine Load"      offset="1" conversion="V"/>
      <value type="uint8"  units="kPa"  name="Coolant Pressure" offset="2" conversion="V"/>
      <value type="uint8"  units="%"    name="Ethanol %"        offset="3" conversion="V"/>
      <value type="uint8"  units="C"    name="Charge-Pipe IAT"  offset="4" conversion="V-50"/>
      <value type="uint8"  units="C"    name="Cabin Temp"       offset="5" conversion="V-50"/>
      <value type="uint8"  units="RPM"  name="Turbo Speed"      offset="6" conversion="V*100"/>
      <value type="uint8"  units=""     name="Trigger Errors"   offset="7" conversion="V"/>
    </frame>

    <!-- ═══════════════════════════════════════════════════════════════════
         0x3F1  (decimal 1009) — IMU & Extended Warnings  50 ms
         [0-1] Accel X g  [2-3] Accel Y g  [4-5] Accel Z g  (signed int16 BigEndian, × 0.1 = g)
         [6]   Ext Warn Bits — packed bitmask, import raw; decode per-bit in RealDash gauge conditions:
                 bit0 ECT over-temp     bit1 Oil pressure low    bit2 Fuel pressure low
                 bit3 Oil temp high     bit4 IAT high            bit5 Switchboard comm fault
                 bit6 Trigger error     bit7 Sensor error
         [7]   Reserved (0x00)
         ═══════════════════════════════════════════════════════════════════ -->
    <frame id="1009" bus="0" length="8" interval="50">
      <value type="int16"  units="g"   name="Accel X"        offset="0" conversion="V*0.1" endian="big"/>
      <value type="int16"  units="g"   name="Accel Y"        offset="2" conversion="V*0.1" endian="big"/>
      <value type="int16"  units="g"   name="Accel Z"        offset="4" conversion="V*0.1" endian="big"/>
      <value type="uint8"  units=""    name="Ext Warn Bits"  offset="6" conversion="V"/>
    </frame>

  </frames>
</RealDashCAN>
