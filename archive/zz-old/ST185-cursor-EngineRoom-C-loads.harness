  "schematicNotes": [
    {
      "id": "n0",
      "text": "ST185 cursor Engine Room C \u2014 NEW LOADS. EPS 8 AWG in the vacated ABS trough. Uprated fans 8 AWG / DTHD size 8 on the core support. A/C clutch stays on A/B. Relay 30/86 live in the glove box; 87 runs are this loom.",
      "width": 390,
      "schematicPosition": {
        "x": -360,
        "y": -240
      },
      "color": "Blue"
    },
    {
      "id": "n1",
      "text": "k_fan / k_fan2 use TE 1-1904045-6 Micro ISO kits (contacts 280756-4 / 180360-0). k_eps uses HCR 150 mating hardware \u2014 confirm receptacle PN with TE before order. Fan housings are DTHD06-1-8S (8 AWG), not DT06-2S.",
      "width": 390,
      "schematicPosition": {
        "x": -360,
        "y": -360
      },
      "color": "Orange"
    },
    {
      "id": "h0",
      "text": "GLOVE BOX",
      "width": 210,
      "schematicPosition": {
