  "schematicNotes": [
    {
      "id": "n0",
      "text": "ST185 cursor Engine Room C — OEM INJECTION. Kick-panel J/Bs stay. Unplug engine-bay J/B2 and F11. Probe 2E-2 / 2E-3 vs IE1 before landing PMU O5 / O3.",
      "width": 390,
      "schematicPosition": {
        "x": -360,
        "y": -420
      },
      "color": "Red"
    },
    {
      "id": "n1",
      "text": "Primary restores: 1I-1 always-hot, IE1-10 AM1, IE1-17 AM2, R/B4 heater in, R/B2 POWER in, grounds ID + IG. Dummy header recreates 2A-3↔2D-2 and 2A-6↔2D-6.",
      "width": 390,
      "schematicPosition": {
        "x": -360,
        "y": -540
      },
      "color": "Orange"
    },
    {
      "id": "h0",
      "text": "GLOVE BOX FUSES",
      "width": 270,
      "schematicPosition": {
